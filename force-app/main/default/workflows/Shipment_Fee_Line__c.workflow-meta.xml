    <rules>
        <fullName>Add Service Line</fullName>
        <actions>
            <name>Add_Services_Line</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Shipment_Fee_Line__c.New_Service_Line__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>Notificacion de creacion de linea adicional en Shipment, que le llegue al email del vendedor y ejecutivo de Servicio al cliente,</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Add Shipment Serv Lines PILOTO</fullName>
        <actions>
            <name>Update_Status_Shipment</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>PILOTO GDL //</description>
        <formula>AND(   New_Service_Line__c = True,      Shipment__r.Account_for__r.Owner.Workplace__c = &quot;GDL&quot; )</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
