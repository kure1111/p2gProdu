        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Service Line Buy Amount is Changed</fullName>
        <actions>
            <name>Service_Line_Buy_Amount_is_Change</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>Update_Buy_Price_Modified</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>AND  (ISCHANGED(Shipment_Buy_Price__c),  NOT(ISBLANK( PRIORVALUE(Shipment_Buy_Price__c))),  NOT(ISNEW()),  $Profile.Name &lt;&gt; &quot;System Administrator&quot;)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
