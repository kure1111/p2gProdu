<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ubicacion_validada</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Account_Origin_Address__c)), 
    TEXT(Account_Origin_Address__r.status__c) &lt;&gt; &apos;Validado&apos;
)</errorConditionFormula>
    <errorMessage>La dirección debe tener el status&apos;Validado&apos; para poder proceder</errorMessage>
</ValidationRule>
