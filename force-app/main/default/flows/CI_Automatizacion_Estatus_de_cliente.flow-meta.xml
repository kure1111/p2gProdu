    <decisions>
        <description>Consulta los movimientos del cliente para confirmar si tuvo pérdidas.
Lost Opp - Closed Lost Opportunity
NV - No Venta</description>
        <name>Cotizacion_Cliente</name>
        <label>Cotizacion del cliente</label>
        <locationX>1403</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Seguimiento_Cliente</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X60_Dias_sin_cotizacion</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>diasUltimaCotizacion</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>60.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SeguimientoProspecto__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Vendido</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Seguimiento_No_Venta</targetReference>
            </connector>
            <label>60 Días sin cotización</label>
        </rules>
    </decisions>
