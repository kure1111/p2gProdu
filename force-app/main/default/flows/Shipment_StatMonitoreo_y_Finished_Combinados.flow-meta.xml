<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <decisions>
        <name>Shipment_Status_Monitoreo</name>
        <label>Shipment Status Monitoreo</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Status_Monitoreo_Finished</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Shipment__r.Shipment_Status_Mon__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Finished_M</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Finished</targetReference>
            </connector>
            <label>Status Monitoreo Finished</label>
        </rules>
        <rules>
            <name>Status_monitoreo_Not_Finished</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Shipment__r.Shipment_Status_Mon__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Finished_M</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_Not_Finished</targetReference>
            </connector>
            <label>Status monitoreo Not Finished</label>
        </rules>
    </decisions>
    <description>Este flow es la combinacion de dos workflow rules: Shipment StatMonitoreo y Shipment Finished.</description>
    <environments>Default</environments>
    <interviewLabel>Shipment StatMonitoreo y Finished Combinados {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Shipment StatMonitoreo y Finished Combinados</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Status_Finished</name>
        <label>Update Status Finished</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Shipment_Finished__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Status_Not_Finished</name>
        <label>Update Status Not Finished</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Shipment_Finished__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Shipment_Status_Monitoreo</targetReference>
        </connector>
        <object>Shipment_Fee_Line__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
