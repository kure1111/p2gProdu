<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Calendario: agrega el CLIENTE al asunto del evento (Meeting · CUENTA) para que la tarjeta diga de quién es la junta. Solo toca asuntos estándar (Meeting/Call/Email/Send Letter/Quote/Other) o vacíos; lo escrito a mano se respeta y no se apila en ediciones. Cliente en cascada: What=Cuenta, What=Oportunidad (su cuenta), o la cuenta del contacto del Who.</description>
    <environments>Default</environments>
    <interviewLabel>PAK Evento Cliente En Subject {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PAK Evento Cliente En Subject</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Asigna_De_Cuenta</name>
        <label>Asigna De Cuenta</label>
        <locationX>50</locationX>
        <locationY>500</locationY>
        <assignmentItems>
            <assignToReference>nombreCliente</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Cuenta.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Hay_Cliente</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asigna_De_Opp</name>
        <label>Asigna De Opp</label>
        <locationX>350</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>nombreCliente</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Cuenta_De_Opp.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Hay_Cliente</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Asigna_De_Contacto</name>
        <label>Asigna De Contacto</label>
        <locationX>650</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>nombreCliente</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Cuenta_De_Contacto.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Hay_Cliente</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Pone_Subject</name>
        <label>Pone Subject</label>
        <locationX>350</locationX>
        <locationY>800</locationY>
        <assignmentItems>
            <assignToReference>$Record.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fNuevoSubject</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Que_Relacion</name>
        <label>Que relacion tiene</label>
        <locationX>350</locationX>
        <locationY>300</locationY>
        <defaultConnectorLabel>Sin cliente</defaultConnectorLabel>
        <rules>
            <name>EsCuenta</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WhatId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>001</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Cuenta</targetReference>
            </connector>
            <label>Es cuenta</label>
        </rules>
        <rules>
            <name>EsOportunidad</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WhatId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>006</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Oportunidad</targetReference>
            </connector>
            <label>Es oportunidad</label>
        </rules>
        <rules>
            <name>EsContacto</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WhoId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>003</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contacto</targetReference>
            </connector>
            <label>Con contacto</label>
        </rules>
    </decisions>
    <decisions>
        <name>Hay_Cliente</name>
        <label>Hay cliente</label>
        <locationX>350</locationX>
        <locationY>700</locationY>
        <defaultConnectorLabel>Sin nombre</defaultConnectorLabel>
        <rules>
            <name>ConCliente</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>nombreCliente</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pone_Subject</targetReference>
            </connector>
            <label>Con cliente</label>
        </rules>
    </decisions>
    <formulas>
        <name>fNuevoSubject</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Subject}), "Meeting", {!$Record.Subject}) + " · " + LEFT({!nombreCliente}, 60)</expression>
    </formulas>
    <recordLookups>
        <name>Get_Cuenta</name>
        <label>Get Cuenta</label>
        <locationX>50</locationX>
        <locationY>400</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asigna_De_Cuenta</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Oportunidad</name>
        <label>Get Oportunidad</label>
        <locationX>350</locationX>
        <locationY>400</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Cuenta_De_Opp</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Cuenta_De_Opp</name>
        <label>Get Cuenta De Opp</label>
        <locationX>350</locationX>
        <locationY>500</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asigna_De_Opp</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Oportunidad.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contacto</name>
        <label>Get Contacto</label>
        <locationX>650</locationX>
        <locationY>400</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Cuenta_De_Contacto</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Cuenta_De_Contacto</name>
        <label>Get Cuenta De Contacto</label>
        <locationX>650</locationX>
        <locationY>500</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asigna_De_Contacto</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contacto.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>350</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Que_Relacion</targetReference>
        </connector>
        <filterFormula>OR(
    ISBLANK({!$Record.Subject}),
    {!$Record.Subject} = "Meeting",
    {!$Record.Subject} = "Call",
    {!$Record.Subject} = "Email",
    {!$Record.Subject} = "Send Letter/Quote",
    {!$Record.Subject} = "Other"
)</filterFormula>
        <object>Event</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>nombreCliente</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
