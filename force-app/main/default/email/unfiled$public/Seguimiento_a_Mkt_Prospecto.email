<![CDATA[<font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;" size="2">Estimad@s&nbsp; se ha asignado un ESTATUS de Seguimiento al&nbsp;</font><div style=""><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;" size="2">Prospecto <u style="">({!Account.Name}</u><span style="color: rgb(0, 0, 0); font-family: arial;"><u>).</u></span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><b><u>Detalles</u>:</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" style="color: rgb(0, 0, 0); font-family: arial;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Seguimiento:&nbsp;</font></font><font face="arial" size="2"><b>{!Account.SeguimientoProspecto__c}</b></font></div><div style=""><font size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Folio:&nbsp;</font></font><font face="arial" size="2">{!Account.Folio_Mkt__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" size="2">Agente Aduanal:&nbsp;{!Account.Requiere_Agente_Aduanal__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Tipo de servicio:&nbsp;</font><font face="arial">{!Account.Tipo_de_Servicio_Prospecto__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Ejecutivo Mkt:&nbsp;</font><font face="arial">{!Account.Mkt_Executive__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Comentarios:&nbsp;</font><font face="arial" style="">{!Account.Description}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style=""><br></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><p style="text-align: center;"><br></p></div></div>]]></td>
