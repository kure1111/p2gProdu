<td tEditID="c1r2" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Estimad@ Equipo Operaciones una nueva Orden Confirmada ha sido asignada a la <b>Gerencia para su Autorización</b>.&nbsp;</span></font><div><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></span></font></div><div><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Una vez aceptada se procedera a Operar.</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style=""><div style=""><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Favor de confirmar </b><font face="arial"><b>Recepción</b></font><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">&nbsp;de esta Solicitud y Asignar al Ejecutivo de Operaciones (Planner).</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Estatus actual:&nbsp;<font style="" color="#006600"><b style="">{!Customer_Quote__c.Quotation_Status__c}</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font color="#ff0000"><br></font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Order:&nbsp;&nbsp;<b>{!Customer_Quote__c.Name}</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Cliente:&nbsp;<b>{!Account.Name}</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Route:&nbsp;<b>{!Customer_Quote__c.Site_of_Load__c} -&nbsp;{!Customer_Quote__c.Site_of_Discharge__c}</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0);">Solicitado por:</span><font color="#333333">&nbsp;{!Customer_Quote__c.CreatedBy}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="font-size: 12pt;"><b>Comentarios:</b>&nbsp;</font><font face="arial" style="font-size: medium;">{!Customer_Quote__c.Status_Observations__c}</font></div><div style=""><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: medium;">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </font><font face="arial">{!Customer_Quote__c.Observations__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div></div></div>]]></td>
</tr>
