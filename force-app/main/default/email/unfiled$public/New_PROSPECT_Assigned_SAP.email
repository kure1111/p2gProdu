<td tEditID="c1r2" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;" size="2">Estimad@&nbsp; <b style="">{!Account.OwnerFullName}</b>&nbsp;se te ha asignado un nuevo Prospecto <u style="">({!Account.Name}</u><span style="color: rgb(0, 0, 0); font-family: arial;"><u>).</u></span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><b><u><br></u></b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><b><u>Detalles</u>:</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Estatus:&nbsp;</font><font face="arial">{!Account.Status_Account__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Folio:&nbsp;</font></font><span style="font-size: small;">{!Account.Ok_Folio_Mkt__c}</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" size="2">Agente Aduanal:&nbsp;{!Account.Requiere_Agente_Aduanal__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Tipo de servicio:&nbsp;</font><font face="arial">{!Account.Tipo_de_Servicio_Prospecto__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Ejecutivo Mkt:&nbsp;</font><font face="arial">{!Account.Mkt_Executive__c}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Comentarios:&nbsp;</font><font face="arial" style="">{!Account.Description}</font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2"><font face="arial" style=""><br></font></font></div><div style=""><div style="text-align: center;"><br></div></div>]]></td>
</tr>
