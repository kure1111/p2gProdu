<![CDATA[<font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Estimad@ Equipo Pricing, esto es un Recordatorio con respecto a la solicitud de Costos por parte del Equipo Comercial.</span></font><div style=""><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">&nbsp;</span></font><div style="font-family: arial; font-size: 12pt;"><div style=""><span style="color: rgb(0, 0, 0); font-size: 12pt;">Estatus actual:&nbsp;</span><font style="font-size: 12pt;" color="#ff0000"><b style="">{!Customer_Quote__c.Quotation_Status__c}</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font color="#ff0000"><br></font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Times New Roman, Times, serif"><span style="font-size: 12pt;"><b style="">Order:</b></span>{!Customer_Quote__c.Name}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Times New Roman, Times, serif"><b>Pricing executive:</b>&nbsp;{!Customer_Quote__c.Pricing_Executive__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 12pt;">Cliente:</b><span style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 12pt;">&nbsp;{!Customer_Quote__c.Account_for__c}</span></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Times New Roman, Times, serif"><b>Ruta:</b>&nbsp;{!Customer_Quote__c.Route__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Times New Roman, Times, serif"><b>Venta:</b>&nbsp;{!Customer_Quote__c.Total_Services_Sell_Amount__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Times New Roman, Times, serif"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Times New Roman, Times, serif"><b><span style="color: rgb(0, 0, 0);">Solicitado por:</span><font color="#333333">&nbsp;{!Customer_Quote__c.CreatedBy}</font></b></font></div><div style=""><font color="#333333" face="Times New Roman, Times, serif"><b>Solicitado Fecha/Hora: {!Customer_Quote__c.Date_Send_Request__c}</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="font-size: 12pt;"><b>Comentarios:</b>&nbsp;</font><font face="arial" style="font-size: medium;">{!Customer_Quote__c.Status_Observations__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: medium;">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </font><font face="arial">{!Customer_Quote__c.Observations__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div></div></div>]]></td>
