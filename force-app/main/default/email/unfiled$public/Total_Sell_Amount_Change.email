<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="text-align: center;"><b style=""><font style="background-color: rgb(255, 255, 102);" size="4" color="#ff0000">**CAMBIO EN EL TOTAL DE LA VENTA / COSTO**</font></b></div><div style="text-align: center;"><b style=""><font style="background-color: rgb(255, 255, 102);" size="4" color="#ff0000">SHIPMENT</font></b></div>]]></td>
</tr>
<tr valign="top" height="300" >
<td tEditID="c1r2" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Para este Shipment&nbsp;</span></font><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 16px;">{!Shipment__c.Name}</span><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">&nbsp;se ha realizado un cambio en los siguientes valores:</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b><br></b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b style="color: rgb(0, 0, 0); font-family: arial;"><u><span style="font-size: 12pt;">Total Sell Amount </span><font size="2">(Venta)</font></u><span style="font-size: 12pt;">:&nbsp;</span></b><font face="arial"><b>{!Shipment__c.Total_Services_Sell_Amount__c}</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><u><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Total&nbsp;</b><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Buy Amount </b><b style="color: rgb(0, 0, 0); font-family: arial;"><font size="2">(Costo)</font></b></u><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">:</b><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">&nbsp;</span><font face="arial"><b>{!Shipment__c.Total_Services_Std_Buy_Amount__c}</b></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt; color: rgb(0, 0, 0); font-family: arial;"><br></span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><u>Datos del Embarque:</u></div><div style=""><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;"><b>Estatus actual:</b>&nbsp;</span></font><font face="arial" style="">{!Shipment__c.Shipment_Status_Mon__c}</font></div><div style="color: rgb(0, 0, 0);"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Shipment:</b>&nbsp;</span><font face="arial">{!Shipment__c.Name}</font></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Cliente</b>:&nbsp;</span><font face="arial">{!Shipment__c.Account_for__c}</font></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Route</b>:&nbsp;{!Shipment__c.Route__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Shipment creado por</b>:&nbsp;{!Shipment__c.CreatedBy}</div><div style=""><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Modificado por:</b><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">&nbsp;</span><font face="arial">{!Shipment__c.LastModifiedBy}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: medium;">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div></div>]]></td>
</tr>
