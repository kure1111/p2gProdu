<![CDATA[<blockquote style="color: rgb(0, 0, 0); font-family: arial; margin: 0px 0px 0px 40px; border: none; padding: 0px;"><font face="arial" style="" size="4"><br></font></blockquote><blockquote style="margin: 0px 0px 0px 40px; border: none; padding: 0px;"><font size="4" style="color: rgb(0, 0, 0); font-family: arial;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial;">Se ha solicitado una cotización Folio&nbsp;</font><font color="#ff0000" face="arial" style=""><i>{!Customer_Quote__c.Name}</i></font><span style="color: rgb(0, 0, 0); font-family: arial;">&nbsp;al día&nbsp;</span></font><font color="#ff0000" face="arial" size="4" style=""><i style="">{!Customer_Quote__c.CreatedDate}</i></font></blockquote><blockquote style="color: rgb(0, 0, 0); font-family: arial; margin: 0px 0px 0px 40px; border: none; padding: 0px;"><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4" style=""><i style="">Solicitud de cotización por:&nbsp;</i></font><i style="color: rgb(255, 0, 0);"><font size="4">{!Customer_Quote__c.CreatedBy}</font></i></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i style="">Tipo de servicio IMPAK:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.CE_Tipodeservicio_IMPAK__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i>Padron IMPAK:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.IMPAK__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i>Freight Mode:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.Freight_Mode__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i>Border:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.Border__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i>Custom:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.Customs__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i>Service Mode:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.Service_Mode__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i>Service Type:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.Service_Type__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i>Sales Incoterm:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.Sales_Incoterm__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i>State of Load:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.State_of_Load__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial;"><font size="4"><i>State of Discharge:&nbsp;</i><i style="color: rgb(255, 0, 0);">{!Customer_Quote__c.State_of_Discharge__c}</i></font></div></blockquote>]]></td>
