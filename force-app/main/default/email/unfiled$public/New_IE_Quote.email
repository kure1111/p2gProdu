<tr valign="top" height="300" >
<td tEditID="c1r2" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Estimad@ Executivo una nueva Cotizacion ha sido creada.</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Order:&nbsp;&nbsp;<b>{!Customer_Quote__c.Name}</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Cliente:&nbsp;<b>{!Account.Name}</b></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Route:&nbsp;<b>{!Customer_Quote__c.Site_of_Load__c} -&nbsp;{!Customer_Quote__c.Site_of_Discharge__c}</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0);">Solicitado por:</span><font color="#333333">&nbsp;{!Customer_Quote__c.CreatedBy}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Detalles:</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><i style="">Freight Mode: <font color="#333333">{!Customer_Quote__c.Freight_Mode__c}</font></i></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><i style="">Service Mode: <font color="#333333">{!Customer_Quote__c.Service_Mode__c}</font></i></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="font-size: 12pt;"><b>Comentarios:</b>&nbsp;</font><font face="arial" style="font-size: medium;">{!Customer_Quote__c.Status_Observations__c}</font></div><div style="color: rgb(0, 0, 0);"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: medium;">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </font><font face="arial">{!Customer_Quote__c.Observations__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><br></font></div><div style="font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-size: 12pt;">Estatus actual:&nbsp;</span><font style="font-size: 12pt;" color="#3333ff">{!Customer_Quote__c.Quotation_Status__c}</font></div><div style="font-family: arial; font-size: 12pt;"><font face="arial" color="#3333ff"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div></div>]]></td>
</tr>
