<tr valign="top" height="50" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="text-align: center;"><b style=""><font style="background-color: rgb(255, 255, 255);" size="4" color="#ff0000">**SOLICITUD DE CANCELACION PEDIDO DE VENTA**</font></b></div>]]></td>
</tr>
<tr valign="top" height="300" >
<td tEditID="c1r2" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Se solicita la Cancelacion en SAP del "Pedido de Venta" [</font><font face="arial">{!Invoice__c.Name}</font><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">]</font><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">&nbsp;, favor de confirmar Recepción de esta Solicitud y continuar con el proceso.</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Times New Roman, Times, serif" style="color: rgb(0, 0, 0); font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-size: 12pt;">Invoice:&nbsp;</span></font><font face="Times New Roman, Times, serif" style=""><b>{!Invoice__c.Name}</b></font></div><div style=""><font face="Times New Roman, Times, serif" style="color: rgb(0, 0, 0); font-size: 12pt;">SAP:<b>&nbsp;</b></font><font face="Times New Roman, Times, serif"><b>{!Invoice__c.FolioEntrega__c}</b></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Times New Roman, Times, serif"><font style="font-size: 12pt;">Shipment:&nbsp;&nbsp;</font><b>{!Invoice__c.Shipment__c}</b></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Times New Roman, Times, serif" style="color: rgb(0, 0, 0); font-size: 12pt;">Cliente:&nbsp;</font><font face="Times New Roman, Times, serif">{!Invoice__c.Account__c}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Times New Roman, Times, serif"><font style="font-size: 12pt;">Fecha recibido en SAP:&nbsp;</font><font style="font-size: 12pt;">{!Invoice__c.Date_Receive_from_SAP__c}</font></font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Times New Roman, Times, serif" style="color: rgb(0, 0, 0); font-size: 12pt;">Importe SAP:&nbsp;</font><font face="Times New Roman, Times, serif">{!Invoice__c.Total_Invoice_SAP__c}</font></div><div style="color: rgb(0, 0, 0); font-size: 12pt;"><font face="Times New Roman, Times, serif" style="">Timbrado SAP:&nbsp;{!Invoice__c.Timbrado_Factura_SAP__c}</font></div>]]></td>
</tr>
<tr valign="top" height="50" >
<td tEditID="c1r3" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r3" locked="0" >
<![CDATA[<div style=""><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Para mayor detalle consultar:&nbsp;</font><font color="#000099" face="arial">{!Invoice__c.Link}</font></div>]]></td>
