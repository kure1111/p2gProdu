<td tEditID="c1r2" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<div style=""><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><p style="margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif">Estimad@
Equipo de comercial y operaciones, este Shipment ha llegado a sitio de Descarga,
por favor validar posibles gastos extras.<o:p></o:p></font></p>

<p style="margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif">&nbsp;<o:p></o:p></font></p>

<p style="margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif">Detalles:&nbsp;</font><span style="font-family: &quot;Calibri Light&quot;, sans-serif;"><o:p></o:p></span></p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font color="#ff0000"><br></font></div><div style=""><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-size: 12pt;">Folio:&nbsp;<o:p></o:p></font><font face="Arial, sans-serif">{!Shipment__c.Name}</font></p>

<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-size: 12pt;">Planner:&nbsp;</font><font face="Arial, sans-serif">{!Shipment__c.Operation_Executive__c}</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0cm 0cm 0.0001pt;"><span lang="EN-US" style="font-family: Arial, sans-serif; background-color: white; font-size: 12pt;">Shipment Status Monitoreo:&nbsp;{!Shipment__c.Shipment_Status_Mon__c}</span></p>

<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-size: 12pt;">Cliente:&nbsp;<o:p></o:p></font><font face="Arial, sans-serif">{!Shipment__c.Account_for__c}</font></p>

<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-size: 12pt;">Ruta:&nbsp;<o:p></o:p></font><font face="Arial, sans-serif">{!Shipment__c.Route__c}</font></p>

<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-size: 12pt;">Venta:&nbsp;<o:p></o:p></font><font face="Arial, sans-serif">{!Shipment__c.Total_Services_Sell_Amount__c}</font></p>

<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-size: 12pt;">Costo:&nbsp;<o:p></o:p></font><font face="Arial, sans-serif">{!Shipment__c.Total_Services_Std_Buy_Amount__c}</font></p>

<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-size: 12pt;">Proveedor:&nbsp;<o:p></o:p></font><font face="Arial, sans-serif">{!Shipment__c.Carrier__c}</font></p>

<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0cm 0cm 0.0001pt; vertical-align: baseline;"><font face="Arial, sans-serif" style="font-size: 12pt;"><span lang="EN-US">ATD :&nbsp;</span></font><font face="Arial, sans-serif" style="font-size: 12pt;">{!Shipment__c.ATD__c}</font></p>

<p style="margin: 0cm 0cm 0.0001pt;"><span style="color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 12pt;">ATD time:</span><font face="Arial, sans-serif">{!Shipment__c.00N4T000005tVYh}</font></p><p style="margin: 0cm 0cm 0.0001pt;"><span style="font-family: Arial, sans-serif; font-size: 16px;">ATA :</span><font face="Arial, sans-serif">{!Shipment__c.ATA__c}</font><span style="font-family: Arial, sans-serif; font-size: 12pt; white-space: pre;">	</span></p><p style="margin: 0cm 0cm 0.0001pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span lang="EN-US" style="">Unloading Arrival Time:&nbsp;</span></font><font face="Arial, sans-serif">{!Shipment__c.Equip_Reserved__c}</font></p></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><br></font></div><div style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;"><br></div><div style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;"><br></div><div style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;"><br></div></div></div>]]></td>
