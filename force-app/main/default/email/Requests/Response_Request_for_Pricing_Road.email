<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;"><br></span></font></div><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Estimad@ </span>{!Customer_Quote__c.CreatedBy} su&nbsp;<span style="font-size: 12pt;">Requerimiento de Tarifa ha sido Respondido por el equipo Pricing.</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Cotizacion:&nbsp;&nbsp;<b>{!Customer_Quote__c.Name}</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Cliente:&nbsp;<b>{!Account.Name}</b></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Route:&nbsp;{!Customer_Quote__c.Site_of_Load__c} -&nbsp;{!Customer_Quote__c.Site_of_Discharge__c}</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0);"><br></span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0);"><b>Solicitado por</b>:</span><font color="#333333">&nbsp;{!Customer_Quote__c.CreatedBy}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;"><b>Contestado por</b>:&nbsp;</span></font><font face="arial">{!Customer_Quote__c.Pricing_Executive__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><b>Venta Total (Sugerida)</b>:{!Customer_Quote__c.Total_Services_Sell_Amount__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Costo Total:</b>&nbsp;{!Customer_Quote__c.Total_Services_Std_Buy_Amount__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Profit</b>:&nbsp;{!Customer_Quote__c.Services_Margin__c}</div><div style=""><font face="arial"><b>Equipo:</b> {!Quote_Item_Line__c.Container_Type__c}&nbsp;{!Customer_Quote__c.Container_Type__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><b>Observaciones</b>:</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!Customer_Quote__c.Observations__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div></div>]]></td>
