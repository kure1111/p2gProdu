<![CDATA[<font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Estimad@ Equipo Pricing un nuevo Requerimiento de Tarifa ha sido asignado a Uds.</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Cotizacion:&nbsp;&nbsp;<b>{!Customer_Quote__c.Name}</b></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Cliente:&nbsp;<b>{!Account.Name}</b></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0);">Solicitado por:</span><font color="#333333">&nbsp;{!Customer_Quote__c.CreatedBy}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Detalles:</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><i style="">Freight Mode: <font color="#333333">{!Customer_Quote__c.Freight_Mode__c}</font></i></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><i style="">Service Mode: <font color="#333333">{!Customer_Quote__c.Service_Mode__c}</font></i></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><i style="">Service Type:&nbsp;</i></font><font face="arial"><i>{!Customer_Quote__c.Service_Type__c}</i></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><i style="">Total Item Units: <font color="#333333">{!Customer_Quote__c.Total_Items_Units__c}</font></i></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><i style="">Total Weight (kg): <font color="#333333">{!Customer_Quote__c.Total_Weight_Kg2__c}</font></i></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><i style="">Total Volume (m3): <font color="#333333">{!Customer_Quote__c.Total_Volume_m3_2__c}</font></i></font></div><div style=""><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Arrastre en BL:&nbsp;</font><font face="arial">{!Customer_Quote__c.Drayage_SD__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: 12pt;">Merchandise Insurance:&nbsp;{!Customer_Quote__c.Merchandise_Insurance__c}</div><div style="font-size: 12pt;"><br></div></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Comentarios:</b>&nbsp;</font><font face="arial">{!Customer_Quote__c.Status_Observations__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div></div>]]></td>
