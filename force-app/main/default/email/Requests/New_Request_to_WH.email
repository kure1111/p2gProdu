<tr valign="top" height="300" >
<td tEditID="c1r2" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Estimad@ Responsable de Almacenajes un nuevo Requerimiento de Tarifa le ha sido asignado.</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="Times New Roman, Times, serif">Order:&nbsp;&nbsp;<b>{!Customer_Quote__c.Name}</b></font></div><div style="font-size: 12pt; background-color: rgb(255, 255, 255);"><font face="Times New Roman, Times, serif">Cliente:&nbsp;<b>{!Account.Name}</b></font></div><div style="background-color: rgb(255, 255, 255);"><div style="font-size: 12pt;"><font face="Times New Roman, Times, serif"><span style="font-size: 12pt;">Solicitado por:</span><font color="#333333" style="font-size: 12pt;">&nbsp;{!Customer_Quote__c.CreatedBy}</font></font></div><div style="font-size: 12pt;"><font face="Times New Roman, Times, serif"><b style="font-size: 12pt;"><br></b></font></div><div style="font-size: 12pt;"><font face="Times New Roman, Times, serif"><b style="font-size: 12pt;">Detalles:</b></font></div><div><font color="#333333"><font face="Times New Roman, Times, serif" style="font-size: 12pt;"><span style="font-size: 12pt;">Presentacion:&nbsp;</span></font><font face="Times New Roman, Times, serif">{!Customer_Quote__c.WHPresentacion_del_Producto__c}</font></font></div><div><font color="#333333"><span style="font-size: 12pt; font-family: &quot;Times New Roman&quot;, Times, serif;">Volumen:&nbsp;</span><font face="Times New Roman, Times, serif">{!Customer_Quote__c.WHVolumen_producto_mes__c}</font></font></div><div><font color="#333333"><span style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 12pt;">Comentarios:&nbsp;</span><font face="Times New Roman, Times, serif">{!Customer_Quote__c.Collection_Required__c}</font></font></div><div><font color="#333333"><font face="Times New Roman, Times, serif" style="font-size: 12pt;">Tipo de Unidad (Arrivo y Salida):&nbsp;</font><font face="Times New Roman, Times, serif">{!Customer_Quote__c.Unidades_Arrivo_Salida__c}</font></font></div><div><font face="Times New Roman, Times, serif" color="#333333">Frecuencia (llegada/Salida):&nbsp;{!Customer_Quote__c.WHFrecuencia_de_Llegada__c} /&nbsp;{!Customer_Quote__c.WHFrecuencia_de_Salida__c}</font></div><div><font face="Times New Roman, Times, serif" color="#333333">Condiciones Especiales:&nbsp;{!Customer_Quote__c.WHCondiciones_Especiales__c}</font></div><div><font face="Times New Roman, Times, serif" color="#333333">Servicios Adicionales:&nbsp;{!Customer_Quote__c.WHServicios_Adicionales__c}</font></div></div></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial" style=""><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div></div>]]></td>
</tr>
