<![CDATA[<div style="font-size: 12pt; font-family: arial; color: rgb(0, 0, 0);"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;"><br></span></font></div><b style=""><font style="" face="Arial, sans-serif"><div style=""><b style=""><font style="">Para este Shipment&nbsp;</font>{!Shipment__c.Name}<font style="">&nbsp;se ha creado un Service Lines Adicional que no esta relacionada a la Import Export Quote de Origen:&nbsp;</font></b><font style=""><b>{!Customer_Quote__c.Name}</b></font></div></font></b><div style=""><b style="font-family: Arial, sans-serif;"><br></b></div><div style=""><b style="font-family: Arial, sans-serif;">Validar información y v</b><b style="font-family: Arial, sans-serif;">olver a enviar a SAP mediante botón Send to SAP, para actualizar OV/SC.</b></div><div style=""><div style=""><div style=""><font face="Arial, sans-serif"><br></font></div><div style=""><font face="Arial, sans-serif"><br></font></div><div style=""><div style="text-align: center;"><u style=""><font face="Arial, sans-serif"><b>Datos del Embarque:</b></font></u></div><div style=""><u style=""><font face="Arial, sans-serif"><br></font></u></div><div style=""><font face="Arial, sans-serif"><font style=""><b>Estatus actual:</b>&nbsp;</font>{!Shipment__c.Shipment_Status_Mon__c}</font></div><div style=""><font face="Arial, sans-serif"><b>Shipment:</b>&nbsp;{!Shipment__c.Name}</font></div></div><div style=""><font face="Arial, sans-serif"><b>Cliente</b>:&nbsp;{!Shipment__c.Account_for__c}</font></div><div style=""><div style=""><font face="Arial, sans-serif"><b>Route</b>:&nbsp;{!Shipment__c.Route__c}</font></div><div style=""><font face="Arial, sans-serif"><b>Shipment creado por</b>:&nbsp;{!Shipment__c.CreatedBy}</font></div><div style=""><font face="Arial, sans-serif" style=""><b style="">Modificado por:</b>&nbsp;<font style="">{!Shipment__c.LastModifiedBy}</font></font></div><div style="font-size: 12pt; font-family: arial;"><br></div><div style="font-size: 12pt; font-family: arial; color: rgb(0, 0, 0);"><br></div><div style="font-size: 12pt; font-family: arial; color: rgb(0, 0, 0);"><br></div><div style="font-size: 12pt; font-family: arial; color: rgb(0, 0, 0);"><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: medium;">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></div><div style="font-size: 12pt; font-family: arial; color: rgb(0, 0, 0);"><font face="arial" style=""><br></font></div><div style="font-size: 12pt; font-family: arial; color: rgb(0, 0, 0);"><br></div></div></div></div>]]></td>
