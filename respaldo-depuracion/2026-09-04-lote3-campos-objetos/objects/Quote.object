    <validationRules>
        <fullName>Validar_check_Accepted</fullName>
        <active>false</active>
        <description>Si el status es accepted, marcar casilla vendido, se necesita para que de la venta final en la opportunidad</description>
        <errorConditionFormula>AND(
ISPICKVAL(Status,&quot;Accepted&quot;),
Vendido__c = false,
IsSyncing = false

)</errorConditionFormula>
        <errorDisplayField>IsSyncing</errorDisplayField>
        <errorMessage>Quote001- Marcar la casilla Vendido y Sincronizar quote</errorMessage>
    </validationRules>
</CustomObject>
