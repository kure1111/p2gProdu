    <recordTypes>
        <fullName>Proyecto</fullName>
        <active>true</active>
        <compactLayoutAssignment>QUOTE_VENDIDA</compactLayoutAssignment>
        <description>Etapas de quote en opportunity - Proyectos</description>
        <label>Quote Proyecto</label>
        <picklistValues>
            <picklist>Status</picklist>
            <values>
                <fullName>Accepted</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Denied</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Draft</fullName>
                <default>true</default>
            </values>
        </picklistValues>
    </recordTypes>
    <recordTypes>
