    <fields>
        <fullName>Buy_Amount__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Ship_Prog_Buy_Price__c&gt;= 0 ,MAX (Ship_Prog_Buy_Price__c * Units__c, IF((ISNULL(Ship_Prog_Buy_Price__c)== true) || (Ship_Prog_Buy_Price__c = 0), 0, Min_Amount__c ) ), MIN (Ship_Prog_Buy_Price__c* Units__c, IF((ISNULL(Ship_Prog_Buy_Price__c )== true) || (Ship_Prog_Buy_Price__c = 0), 0, - Min_Amount__c ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Buy Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
