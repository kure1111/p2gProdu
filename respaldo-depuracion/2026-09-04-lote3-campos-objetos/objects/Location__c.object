    <validationRules>
        <fullName>SinComas</fullName>
        <active>true</active>
        <description>Name sin comas</description>
        <errorConditionFormula>CONTAINS( Name, &quot;,&quot;)</errorConditionFormula>
        <errorMessage>ERROR- Location no puede tener coma</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validation_State</fullName>
        <active>false</active>
        <errorConditionFormula>( Country__r.Name = &apos;United States&apos; || Country__r.Name = &apos;Mexico&apos; )  &amp;&amp;  State__c == null</errorConditionFormula>
        <errorDisplayField>State__c</errorDisplayField>
        <errorMessage>The field State is required</errorMessage>
