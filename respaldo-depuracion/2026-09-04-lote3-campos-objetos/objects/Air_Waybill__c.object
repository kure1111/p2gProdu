    </validationRules>
    <validationRules>
        <fullName>WT_VAL_equal_Other_Prepaid_Collect_House</fullName>
        <active>false</active>
        <errorConditionFormula>TEXT(Prepaid_Collect_House_WT_VAL__c) &lt;&gt; TEXT(Prepaid_Collect_House_Other__c)</errorConditionFormula>
        <errorDisplayField>Prepaid_Collect_House_WT_VAL__c</errorDisplayField>
        <errorMessage>Prepaid/Collect House (WT/VAL) must be equal to Prepaid/Collect House (Other)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>WT_VAL_equals_Other_Prepaid_Collect</fullName>
        <active>false</active>
        <errorConditionFormula>TEXT(Prepaid_Collect_WT_VAL__c) &lt;&gt; TEXT(Prepaid_Collect_Other__c)</errorConditionFormula>
        <errorDisplayField>Prepaid_Collect_WT_VAL__c</errorDisplayField>
        <errorMessage>Prepaid / Collect (WT / VAL) must be equal to Prepaid / Collect (Other)</errorMessage>
    </validationRules>
