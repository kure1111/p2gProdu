        <type>Url</type>
    </fields>
    <fields>
        <fullName>Document__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Document_URL__c !=null,HYPERLINK(  MID($Api.Enterprise_Server_URL_300, FIND(&apos;/&apos;,$Api.Enterprise_Server_URL_300,9),FIND( &apos;/services&apos;, $Api.Enterprise_Server_URL_300)- FIND(&apos;/&apos;,$Api.Enterprise_Server_URL_300,9))+Document_URL__c  , IMAGE(&apos;/img/icon/contracts32.png&apos;,&apos;Document&apos;,32,32),&apos;_blank&apos;),IF(  Manual_Document_URL__c !=null,HYPERLINK(   Manual_Document_URL__c , IMAGE(&apos;/img/icon/contracts32.png&apos;,&apos;Document&apos;,32,32),&apos;_blank&apos;),null))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Document</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
