    <fields>
        <fullName>On_Time_Delivery__c</fullName>
        <description>Calcula si el Servicio empezó la carga en la fecha y hora programada.</description>
        <externalId>false</externalId>
        <formula>IF( NOT(ISBLANK( Shipment_History__c )),

IF( Shipment_History__r.ETA_Point_of_Discharge__c == DATEVALUE( CreatedDate ),

IF( Shipment_History__r.ETA_Time_Point_of_Discharge__c == TIMEVALUE( CreatedDate ), &apos;Descargado a Tiempo&apos;,

IF( Shipment_History__r.ETA_Time_Point_of_Discharge__c &lt; TIMEVALUE( CreatedDate ), &apos;Descargado Tarde&apos;, &apos;Descargado a Tiempo&apos;))

,IF( Shipment_History__r.ETA_Point_of_Discharge__c &lt; DATEVALUE( CreatedDate ), &apos;Descargado Tarde&apos;, &apos;Descargado a Tiempo&apos;
)),

&apos;No es un historial de Shipment&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>On Time Delivery</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>On_Time_Pickup__c</fullName>
        <description>Calcula si el Servicio empezó la carga en la fecha y hora programada.</description>
        <externalId>false</externalId>
        <formula>IF( NOT(ISBLANK( Shipment_History__c )),

IF( Shipment_History__r.ETD_from_Point_of_Load__c == DATEVALUE( CreatedDate ),

IF( Shipment_History__r.ETD_Time_from_Point_of_Load__c == TIMEVALUE( CreatedDate ), &apos;Cargado a Tiempo&apos;, 

IF( Shipment_History__r.ETD_Time_from_Point_of_Load__c &lt; TIMEVALUE( CreatedDate ), &apos;Cargado Tarde&apos;, &apos;Cargado a Tiempo&apos;))

,IF( Shipment_History__r.ETD_from_Point_of_Load__c &lt; DATEVALUE( CreatedDate ), &apos;Cargado Tarde&apos;, &apos;Cargado a Tiempo&apos;
)),

&apos;No es un historial de Shipment&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>On Time Pickup</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
