    <validationRules>
        <fullName>Capturar_geolocalizacion</fullName>
        <active>false</active>
        <errorConditionFormula>ISBLANK(Address_Coordinates__c)</errorConditionFormula>
        <errorMessage>Por seguridad, favor de ingresar al perfil del cliente y modificar la dirección en el apartado de Account Addresses (pestaña Related)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validacion</fullName>
        <active>false</active>
        <description>Una vez que control room valida la dirección esta no puede cambiar</description>
        <errorConditionFormula>ISPICKVAL(status__c, &quot;Validado&quot;)</errorConditionFormula>
        <errorMessage>Cuenta validada, no puede modificar la dirección</errorMessage>
    </validationRules>
