    <fields>
        <fullName>Direcci_n__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  AND(CONTAINS(  Localidad_Cat2__c, &quot; &quot; ), CONTAINS(  Numero_Int_cat__c, &quot; &quot; )) 
,

Calle_cat__c  &amp; &quot;, &quot; &amp;  Numero_Ext_cp__c  &amp; &quot;-&quot; &amp;  Numero_Int_cat__c  &amp; &quot;, &quot; &amp;  Colonia_cp__r.Name &amp; &quot;, &quot; &amp; Codigo_Postal_CP__r.Name &amp; &quot;, &quot; &amp;   Municipio_Cat2__c  &amp; &quot;, &quot; &amp;   Estado_cat2__c  &amp; &quot;, &quot; &amp;  Pais_cat1__c 

,
 Calle_cat__c  &amp; &quot;, &quot; &amp;  Numero_Ext_cp__c  &amp; &quot;-&quot; &amp;  Numero_Int_cat__c  &amp; &quot;, &quot; &amp;  Colonia_cp__r.Name &amp; &quot;, &quot; &amp; Codigo_Postal_CP__r.Name &amp; &quot;, &quot; &amp;  Localidad_Cat2__c  &amp; &quot;, &quot; &amp;  Municipio_Cat2__c &amp; &quot;, &quot; &amp;  Estado_cat2__c &amp; &quot;, &quot; &amp;  Pais_cat1__c 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
