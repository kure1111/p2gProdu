        <unique>false</unique>
    </fields>
    <fields>
        <fullName>status__c</fullName>
        <description>Este campo registra los estatus en el proceso de validación de las coordenadas por el equipo de monitoreo en control room status_CR</description>
        <externalId>false</externalId>
        <label>Status CR</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Nuevo</fullName>
                    <default>true</default>
                    <label>Nuevo</label>
                </value>
                <value>
                    <fullName>Pendiente</fullName>
                    <default>false</default>
                    <label>Pendiente</label>
                </value>
                <value>
                    <fullName>Validado</fullName>
                    <default>false</default>
                    <label>Validado</label>
                </value>
                <value>
                    <fullName>Rechazado</fullName>
                    <default>false</default>
                    <label>Rechazado</label>
                </value>
                <value>
                    <fullName>Error</fullName>
                    <default>false</default>
                    <label>Error</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>url_rc__c</fullName>
        <externalId>false</externalId>
        <label>url CR</label>
        <length>250</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
