    <fields>
        <fullName>State_Zone__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK( Name ), &quot;None&quot;,

CASE(Name, &quot;Campeche&quot;, &quot;Centro&quot;, &quot;Chiapas&quot;, &quot;Centro&quot;, &quot;Ciudad de Mexico&quot;, &quot;Centro&quot;, &quot;Edo. Mexico&quot;, &quot;Centro&quot;, &quot;Guerrero&quot;, &quot;Centro&quot;, &quot;Hidalgo&quot;, &quot;Centro&quot;, &quot;Morelos&quot;, &quot;Centro&quot;, &quot;Oaxaca&quot;, &quot;Centro&quot;, &quot;Puebla&quot;, &quot;Centro&quot;, &quot;Quintana Roo&quot;, &quot;Centro&quot;, &quot;Tabasco&quot;, &quot;Centro&quot;, &quot;Tlaxcala&quot;, &quot;Centro&quot;, &quot;Veracruz&quot;, &quot;Centro&quot;, &quot;Yucatan&quot;, &quot;Centro&quot;,

CASE(Name, &quot;Coahuila&quot;, &quot;Noreste&quot;, &quot;Durango&quot;, &quot;Noreste&quot;, &quot;Nuevo Leon&quot;, &quot;Noreste&quot;, &quot;Tamaulipas&quot;, &quot;Noreste&quot;,

CASE(Name, &quot;Aguascalientes&quot;, &quot;Occidente&quot;, &quot;Colima&quot;, &quot;Occidente&quot;, &quot;Guanajuato&quot;, &quot;Occidente&quot;, &quot;Jalisco&quot;, &quot;Occidente&quot;, &quot;Michoacan de Ocampo&quot;, &quot;Occidente&quot;, &quot;Nayarit&quot;, &quot;Occidente&quot;, &quot;Queretaro&quot;, &quot;Occidente&quot;, &quot;San Luis Potosi&quot;, &quot;Occidente&quot;, &quot;Sinaloa&quot;, &quot;Occidente&quot;, &quot;Zacatecas&quot;, &quot;Occidente&quot;,

CASE(Name, &quot;Baja California&quot;, &quot;Noroeste&quot;, &quot;Baja California Sur&quot;, &quot;Noroeste&quot;, &quot;Chihuahua&quot;, &quot;Noroeste&quot;, &quot;Sonora&quot;, &quot;Noroeste&quot;,

&quot;Otro&quot;)))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>State Zone</label>
