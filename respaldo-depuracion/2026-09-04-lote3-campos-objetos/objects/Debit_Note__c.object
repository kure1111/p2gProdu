    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Account_for__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>Campo para asignar al cliente al que hará referencia la Debit Note</description>
        <externalId>false</externalId>
        <label>Account for (Customer)</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Debit Notes</relationshipLabel>
        <relationshipName>Debit_Notes</relationshipName>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>DN_Status__c</fullName>
        <description>Picklist que específica en que estatus del proceso se encuentra la Debit Note</description>
        <externalId>false</externalId>
        <label>Debit Note Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>En proceso</fullName>
                    <default>false</default>
                    <label>En proceso</label>
                </value>
                <value>
                    <fullName>Creado</fullName>
                    <default>false</default>
                    <label>Creado</label>
                </value>
                <value>
                    <fullName>Enviado SAP</fullName>
                    <default>false</default>
                    <label>Enviado SAP</label>
                </value>
                <value>
                    <fullName>Finalizado</fullName>
                    <default>false</default>
                    <label>Finalizado</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Folio_y_Flex_ID__c</fullName>
        <description>Campo para consultar el valor los folios en la Debit Note y el Customer Reference de cada uno</description>
        <externalId>false</externalId>
        <formula>&apos;1. &apos;+Shipment_Number_1__r.Name+&apos; &apos;+IF( NOT(ISBLANK( Shipment_Number_1__r.Account_Shipment_Reference__c )), (&apos;1. &apos;+Shipment_Number_1__r.Account_Shipment_Reference__c+&apos;&apos;+BR()), &apos;1. Null&apos;+BR())
+&apos;&apos;+
IF( NOT(ISBLANK(Shipment_Number_2__r.Name)), (&apos;2. &apos;+Shipment_Number_2__r.Name), &apos;2. Null&apos;)+&apos; &apos;+IF( NOT(ISBLANK( Shipment_Number_2__r.Account_Shipment_Reference__c )), (&apos;2. &apos;+Shipment_Number_2__r.Account_Shipment_Reference__c+&apos;&apos;+BR()), &apos;2. Null&apos;+BR())
+&apos;&apos;+
IF( NOT(ISBLANK(Shipment_Number_3__r.Name)), (&apos;3. &apos;+Shipment_Number_3__r.Name), &apos;3. Null&apos;)+&apos; &apos;+IF( NOT(ISBLANK( Shipment_Number_3__r.Account_Shipment_Reference__c )), (&apos;3. &apos;+Shipment_Number_3__r.Account_Shipment_Reference__c+&apos;&apos;+BR()), &apos;3. Null&apos;+BR())
+&apos;&apos;+
IF( NOT(ISBLANK(Shipment_Number_4__r.Name)), (&apos;4. &apos;+Shipment_Number_4__r.Name), &apos;4. Null&apos;)+&apos; &apos;+IF( NOT(ISBLANK( Shipment_Number_4__r.Account_Shipment_Reference__c )), (&apos;4. &apos;+Shipment_Number_4__r.Account_Shipment_Reference__c+&apos;&apos;+BR()), &apos;4. Null&apos;+BR())
+&apos;&apos;+
IF( NOT(ISBLANK(Shipment_Number_5__r.Name)), (&apos;5. &apos;+Shipment_Number_5__r.Name), &apos;5. Null&apos;)+&apos; &apos;+IF( NOT(ISBLANK( Shipment_Number_5__r.Account_Shipment_Reference__c )), (&apos;5. &apos;+Shipment_Number_5__r.Account_Shipment_Reference__c+&apos;&apos;+BR()), &apos;5. Null&apos;+BR())</formula>
        <label>Folio y Flex ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
