    <fields>
        <fullName>Importe_MXN__c</fullName>
        <description>Fórmula para cálcular el total de servicios vendidos en MXN</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(CurrencyIsoCode,&apos;USD&apos;),(Shipment_Number_1__r.Total_Services_Sell_Amount__c + Shipment_Number_2__r.Total_Services_Sell_Amount__c + Shipment_Number_3__r.Total_Services_Sell_Amount__c + Shipment_Number_4__r.Total_Services_Sell_Amount__c + Shipment_Number_5__r.Total_Services_Sell_Amount__c) / ( CURRENCYRATE(TEXT( CurrencyIsoCode )) ),
Shipment_Number_1__r.Total_Services_Sell_Amount__c + Shipment_Number_2__r.Total_Services_Sell_Amount__c + Shipment_Number_3__r.Total_Services_Sell_Amount__c + Shipment_Number_4__r.Total_Services_Sell_Amount__c + Shipment_Number_5__r.Total_Services_Sell_Amount__c
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Importe MXN</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Importe_USD__c</fullName>
        <description>Fórmula para calcular el total de servicios vendidos</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(CurrencyIsoCode,&apos;MXN&apos;),(Shipment_Number_1__r.Total_Services_Sell_Amount__c + Shipment_Number_2__r.Total_Services_Sell_Amount__c + Shipment_Number_3__r.Total_Services_Sell_Amount__c + Shipment_Number_4__r.Total_Services_Sell_Amount__c + Shipment_Number_5__r.Total_Services_Sell_Amount__c) * ( CURRENCYRATE(&apos;USD&apos;) ),
Shipment_Number_1__r.Total_Services_Sell_Amount__c + Shipment_Number_2__r.Total_Services_Sell_Amount__c + Shipment_Number_3__r.Total_Services_Sell_Amount__c + Shipment_Number_4__r.Total_Services_Sell_Amount__c + Shipment_Number_5__r.Total_Services_Sell_Amount__c
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Importe USD</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
