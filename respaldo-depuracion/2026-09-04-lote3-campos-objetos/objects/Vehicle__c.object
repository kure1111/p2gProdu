    <validationRules>
        <fullName>VH001</fullName>
        <active>true</active>
        <description>Debe de ser un valor Numérico</description>
        <errorConditionFormula>AND(
NOT(ISBLANK(Prima_Seguro__c)),

NOT(REGEX(Prima_Seguro__c, &quot;^[0-9]+$&quot;))
)</errorConditionFormula>
        <errorDisplayField>Prima_Seguro__c</errorDisplayField>
        <errorMessage>VH001 - El valor de Prima Seguro debe de ser un valor Numérico.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VH002</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(ISBLANK(Num_Placa_Tracto__c)),

NOT(REGEX(Num_Placa_Tracto__c, &quot;^[a-zA-Z0-9]+$&quot;))

)</errorConditionFormula>
        <errorDisplayField>Num_Placa_Tracto__c</errorDisplayField>
        <errorMessage>VH002 - Solo se pueden poner letras y numeros en la placa.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
