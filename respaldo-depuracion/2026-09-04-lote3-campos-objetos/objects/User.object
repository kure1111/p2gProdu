    <validationRules>
        <fullName>US001_No_cambiar_los_datos</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  NOT( $Profile.Id = &quot;00e4T000000zD9C&quot; ),
  NOT( ISCHANGED( Fax ) ),
  NOT( $User.Username = &quot;catherine.calderon@pak2go.com&quot; )
)</errorConditionFormula>
        <errorMessage>US001 - Privilegios insufucientes para editar el registro.</errorMessage>
    </validationRules>
