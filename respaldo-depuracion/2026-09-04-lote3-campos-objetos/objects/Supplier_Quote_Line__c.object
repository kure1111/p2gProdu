        <fullName>Imp_Exp_Charges_Assigned_Percent__c</fullName>
        <externalId>false</externalId>
        <formula>Imp_Exp_Charges_Assigned__c / Total_Destination_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>&quot;Imp-Exp Charges Assigned&quot; / &quot;Total Destination Amount&quot;</inlineHelpText>
        <label>Imp-Exp Charges Assigned (%)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Imp_Exp_Charges_Assigned__c</fullName>
        <description>If &quot;Total Volume (m3)&quot; from &quot;Supplier Quote/Order&quot; different from 0 then (&quot;Total Volume (m3)&quot; / &quot;Total Volume (m3)&quot; from &quot;Supplier Quote/Order&quot;) x (&quot;Total Fees Sell Amount&quot; from &quot;Supplier Quote/Order&quot; / &quot;Conversion Rate to Currency Header&quot;)
If &quot;Total Weight (Kg)&quot; from &quot;Supplier Quote/Order&quot; different from 0 then (&quot;Total Weight (Kg)&quot; / &quot;Total Weight (Kg)&quot; from &quot;Supplier Quote/Order&quot;) x (&quot;Total Fees Sell Amount&quot; from &quot;Supplier Quote/Order&quot; / &quot;Conversion Rate to Currency Header&quot;)</description>
        <externalId>false</externalId>
        <formula>IF(Supplier_Quote__r.Total_Volume_m3_2__c&lt;&gt;0,Total_Volume_m3__c/ Supplier_Quote__r.Total_Volume_m3_2__c, IF(Supplier_Quote__r.Total_Weight_Kg2__c&lt;&gt;0,Total_Weight_Kg__c / Supplier_Quote__r.Total_Weight_Kg2__c,null)) * Supplier_Quote__r.Total_Fees_Sell_Amount_number__c /  Conversion_Rate_to_Currency_Header__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>(&quot;Total Volume (m3)&quot; / &quot;Total Volume (m3)&quot; from &quot;Supplier Quote/Order&quot;) or (&quot;Total Weight (Kg)&quot; / &quot;Total Weight (Kg)&quot; from &quot;Supplier Quote/Order&quot;) x (&quot;Total Fees Sell Amount&quot; from &quot;Supplier Quote/Order&quot; / &quot;Conversion Rate to Currency Header&quot;)</inlineHelpText>
        <label>Imp-Exp Charges Assigned</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
