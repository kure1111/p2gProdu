    <validationRules>
        <fullName>Razon_del_rechazo</fullName>
        <active>true</active>
        <errorConditionFormula>if(
OR(
ISPICKVAL(Status__c,&quot;No Cotizada&quot;),
ISPICKVAL(Status__c,&quot;Rechazada&quot;)
),

Razon_del_rechazo__c = &apos;&apos;, null
)</errorConditionFormula>
        <errorDisplayField>Razon_del_rechazo__c</errorDisplayField>
        <errorMessage>PROJ 001: Favor de ingresar un motivo o razón, por lo que no se cotizo o porque se rechazo.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Nuevo_Producto</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Nuevo Producto</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>/lightning/n/Creaci_n_Productos_Paqueter_a?c__recordId={!Opportunity.Id}</url>
    </webLinks>
