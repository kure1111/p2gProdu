    <fields>
        <fullName>Tiempo_de_Respuesta__c</fullName>
        <externalId>false</externalId>
        <formula>ROUND( 9 * (
( 5 * FLOOR( ( DATEVALUE( Fecha_y_Hora_Respuesta_Pricing__c ) - DATE( 1900, 1, 8) ) / 7) +
MIN(5,
MOD( DATEVALUE( Fecha_y_Hora_Respuesta_Pricing__c ) - DATE( 1900, 1, 8), 7) +
MIN( 1, 24 / 9 * ( MOD( Fecha_y_Hora_Respuesta_Pricing__c - DATETIMEVALUE( &apos;1900-01-08 14:00:00&apos; ), 1 ) ) )
)
)
-
( 5 * FLOOR( ( DATEVALUE( Fecha_y_hora_Solicitud__c ) - DATE( 1900, 1, 8) ) / 7) +
MIN( 5,
MOD( DATEVALUE(Fecha_y_hora_Solicitud__c ) - DATE( 1996, 1, 1), 7 ) +
MIN( 1, 24 / 10 * ( MOD(Fecha_y_hora_Solicitud__c - DATETIMEVALUE( &apos;1900-01-08 14:00:00&apos; ), 1) ) )
)
)
),
MOD((Fecha_y_Hora_Respuesta_Pricing__c - DATETIMEVALUE(&apos;2017-01-02 14:00:00&apos;))*1440,1440)/60)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Tiempo de Respuesta (hrs)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
