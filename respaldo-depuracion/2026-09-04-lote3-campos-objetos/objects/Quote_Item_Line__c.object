        <fullName>tare_weight__c</fullName>
        <description>Peso Tara = Valor Calculado como el Peso Bruto - Peso Neto.</description>
        <externalId>false</externalId>
        <formula>Total_Shipping_Weight_Kgs__c - Weight_Kgs__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
