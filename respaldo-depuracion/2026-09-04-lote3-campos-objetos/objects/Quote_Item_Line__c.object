        <fullName>Total_Taxes_header_currency__c</fullName>
        <externalId>false</externalId>
        <formula>Total_Taxes_Form__c * Conversion_Rate_to_Currency_Header__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Taxes (header currency)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Volume_Item_m3__c</fullName>
        <description>Product of &quot;Units&quot; x ; if Item Name&apos;s &quot;Units x Master Box&quot; not 0 then Item Name&apos;s &quot;Master Box Volume (m3)&quot; /&quot;Units x Master Box&quot;, else 0</description>
        <externalId>false</externalId>
        <formula>(IF(Item_Name__r.Units_x_Master_Box__c&lt;&gt;0,(Item_Name__r.Master_Box_Volume_m3__c / Item_Name__r.Units_x_Master_Box__c),null))* Units__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>&quot;Units&quot; x (&quot;Master Box Volume (m3)&quot; / &quot;Units x Master Box&quot;)</inlineHelpText>
        <label>Total Volume Items (m3)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>4</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
