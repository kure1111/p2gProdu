    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>CP001MaterialPeligroso</fullName>
        <active>true</active>
        <description>Clave producto o servicio 1, pedir obligatorio Embalaje y Tipo de Material Peligroso</description>
        <errorConditionFormula>AND(
OR(CONTAINS( Import_Export_Quote__r.FolioResume__c ,&apos;FN&apos;),
CONTAINS( Import_Export_Quote__r.FolioResume__c ,&apos;FI&apos;),
CONTAINS( Import_Export_Quote__r.FolioResume__c ,&apos;PTO&apos;)),
Clave_de_Servicio__r.Material_PeligrosoCP__c = true,
OR(ISBLANK( Embalaje_Cat__c ),
ISBLANK( Material_Peligroso_Cat__c ))
)</errorConditionFormula>
        <errorDisplayField>Material_Peligroso_Cat__c</errorDisplayField>
        <errorMessage>ERROR CP-001, El producto o servicio requiere un material peligroso y embalaje</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CP002_Pedimento_y_Fraccion_Arancelaria</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
OR( Import_Export_Quote__r.FolioResume__c =&apos;FI&apos;,
   Import_Export_Quote__r.FolioResume__c =&apos;PT&apos;
),
OR(
ISBLANK( Pedimento__c),
ISBLANK( CP_Fraccion_Arancelaria_IE__c)
),
ISPICKVAL( Import_Export_Quote__r.Quotation_Status__c , &quot;Approved as Succesful&quot;) 
)</errorConditionFormula>
        <errorDisplayField>Pedimento__c</errorDisplayField>
        <errorMessage>ERROR CP002 : Favor de agregar Pedimento y Fracción Arancelaria</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Margin_at_Origin_or_Destination</fullName>
        <active>false</active>
        <errorConditionFormula>( BLANKVALUE( Margin__c , 0)&lt;&gt;0)  &amp;&amp; 
 ( BLANKVALUE( Margin_at_Destination__c , 0)&lt;&gt;0)</errorConditionFormula>
        <errorDisplayField>Margin_at_Destination__c</errorDisplayField>
        <errorMessage>There is already a Margin at Origin</errorMessage>
    </validationRules>
