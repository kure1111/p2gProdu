        <fullName>Total_Amount_Allocated_On_Disbursements__c</fullName>
        <externalId>false</externalId>
        <label>Total Amount Allocated On Disbursements</label>
        <summarizedField>Import_Export_Cargo_Line_Disbursement__c.Amount_Allocated_Cargo_Line_Currency__c</summarizedField>
        <summaryForeignKey>Import_Export_Cargo_Line_Disbursement__c.Import_Export_Cargo_Line__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Total_Amount_Disbursement_Currency_Hea__c</fullName>
        <externalId>false</externalId>
        <formula>Total_Amount_Allocated_On_Disbursements__c *  Conversion_Rate_to_Currency_Header__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Amount Disbursement (Currency Hea)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Destination_Amount__c</fullName>
        <description>Conversion to currency of (&quot;Amount&quot; + &quot;Imp-Exp Charges Assigned&quot; + &quot;Total Taxes&quot;) / &quot;Margin at Destination&quot;, from Destination Sell Amount Roll-Up</description>
        <externalId>false</externalId>
        <formula>(Amount__c +  Imp_Exp_Charges_Assigned_copy__c + Total_Taxes_Form__c)/(1- Margin_at_Destination__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>(&quot;Amount&quot; + &quot;Imp-Exp Charges Assigned&quot; + &quot;Total Taxes&quot;) / &quot;Margin at Destination&quot;</inlineHelpText>
        <label>Destination Sell Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Total_Shipping_Volume_m3__c</fullName>
        <externalId>false</externalId>
        <label>Total Shipping Volume (m3)</label>
        <precision>16</precision>
        <required>false</required>
        <scale>4</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Shipping_Weight_Kgs__c</fullName>
        <externalId>false</externalId>
        <label>Peso Bruto (KG)</label>
        <precision>14</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Taxes_Form__c</fullName>
        <description>Conversion to currency of &quot;Duty&quot; + &quot;Sales Tax&quot; + &quot;Additional Import Taxes Amount&quot;, from Total Taxes Roll-Up</description>
        <externalId>false</externalId>
        <formula>Duty__c + Sales_Tax__c + Additional_Import_Taxes_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>&quot;Duty&quot; + &quot;Sales Tax&quot; + &quot;Additional Import Taxes Amount&quot;</inlineHelpText>
        <label>Total Taxes</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
