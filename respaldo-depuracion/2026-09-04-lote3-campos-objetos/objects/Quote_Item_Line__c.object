    <fields>
        <fullName>Imp_Exp_Charges_Assigned_copy__c</fullName>
        <externalId>false</externalId>
        <label>Imp-Exp Charges Assigned (copy)</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Imp_Exp_Fees_assigned__c</fullName>
        <description>Conversion to currency of product between ratio of; if Quote&apos;s/Order&apos;s &quot;Total Volume (m3)&quot; not 0 then ratio of &quot;Total Shipping Volume (m3)&quot; to Quote&apos;s/Order&apos;s &quot;Total Volume (m3)&quot;, else if Quote/Order &quot;Total Weight (Kg)&quot; not 0 then ratio of &quot;Total Shipping Weight (Kg)&quot; to Quote&apos;s/Order&apos;s &quot;Total Weight (Kg)&quot;; and Quote&apos;s/Order&apos;s &quot;Total Sell Amount&quot; to &quot;Conversion Rate to Currency Header&quot; ratio.Roll-Up from Imp-Exp Charges Assigned</description>
        <externalId>false</externalId>
        <formula>IF(  Import_Export_Quote__r.Total_Volume_m3_2__c &lt;&gt;0, Total_Shipping_Volume_m3__c/ Import_Export_Quote__r.Total_Volume_m3_2__c ,IF(Import_Export_Quote__r.Total_Weight_Kg2__c&lt;&gt;0,Total_Shipping_Weight_Kgs__c / Import_Export_Quote__r.Total_Weight_Kg2__c,null) )* Import_Export_Quote__r.Total_Services_Sell_Amount_number__c / Conversion_Rate_to_Currency_Header__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Imp-Exp Charges Assigned</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Import_Export_Quote__c</fullName>
        <externalId>false</externalId>
        <label>Import-Export Quote</label>
        <referenceTo>Customer_Quote__c</referenceTo>
