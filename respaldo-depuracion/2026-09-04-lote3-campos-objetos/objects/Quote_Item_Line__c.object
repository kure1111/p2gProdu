        <fullName>Units__c</fullName>
        <externalId>false</externalId>
        <label>Units</label>
        <precision>8</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Weight_Kgs__c</fullName>
        <externalId>false</externalId>
        <formula>BLANKVALUE(Units__c  * BLANKVALUE( Item_Name__r.Master_Box_Gross_Weight_kg__c / Item_Name__r.Units_x_Master_Box__c , Item_Name__r.Weight_Kgs__c ),0)</formula>
        <inlineHelpText>&quot;Units&quot; x (&quot;Master Box Gross Weight (Kg)&quot;/&quot;Units x Master Box&quot;)</inlineHelpText>
        <label>Peso Bruto</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
