        <description>If Supplier Quote Line&apos;s &quot;Supplier Total Weight (kg)&quot; greater than 0 then Supplier Quote Line&apos;s &quot;Supplier Total Weight (kg)&quot;, else 0</description>
        <externalId>false</externalId>
        <formula>IF(Supplier_Quote_Line__r.Supplier_Total_Weight_kg__c &gt;0,Supplier_Quote_Line__r.Supplier_Total_Weight_kg__c ,0)</formula>
