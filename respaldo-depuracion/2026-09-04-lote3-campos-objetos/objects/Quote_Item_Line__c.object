    <fields>
        <fullName>Charges_Assig_Duty_Dest_Sell_Amount__c</fullName>
        <description>(&quot;Imp-Exp Fees&quot; + &quot;Duty&quot;) / &quot;Total Destination Amount&quot;</description>
        <externalId>false</externalId>
        <formula>( Imp_Exp_Fees_assigned__c + Duty__c ) / Total_Destination_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>(&quot;Imp-Exp Fees&quot; + &quot;Duty&quot;) / &quot;Total Destination Amount&quot;</inlineHelpText>
        <label>%(Charges Assig+Duty) / Dest Sell Amount</label>
        <precision>18</precision>
