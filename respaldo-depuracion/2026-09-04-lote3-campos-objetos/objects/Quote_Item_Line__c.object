    <fields>
        <fullName>Unit_Destination_Buy_Price__c</fullName>
        <description>Conversion to currency of (&quot;Amount&quot; + &quot;Imp-Exp Charges Assigned&quot; + &quot;Total Taxes&quot;) / &quot;Units&quot;</description>
        <externalId>false</externalId>
        <formula>(Amount__c + Imp_Exp_Charges_Assigned_copy__c + Total_Taxes_Form__c)/ Units__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
