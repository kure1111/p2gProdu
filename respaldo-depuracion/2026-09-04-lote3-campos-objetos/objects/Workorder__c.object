    <fields>
        <fullName>Pending_Units__c</fullName>
        <description>If &quot;Production Units&quot; greater than &quot;Valid Units&quot; then &quot;Production Units&quot; - &quot;Valid Units&quot;, else 0</description>
        <externalId>false</externalId>
        <formula>IF (Production_Units__c   &gt;   Valid_Units__c , Production_Units__c -   Valid_Units__c , 0 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>&quot;Production Units&quot; - &quot;Valid Units&quot;</inlineHelpText>
