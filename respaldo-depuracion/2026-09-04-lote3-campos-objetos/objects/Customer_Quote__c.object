    <fields>
        <fullName>Services_Margin__c</fullName>
        <description>If &quot;Total Services Sell Amount&quot; not equal to 0 then &quot;Services Std. Profit&quot; / &quot;Total Services Sell Amount&quot;, else blank</description>
        <externalId>false</externalId>
        <formula>IF(Total_Services_Sell_Amount_number__c!=0,Services_Profit__c / Total_Services_Order_Amount_number_IMP__c,null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>&quot;Services Std. Profit&quot; / &quot;Total Services Sell Amount&quot;</inlineHelpText>
        <label>Services Std. Margin</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Services_Profit__c</fullName>
        <description>Conversion to currency of &quot;Total Services Sell Amount&quot; - &quot;Total Services Std. Buy Amount&quot;, from Services Std. Profit Roll-Up</description>
        <externalId>false</externalId>
        <formula>Total_Services_Sell_Amount__c - Total_Services_Std_Buy_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>&quot;Total Services Sell Amount&quot; - &quot;Total Services Std. Buy Amount&quot;</inlineHelpText>
        <label>Services Std. Profit</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Services_Real_Margin__c</fullName>
        <description>If &quot;Total Services Invoiced Amount&quot; and &quot;Services Real Profit&quot; greater than 0 then &quot;Services Real Profit&quot;/&quot;Total Services Invoiced Amount&quot;, else &quot;Services Real Profit&quot;/&quot;Total Services Sell Amount&quot;. If &quot;Services Real Profit&quot; = 0 then Services Real Margin blank</description>
        <externalId>false</externalId>
        <formula>/*IF(NEUEBUSCM__Total_Services_Invoiced_Amount__c &gt; 0 &amp;&amp; NEUEBUSCM__Services_Real_Profit__c != null ,NEUEBUSCM__Services_Real_Profit__c/NEUEBUSCM__Total_Services_Invoiced_Amount__c,If(NEUEBUSCM__Services_Real_Profit__c != null, NEUEBUSCM__Services_Real_Profit__c/NEUEBUSCM__Total_Services_Sell_Amount__c,0))*/

IF(Total_Services_Invoiced_Amount__c &gt; 0 ,Services_Real_Profit__c/Total_Services_Invoiced_Amount__c,Services_Real_Profit__c/Total_Services_Sell_Amount__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>&quot;Services Real Profit&quot;/&quot;Total Services Sell Amount&quot;</inlineHelpText>
        <label>Services Real Margin</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Services_Real_Profit__c</fullName>
        <description>Conversion to currency of; if &quot;Total Services Invoiced Amount&quot; greater than 0 then &quot;Total Services Invoiced Amount&quot; - &quot;Total Disbursements Excl VAT&quot; or &quot;Total Shipments Services Buy Amount&quot; (depending if &quot;Total Disbursements Excl VAT&quot; greater than 0 or not respectively), else &quot;Total Services Sell Amount&quot; - &quot;Total Disbursements Excl VAT&quot; or &quot;Total Shipments Services Buy Amount&quot; (depending if &quot;Total Disbursements Excl VAT&quot; greater than 0 or not respectively)</description>
        <externalId>false</externalId>
        <formula>IF(Total_Services_Invoiced_Amount__c &gt; 0, Total_Services_Invoiced_Amount__c - IF(Total_Disbursements_Excl_VAT__c &gt; 0 , Total_Disbursements_Excl_VAT__c, Total_Shipments_Services_Buy_Amount__c), Total_Services_Sell_Amount__c - IF(Total_Disbursements_Excl_VAT__c &gt; 0 , Total_Disbursements_Excl_VAT__c ,Total_Shipments_Services_Buy_Amount__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>&quot;Total Services Sell Amount&quot; - &quot;Total Shipments Services Buy Amount&quot;</inlineHelpText>
        <label>Services Real Profit</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Servicio_text__c</fullName>
        <externalId>false</externalId>
        <formula>IF(LEFT( Name , 2)=&quot;A-&quot;,&quot;Aereo&quot;,
IF(LEFT( Name , 2)=&quot;AW&quot;,&quot;Aereo&quot;,
IF(LEFT( Name , 2)=&quot;ES&quot;,&quot;Paqueteria&quot;,
IF(LEFT( Name , 2)=&quot;EX&quot;,&quot;Seguro&quot;,
IF(LEFT( Name , 2)=&quot;FI&quot;,&quot;Fletes Internacional&quot;,
IF(LEFT( Name , 2)=&quot;FN&quot;,&quot;Fletes Nacional&quot;,
IF(LEFT( Name , 2)=&quot;FO&quot;,&quot;Fletes Nacional&quot;,
IF(LEFT( Name , 2)=&quot;FP&quot;,&quot;Fletes Nacional&quot;,
IF(LEFT( Name , 2)=&quot;M-&quot;,&quot;Maritimo&quot;,
IF(LEFT( Name , 2)=&quot;PQ&quot;,&quot;Paqueteria&quot;,
IF(LEFT( Name , 2)=&quot;PT&quot;,&quot;Puerto&quot;,
IF(LEFT( Name , 2)=&quot;R-&quot;,&quot;Maritimo&quot;,
IF(LEFT( Name , 2)=&quot;T-&quot;,&quot;Consolidado&quot;,
IF(LEFT( Name , 2)=&quot;W-&quot;,&quot;Maritimo&quot;,
IF(LEFT( Name , 2)=&quot;WH&quot;,&quot;Almacenaje&quot;,



&quot;LEFT( Name , 2)&quot;)))))))))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Servicio (text)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
