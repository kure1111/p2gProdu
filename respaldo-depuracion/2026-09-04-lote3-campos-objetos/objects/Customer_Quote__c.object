    </fields>
    <fields>
        <fullName>Zona_de_vendedor__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Workplace_Account_Location__c), &quot;None&quot;,

CASE(Workplace_Account_Location__c, &quot;MEX&quot;, &quot;Centro&quot;, &quot;PUE&quot;, &quot;Centro&quot;, &quot;VER&quot;, &quot;Centro&quot;, &quot;MXS&quot;, &quot;Centro&quot;, &quot;TOL&quot;, &quot;Centro&quot;, &quot;VRZ&quot;, &quot;Centro&quot;,

CASE(Workplace_Account_Location__c, &quot;MTY&quot;, &quot;Noreste&quot;, &quot;SAL&quot;, &quot;Noreste&quot;, &quot;TOR&quot;, &quot;Noreste&quot;, &quot;CORP&quot;, &quot;Noreste&quot;,

CASE(Workplace_Account_Location__c, &quot;LEO&quot;, &quot;Occidente&quot;, &quot;SLP&quot;, &quot;Occidente&quot;, &quot;QUE&quot;, &quot;Occidente&quot;, &quot;GDL&quot;, &quot;Occidente&quot;, &quot;QTO&quot;, &quot;Occidente&quot;,

CASE(Workplace_Account_Location__c, &quot;CUU&quot;, &quot;Noroeste&quot;, &quot;TIJ&quot;, &quot;Noroeste&quot;, &quot;MXI&quot;, &quot;Noroeste&quot;, &quot;JUA&quot;, &quot;Noroeste&quot;, &quot;HER&quot;, &quot;Noroeste&quot;,

CASE(Workplace_Account_Location__c, &quot;Global&quot;, &quot;Globales&quot;,

CASE(Workplace_Account_Location__c, &quot;CCN&quot;,&quot;Cuentas Clave Noreste&quot;,

CASE(Workplace_Account_Location__c, &quot;CCC&quot;, &quot;Cuentas Clave Centro&quot;,

CASE(Workplace_Account_Location__c, &quot;CCO&quot;, &quot;Cuentas Clave OCCIDENTE&quot;,

&quot;Otro&quot;)))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Zona de vendedor</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
