    <fields>
        <fullName>Gasto_Operativo_Prod1__c</fullName>
        <externalId>false</externalId>
        <formula>IF( FolioResume__c = &quot;FN&quot;,
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 972,1087),
IF( FolioResume__c = &quot;FI&quot;&amp;&amp; ISPICKVAL(Service_Type__c,&quot;FTL&quot;),
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 805,701),
IF( FolioResume__c = &quot;FI&quot;&amp;&amp; ISPICKVAL(Service_Type__c,&quot;LTL&quot;),
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 823,810),
IF( FolioResume__c = &quot;A-&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;CARGA&quot;) ,
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;) , 1831,2423),
IF( FolioResume__c = &quot;A-&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;PAQUETERIA&quot;) ,
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;) , 768,804),
IF( FolioResume__c = &quot;M-&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;FCL&quot;),
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 1689,2741),
IF( FolioResume__c = &quot;M-&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;LCL&quot;),
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 483,3196),
IF( FolioResume__c = &quot;PT&quot; ,
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 1353,1174),
NULL)
)))))))</formula>
        <label>Gasto Operativo productos 1</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Gasto_Operativo_Prod2__c</fullName>
        <externalId>false</externalId>
        <formula>IF( FolioResume__c = &quot;R-&quot;,
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 749,719),
IF( FolioResume__c = &quot;W-&quot;,
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;),2620,2507),
IF( FolioResume__c = &quot;AW&quot;,
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;),2560,3754),
NULL)
))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
