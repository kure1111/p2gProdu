    </fields>
    <fields>
        <fullName>Time_Response_Hrs__c</fullName>
        <externalId>false</externalId>
        <formula>ROUND( 9 * (
   ( 5 * FLOOR( ( DATEVALUE( Date_Pricing_responded__c ) - DATE( 1900, 1, 8) ) / 7) +
    MIN(5, 
     MOD( DATEVALUE( Date_Pricing_responded__c ) - DATE( 1900, 1, 8), 7) +
     MIN( 1, 24 / 9 * ( MOD( Date_Pricing_responded__c - DATETIMEVALUE( &apos;1900-01-08 14:00:00&apos; ), 1 ) ) )
    ) 
   )
 -
   ( 5 * FLOOR( ( DATEVALUE( Date_Send_Request__c ) - DATE( 1900, 1, 8) ) / 7) +
     MIN( 5,
      MOD( DATEVALUE(Date_Send_Request__c ) - DATE( 1996, 1, 1), 7 ) +
      MIN( 1, 24 / 10 * ( MOD(Date_Send_Request__c - DATETIMEVALUE( &apos;1900-01-08 14:00:00&apos; ), 1) ) )
    )
   ) 
  ), 
MOD((Date_Pricing_responded__c - DATETIMEVALUE(&apos;2017-01-02 14:00:00&apos;))*1440,1440)/60)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Time Response (Hrs)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
