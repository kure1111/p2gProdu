IF( CreatedBy.UserRole.Name  = &quot;GERENTE SC TERRESTRE NACIONAL&quot;, &quot;CUSTOMER SERVICE&quot;,
IF( CreatedBy.UserRole.Name  = &quot;SC INTERNACIONAL&quot;,&quot;CUSTOMER SERVICE&quot;,
IF( CreatedBy.UserRole.Name  = &quot;GERENTE SC INTERNACIONAL&quot;,&quot;CUSTOMER SERVICE&quot;,
IF( CreatedBy.UserRole.Name  = &quot;SC PAQUETERIA&quot;,&quot;CUSTOMER SERVICE&quot;, &quot;COMMERCIAL&quot;)))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
