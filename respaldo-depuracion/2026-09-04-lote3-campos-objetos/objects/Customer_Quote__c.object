    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>AW_Margen_Operativo</fullName>
        <active>true</active>
        <errorConditionFormula>IF ( Account_for__r.Order_to_Cash__c = False,
AND(
FolioResume__c = &quot;AW&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;) , Margen_Operativo__c &lt; $User.AW_Margen_Operativo__c ),
NULL)</errorConditionFormula>
        <errorMessage>MARGEN OPERATIVO ES MENOR A TU LIMITE DE AUTORIZACIÓN PARA FOLIO &quot;AW&quot; 
*Favor de Contactar a la Gerencia o Dirección de Ventas.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>A_Margen_Operativo</fullName>
        <active>true</active>
        <errorConditionFormula>IF ( Account_for__r.Order_to_Cash__c = false,
AND(
FolioResume__c = &quot;A&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;) , Margen_Operativo__c &lt; $User.A_Marg_Op__c ),
NULL)</errorConditionFormula>
        <errorMessage>MARGEN OPERATIVO ES MENOR A TU LIMITE DE AUTORIZACIÓN PARA FOLIO &quot;A&quot; 
*Favor de Contactar a la Gerencia o Dirección de Ventas.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Addresses_Destination</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
FolioResume__c = &quot;FN&quot; ||
FolioResume__c = &quot;FI&quot; ||
FolioResume__c = &quot;PT&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;),
ISNULL(Account_Destination_Address__c)
)</errorConditionFormula>
        <errorDisplayField>Account_Destination_Address__c</errorDisplayField>
        <errorMessage>Seleccionar Account Destination Address</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Addresses_Origin</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
FolioResume__c = &quot;FN&quot; ||
FolioResume__c = &quot;FI&quot; ||
FolioResume__c = &quot;PT&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;),
ISNULL(Account_Origin_Address__c)
)</errorConditionFormula>
        <errorDisplayField>Account_Origin_Address__c</errorDisplayField>
        <errorMessage>Seleccionar Account Origin Address</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CP001_Clave_de_Unidad_de_Peso</fullName>
        <active>false</active>
        <description>Obligatorio para servicios FN FI PTO</description>
        <errorConditionFormula>AND
(
OR ( FolioResume__c = &quot;FN&quot;,
 FolioResume__c = &quot;FI&quot;,
 FolioResume__c = &quot;PT&quot;
),
( Clave_de_Unidad_de_Peso__c  =  &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Clave_de_Unidad_de_Peso__c</errorDisplayField>
        <errorMessage>CP001: Error  CLAVE DE UNIDAD DE PESO 
(Debes de capturar la clave de unidad de peso)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CambioCliente</fullName>
        <active>true</active>
        <errorConditionFormula>AND( PRIORVALUE(Account_for__c)   &lt;&gt;  Account_for__c,
 OR(ISPICKVAL( Quotation_Status__c , &apos;Approved as Succesful&apos;),ISPICKVAL( Quotation_Status__c , &apos;Shipped&apos;)))</errorConditionFormula>
        <errorDisplayField>Requiere_Seguro__c</errorDisplayField>
        <errorMessage>ERROR: No puedes cambar el Cliente cuando la cotizacion esta en estatus &quot;Approved as Succesful&quot; y estatus &quot;Shipped&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Comercio_Exterior_Obligatorio001</fullName>
        <active>true</active>
        <description>CE-001 Para Folios CE se requiere agregar Tipo de Servicio, Padron Impak, Sales Incoterm</description>
        <errorConditionFormula>AND(
FolioResume__c = &quot;CE&quot;,
ISPICKVAL(Comercio_Exterior__c, &quot;Si&quot;),
ISPICKVAL(CE_Tipodeservicio_IMPAK__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>CE_Tipodeservicio_IMPAK__c</errorDisplayField>
        <errorMessage>CE-001 Para Folios CE se requiere agregar Tipo de Servicio</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Comercio_Exterior_Obligatorio002</fullName>
        <active>true</active>
        <description>CE-002 Para Folios CE se requiere agregar Padron Impak</description>
        <errorConditionFormula>AND(
FolioResume__c = &quot;CE&quot;,
ISPICKVAL(Comercio_Exterior__c, &quot;Si&quot;),
ISPICKVAL(IMPAK__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>IMPAK__c</errorDisplayField>
        <errorMessage>CE-002 Para Folios CE se requiere agregar Padron Impak</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Comercio_Exterior_Obligatorio003</fullName>
        <active>true</active>
        <description>CE-003 Para Folios CE se requiere agregar Sales Incoterm</description>
        <errorConditionFormula>AND(
FolioResume__c = &quot;CE&quot;,
ISPICKVAL(Comercio_Exterior__c, &quot;Si&quot;),
ISPICKVAL(Sales_Incoterm__c, &quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>Sales_Incoterm__c</errorDisplayField>
        <errorMessage>CE-003 Para Folios CE se requiere agregar Sales Incoterm</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CoordenadasNoPuedenSer0</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
FolioResume__c = &quot;FN&quot; ||
FolioResume__c = &quot;FI&quot; ||
FolioResume__c = &quot;PT&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;),
ISNULL( Origin_Location__Latitude__s ),
ISNULL( Origin_Location__Longitude__s ),
ISNULL(  Destination_Location__Latitude__s  ),
ISNULL(  Destination_Location__Longitude__s  )
)</errorConditionFormula>
        <errorMessage>Los campos de origin location y destination location no pueden estar vacíos.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_Reference_Validation</fullName>
        <active>true</active>
        <description>Regla de validación que se ejecuta cuando el comercial agrega un valor no alfanumérico en el campo Customer Reference.</description>
        <errorConditionFormula>AND(
NOT(REGEX(Customer_Reference__c, &quot;^[a-zA-Z0-9 ]*$&quot;)),
$User.Id &lt;&gt; &apos;0054T000001iQkX&apos;
)</errorConditionFormula>
        <errorDisplayField>Customer_Reference__c</errorDisplayField>
        <errorMessage>El campo Customer Reference no puede tener caracteres especiales. Solo incluir números y letras.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Declined_bloq_register</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL(PRIORVALUE( Quotation_Status__c ),&quot;Quote Declined&quot;),
NOT($Profile.Id = &quot;0050Y000002l7VJ&quot;),
NOT($Profile.Name = &apos;CUSTOMER COMMUNITY&apos;)
)</errorConditionFormula>
        <errorDisplayField>Requiere_Seguro__c</errorDisplayField>
        <errorMessage>ERROR!  You Can´t Modify, Status is Declined</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DestinationLocationMustNotBeEmpty</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
FolioResume__c = &quot;FN&quot; ||
FolioResume__c = &quot;FI&quot; ||
FolioResume__c = &quot;PT&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;),
ISNULL(  Destination_Location__Latitude__s  ),
ISNULL(  Destination_Location__Longitude__s  )
)</errorConditionFormula>
        <errorMessage>No puede estar vacío los campos de Destination Location, Longitud y Latitud</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FI_LTL_Margen_Operativo</fullName>
        <active>true</active>
        <errorConditionFormula>AND  (Account_for__r.Order_to_Cash__c = False,
FolioResume__c = &quot;FI&quot;,
ISPICKVAL(Service_Type__c,&apos;LTL&apos;),
ISPICKVAL( Quotation_Status__c , &apos;Approved as Succesful&apos;) , Margen_Operativo__c &lt;  $User.FI_LTL_Margen_Operativo__c 
)</errorConditionFormula>
        <errorMessage>MARGEN OPERATIVO ES MENOR A TU LIMITE DE AUTORIZACIÓN PARA FOLIO &quot;FI-LTL&quot; 
*Favor de Contactar a la Gerencia o Dirección de Ventas.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FI_Margen_Operativo</fullName>
        <active>true</active>
        <errorConditionFormula>IF ( Account_for__r.Order_to_Cash__c = False,
AND( FolioResume__c = &quot;FI&quot;,
NOT( ISPICKVAL(Service_Type__c, &apos;LTL&apos;)), 
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;) , Margen_Operativo__c &lt; $User.FI_Marg_Op__c ),
NULL)</errorConditionFormula>
        <errorMessage>MARGEN OPERATIVO ES MENOR A TU LIMITE DE AUTORIZACIÓN PARA FOLIO &quot;FI&quot; 
*Favor de Contactar a la Gerencia o Dirección de Ventas.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FN_Addresses</fullName>
        <active>false</active>
        <errorConditionFormula>AND( 
FolioResume__c = &quot;FN&quot; || 
FolioResume__c = &quot;FI&quot; ||
FolioResume__c = &quot;PT&quot;, 
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;),
 Account_Origin_Address__r.Address__c = &quot;&quot;
)</errorConditionFormula>
        <errorMessage>El campo de Account Origin Address, no puede estar vacío.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FN_Margen_Operativo</fullName>
        <active>false</active>
        <errorConditionFormula>IF ( Account_for__r.Order_to_Cash__c = false,
AND(
FolioResume__c = &quot;FN&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;) , Margen_Operativo__c &lt; $User.FN_Marg_Op__c ),
NULL)</errorConditionFormula>
        <errorMessage>MARGEN OPERATIVO ES MENOR A TU LIMITE DE AUTORIZACIÓN PARA &quot;FN&quot; 
*Favor de Contactar a la Gerencia o Dirección de Ventas</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IMP001_Folio_con_SP_en_Confirmed</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
TEXT(Last_Shipment__r.Shipment_Status_Plann__c)=&apos;Confirmed&apos;,
OR(
NOT(ISCHANGED(Site_of_Load__c )),
NOT(ISCHANGED(Site_of_Discharge__c)),
NOT(ISCHANGED(Origin_Location__c)),
NOT(ISCHANGED(Destination_Location__c))
)
)</errorConditionFormula>
        <errorMessage>IMP001 - No es posible editar los campos de &quot;site of load&quot;, &quot;site of discharge&quot;, &quot;Origin Location&quot; o &quot;Destination Location&quot; una vez que el Shipment relacionado esta en Confirmed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Import_Export_Service_Type_Control</fullName>
        <active>false</active>
        <description>Import-Export Service Type Control</description>
        <errorConditionFormula>OR(
AND(TEXT(Freight_Mode__c) == &apos;Road&apos;, OR(TEXT(Service_Mode__c) == &apos;IMPORT&apos;, TEXT(Service_Mode__c) == &apos;EXPORT&apos;, TEXT(Service_Mode__c) == &apos;PORT&apos;), OR(TEXT(Service_Type__c) == &apos;TARIMAS&apos;, TEXT(Service_Type__c) == &apos;FP&apos;, TEXT(Service_Type__c) == &apos;FO&apos;, TEXT(Service_Type__c) == &apos;MAYOREO&apos;))
,
AND(TEXT(Freight_Mode__c) == &apos;Air&apos;, OR(
AND(TEXT(Service_Mode__c) == &apos;IMPORT&apos;, TEXT(Service_Type__c) == &apos;ENVIO NACIONAL&apos;), 
AND(TEXT(Service_Mode__c) == &apos;NATIONAL&apos;, OR(TEXT(Service_Type__c) == &apos;PAQUETERIA&apos;, TEXT(Service_Type__c) == &apos;CARGA&apos;)), 
AND(TEXT(Service_Mode__c) == &apos;EXPORT&apos;, TEXT(Service_Type__c) == &apos;ENVIO NACIONAL&apos;) 
))
)</errorConditionFormula>
        <errorDisplayField>Service_Type__c</errorDisplayField>
        <errorMessage>This Service Type is not compatible with the current Service Mode</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Invalid_AccountOwner</fullName>
        <active>true</active>
        <description>Verifica que el Account Owner del Account for, no pertenezca al usuario &quot;Actualización Sistemas 2021&quot;</description>
        <errorConditionFormula>ISPICKVAL(Quotation_Status__c, &quot;Approved as Succesful&quot;) &amp;&amp;
Account_for__r.Owner.Id = &quot;0054T000000ZZQ3&quot;</errorConditionFormula>
        <errorDisplayField>Quotation_Status__c</errorDisplayField>
        <errorMessage>AO-001 ERROR: Se requiere asignar la cuenta a un usuario con perfil comercial. Esta cuenta pertenece a &quot;Actualización Sistemas 2021&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>M_Margen_Operativo</fullName>
        <active>true</active>
        <errorConditionFormula>IF ( Account_for__r.Order_to_Cash__c = false,
AND(
FolioResume__c = &quot;M&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;) , Margen_Operativo__c &lt; $User.M_Marg_Op__c ),
NULL)</errorConditionFormula>
        <errorMessage>MARGEN OPERATIVO ES MENOR A TU LIMITE DE AUTORIZACION PARA FOLIO &quot;M&quot; 
*Favor de Contactar a la Gerencia o Dirección de Ventas.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoAprobarClienteCotizador</fullName>
        <active>true</active>
        <description>Evitar que el folio se apruebe si el campo Account for (Customer) tiene asignado al cliente Cotizador</description>
        <errorConditionFormula>AND(
ISCHANGED( Quotation_Status__c ),
ISPICKVAL( Quotation_Status__c, &apos;Approved as Succesful&apos;),
Account_for__r.Id = &apos;0014T00000EIt8A&apos;
)</errorConditionFormula>
        <errorDisplayField>Account_for__c</errorDisplayField>
        <errorMessage>NACC-001: Para aprobar el folio, el campo Acount for (Customer) no debe ser &quot;Cotizador&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoDeclinarFolio</fullName>
        <active>true</active>
        <description>La regla evita que el folio se decline utilizando el picklist Quotation Status. Forzosamente se va pedir utilizar el botón Declined.</description>
        <errorConditionFormula>AND(
 ISPICKVAL( Quotation_Status__c, &apos;Quote Declined&apos;),
 Folio_Declinado__c = False
)</errorConditionFormula>
        <errorDisplayField>Quotation_Status__c</errorDisplayField>
        <errorMessage>FD-001: Para declinar el folio, utilizar el botón &quot;Declined&quot; ubicado en la parte superior.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoReabrirFolio</fullName>
        <active>true</active>
        <description>La regla evita que el folio se re-abra utilizando el picklist Quotation Status una vez que ya ha sido declinado</description>
        <errorConditionFormula>AND(
 OR(
    ISPICKVAL( Quotation_Status__c, &apos;Quote being prepared&apos;),
    ISPICKVAL( Quotation_Status__c, &apos;Awaiting costs suppliers&apos;),
    ISPICKVAL( Quotation_Status__c, &apos;Sent awaiting response&apos;),
    ISPICKVAL( Quotation_Status__c, &apos;Approved as Succesful&apos;)
 ),
 Folio_Declinado__c = True
)</errorConditionFormula>
        <errorDisplayField>Quotation_Status__c</errorDisplayField>
        <errorMessage>FD-002: No es posible re-abrir el folio una vez ha sido pasado al estatus &quot;Quote Declined&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Obligatorio_FECHA_ESPERADA</fullName>
        <active>true</active>
        <description>No permite guardar o modificar el campo &apos;Declined for&apos; con el valor INTINERARIOS, si el campo &apos;¿Qué fecha esperaba el cliente?&apos; no está completado.</description>
        <errorConditionFormula>AND( ISPICKVAL( Declined_for2__c , &apos;INTINERARIOS&apos;),
ISNULL( Que_fecha_esperaba_el_cliente__c )
)</errorConditionFormula>
        <errorDisplayField>Que_fecha_esperaba_el_cliente__c</errorDisplayField>
        <errorMessage>ERROR DF-002: Colocar la fecha esperada por el cliente</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Obligatorio_TARIFA_ESPERADA</fullName>
        <active>true</active>
        <description>No permite guardar o modificar el campo &apos;Declined for&apos; si el campo &apos;¿Qué tarifa esperaba el cliente&apos; no está completado.</description>
        <errorConditionFormula>AND( ISPICKVAL( Declined_for2__c , &apos;TARIFA ALTA&apos;),
ISNULL( Que_tarifa_esperaba_el_cliente__c )
)</errorConditionFormula>
        <errorDisplayField>Que_tarifa_esperaba_el_cliente__c</errorDisplayField>
        <errorMessage>ERROR DF-001: Colocar la tarifa esperada por el cliente</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Only_Warehouse_Service_Freight_Mode</fullName>
        <active>true</active>
        <description>Freight Mode is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</description>
        <errorConditionFormula>AND(Only_Warehouse_Service__c == false, ISBLANK(TEXT(Freight_Mode__c)))</errorConditionFormula>
        <errorDisplayField>Freight_Mode__c</errorDisplayField>
        <errorMessage>Freight Mode is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Only_Warehouse_Service_Service_Mode</fullName>
        <active>true</active>
        <description>Service Mode is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</description>
        <errorConditionFormula>AND(Only_Warehouse_Service__c == false, ISBLANK(TEXT(Service_Mode__c)))</errorConditionFormula>
        <errorDisplayField>Service_Mode__c</errorDisplayField>
        <errorMessage>Service Mode is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Only_Warehouse_Service_Service_Type</fullName>
        <active>true</active>
        <description>Service Type is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</description>
        <errorConditionFormula>AND(Only_Warehouse_Service__c == false, ISBLANK(TEXT(Service_Type__c)))</errorConditionFormula>
        <errorDisplayField>Service_Type__c</errorDisplayField>
        <errorMessage>Service Type is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Order_Amount_debe_ser_mayor_a_0</fullName>
        <active>false</active>
        <description>El campo Total Services Order Amount debe ser mayor a 0 para crear los SP Automaticos cuando el status sea approval</description>
        <errorConditionFormula>IF(Total_Services_Sell_Amount__c &lt;=0 &amp;&amp; TEXT(Quotation_Status__c) = &apos;Approved as Succesful&apos; ,true,false)</errorConditionFormula>
        <errorMessage>El campo Total Services Order Amount debe ser mayor a 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OriginLocationMustNotBeEmpty</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
FolioResume__c = &quot;FN&quot; ||
FolioResume__c = &quot;FI&quot; ||
FolioResume__c = &quot;PT&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;),
ISNULL( Origin_Location__Latitude__s ),
ISNULL( Origin_Location__Longitude__s )
)</errorConditionFormula>
        <errorMessage>No puede estar vacío los campos de Origin Location, Longitud y Latitud</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PTO_Margen_Operativo</fullName>
        <active>true</active>
        <errorConditionFormula>IF ( Account_for__r.Order_to_Cash__c = false,
AND( FolioResume__c = &quot;PTO&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;) , Margen_Operativo__c &lt; $User.PTO_Margen_Operativo__c ),
NULL)</errorConditionFormula>
        <errorMessage>MARGEN OPERATIVO ES MENOR A TU LIMITE DE AUTORIZACIÓN PARA &quot;PTO&quot; 
*Favor de Contactar a la Gerencia o Dirección de Ventas</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>R_Margen_Operativo</fullName>
        <active>true</active>
        <errorConditionFormula>IF ( Account_for__r.Order_to_Cash__c = false,
AND( FolioResume__c = &quot;R&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;) , Margen_Operativo__c &lt; $User.R_Margen_Operativo__c),
NULL)</errorConditionFormula>
        <errorMessage>MARGEN OPERATIVO ES MENOR A TU LIMITE DE AUTORIZACIÓN PARA FOLIO &quot;R&quot; 
*Favor de Contactar a la Gerencia o Dirección de Ventas.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>State_of_Discharge</fullName>
        <active>true</active>
        <errorConditionFormula>((Country_ofDischarge__r.Name == &apos;United States&apos; || Country_ofDischarge__r.Name == &apos;Mexico&apos;) &amp;&amp;  ISBLANK(State_of_Discharge__c))</errorConditionFormula>
        <errorDisplayField>State_of_Discharge__c</errorDisplayField>
        <errorMessage>State is required for this Country</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>State_of_Load</fullName>
        <active>true</active>
        <errorConditionFormula>((Country_ofLoad__r.Name == &apos;United States&apos; || Country_ofLoad__r.Name == &apos;Mexico&apos;) &amp;&amp; ISBLANK(State_of_Load__c))</errorConditionFormula>
        <errorDisplayField>State_of_Load__c</errorDisplayField>
        <errorMessage>State is required for this Country</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VALIDATION_BUY_AMOUNT_0</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL( Quotation_Status__c ,&quot;Approved as Succesful&quot;),  Total_Services_Std_Buy_Amount__c = 0,  Account_for__r.Order_to_Cash__c = FALSE, 
OR(
FolioResume__c = &quot;FN&quot;,
FolioResume__c = &quot;A&quot;
)
)</errorConditionFormula>
        <errorMessage>Total Services Std. Buy Amount debe ser mayor a 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validacion_de_Credito_new_approved</fullName>
        <active>true</active>
        <description>Valida el credito disponible antes de crear o aprobar un folio</description>
        <errorConditionFormula>AND(
ISPICKVAL( Account_for__r.Venta_Sap__c  , &quot;Credito&quot;),
Account_for__r.Saldo_DisponibleOK__c &lt;= 0,
OR
(
ISNEW(),
ISPICKVAL(  Quotation_Status__c   , &quot;Approved as Succesful&quot;)

)


)</errorConditionFormula>
        <errorMessage>[VCNA] Cliente con crédito insuficiente</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validacion_de_Credito_para_approved</fullName>
        <active>true</active>
        <description>Valida el credito disponible antes de aprobar un folio</description>
        <errorConditionFormula>AND(
ISPICKVAL( Account_for__r.Venta_Sap__c  , &quot;Credito&quot;),
Account_for__r.Saldo_DisponibleOK__c &gt; 0,
ISPICKVAL(  Quotation_Status__c   , &quot;Approved as Succesful&quot;),
 Total_Services_Sell_Amount__c &gt;Account_for__r.Saldo_DisponibleOK__c,
  ISCHANGED( Quotation_Status__c)
)</errorConditionFormula>
        <errorMessage>[VCA] Cliente con crédito insuficiente</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Approved</fullName>
        <active>false</active>
        <errorConditionFormula>ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;)&amp;&amp;
 AUTORIZADO_FP_FO__c = True</errorConditionFormula>
        <errorMessage>ERROR: No se puede realizar la siguiente accion: Modify, Duplicate, Delete</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Approved_Customer_no_Prospect</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL( Quotation_Status__c, &quot;Approved as Succesful&quot;) &amp;&amp;
 Account_for__r.RecordType.DeveloperName  &lt;&gt; &quot;Customer&quot;</errorConditionFormula>
        <errorMessage>ERROR:
No se puede Aprobar si es un &quot;Prospecto&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Approved_PurchaseOrder</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
 Account_for__r.Owner.Workplace__c = &quot;GDL&quot;||Account_for__r.Owner.Workplace__c = &quot;LEO&quot;||
Account_for__r.Owner.Workplace__c = &quot;QUE&quot;||
Account_for__r.Owner.Workplace__c = &quot;SLP&quot;||
Account_for__r.Owner.Workplace__c = &quot;CUU&quot;|| Account_for__r.Owner.Workplace__c = &quot;MTY&quot;||
Account_for__r.Owner.Workplace__c = &quot;MEX&quot;||
Account_for__r.Owner.Workplace__c = &quot;MXS&quot;||
Account_for__r.Owner.Workplace__c = &quot;SLP&quot;,
ISPICKVAL(Quotation_Status__c,&quot;Approved as Succesful&quot;)  &amp;&amp;   Account_for__r.Requiere_Orden_de_Compra__c = True &amp;&amp; 
 Account_for__r.Order_to_Cash__c = False &amp;&amp;
 Purchase_OrderNum__c = NULL,NULL)</errorConditionFormula>
        <errorDisplayField>Account_for__c</errorDisplayField>
        <errorMessage>ERROR: &quot;CUSTOMER&quot; Required Purchase Order
Please contact Administrative team
(Para este Cliente se Requiere de Orden de Compra)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Approved_With_Shipper</fullName>
        <active>true</active>
        <description>If Folio = M- &amp;&amp; Status =Approved &amp;&amp; is blank Shipper</description>
        <errorConditionFormula>AND(FolioResume__c = &quot;M&quot;, ISPICKVAL(Quotation_Status__c,&quot;Approved as Succesful&quot;), Supplier_Account__c = null)</errorConditionFormula>
        <errorMessage>ERROR: La Cotizacion no puede ser Aprobada sin elegir al Shipper o Conginee</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Approved_Without_Cargo_Lines</fullName>
        <active>false</active>
        <errorConditionFormula>ISPICKVAL( Quotation_Status__c, &quot;Approved as Succesful&quot;) &amp;&amp; 
Total_Items_Units__c = 0</errorConditionFormula>
        <errorMessage>!!ERROR: Must be Contain &quot;CARGO LINES&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Approved_with_Consignee</fullName>
        <active>true</active>
        <description>If Folio = M- &amp;&amp; Status =Approved &amp;&amp; is blank Consignee</description>
        <errorConditionFormula>AND(FolioResume__c = &quot;M&quot;, ISPICKVAL(Quotation_Status__c,&quot;Approved as Succesful&quot;),   Consignee__c   = null)</errorConditionFormula>
        <errorMessage>ERROR: La Cotizacion no puede ser Aprobada sin elegir al Shipper o Conginee</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Awaiting_Load_Time</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL( Quotation_Status__c,&quot;Awaiting costs suppliers&quot;) &amp;&amp; 
ISPICKVAL(Freight_Mode__c, &quot;ROAD&quot;) &amp;&amp;   
ISPICKVAL(Service_Mode__c, &quot;NATIONAL&quot;)  &amp;&amp; 
ISPICKVAL(Service_Type__c, &quot;FTL&quot;) &amp;&amp;
  ISBLANK(Awaiting_load_time__c)=TRUE &amp;&amp;
NOT($Profile.Name = &apos;CUSTOMER COMMUNITY&apos;)</errorConditionFormula>
        <errorMessage>ERROR: MUST BE DEFINE AWAITING LOAD TIME</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Awaiting_Unload_Time</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL( Quotation_Status__c,&quot;Awaiting costs suppliers&quot;) &amp;&amp; 
ISPICKVAL(Freight_Mode__c, &quot;ROAD&quot;) &amp;&amp;   
ISPICKVAL(Service_Mode__c, &quot;NATIONAL&quot;)  &amp;&amp; 
ISPICKVAL(Service_Type__c, &quot;FTL&quot;) &amp;&amp;
  ISBLANK( Awaiting_unload_time__c )=TRUE &amp;&amp;
NOT($Profile.Name = &apos;CUSTOMER COMMUNITY&apos;)</errorConditionFormula>
        <errorMessage>ERROR: MUST BE DEFINE AWAITING UNLOAD TIME</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Awaiting_Without_Cargo_Lines</fullName>
        <active>false</active>
        <description>Sin cargo lines</description>
        <errorConditionFormula>ISPICKVAL( Quotation_Status__c, &quot;Awaiting costs suppliers&quot;) &amp;&amp; 
 Total_Items_Units__c = 0 &amp;&amp;
 Total_Weight_Kg2__c = 0 &amp;&amp;
 Impak_Request__c = False</errorConditionFormula>
        <errorDisplayField>Quotation_Status__c</errorDisplayField>
        <errorMessage>!!ERROR: Capturar &quot;CARGO LINES&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Border</fullName>
        <active>true</active>
        <errorConditionFormula>AND(Impak_Request__c = False, 
 OR(FolioResume__c = &quot;FI&quot;,FolioResume__c = &quot;CE&quot;),  
   NOT(ISPICKVAL(TIPO_DE_SERVICIO__c,&quot;Domestico&quot;)), 
    ISPICKVAL(Border__c,&quot;&quot;))</errorConditionFormula>
        <errorDisplayField>Border__c</errorDisplayField>
        <errorMessage>ERROR: Para FI&apos;s y CE debes elegir la Aduana de Cruce (Campo &quot;Border&quot; y &quot;Customs&quot;)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Customs</fullName>
        <active>true</active>
        <errorConditionFormula>AND(Impak_Request__c = False, FolioResume__c = &quot;FI&quot;,
  NOT(ISPICKVAL(TIPO_DE_SERVICIO__c,&quot;Domestico&quot;)), 
   ISPICKVAL( Customs__c ,&quot;&quot;))</errorConditionFormula>
        <errorDisplayField>Customs__c</errorDisplayField>
        <errorMessage>ERROR: Para FI&apos;s y CE debes elegir la Aduana de Cruce (Campo &quot;Border&quot; y &quot;Customs&quot;)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Declined_with_reasons</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(Quotation_Status__c,&quot;Quote Declined&quot;) &amp;&amp;
  ISPICKVAL( Declined_for2__c ,&quot;&quot;) &amp;&amp;
NOT($Profile.Name = &apos;CUSTOMER COMMUNITY&apos;)</errorConditionFormula>
        <errorDisplayField>Declined_for2__c</errorDisplayField>
        <errorMessage>ERROR: Must be specified reassons for declined Quote</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_FN_with_Destination_Address</fullName>
        <active>false</active>
        <errorConditionFormula>ISPICKVAL(Quotation_Status__c,&quot;Approved as Succesful&quot;) &amp;&amp; FolioResume__c = &quot;FN&quot; &amp;&amp; Destination_Address__c = &quot;&quot;</errorConditionFormula>
        <errorDisplayField>Destination_Address__c</errorDisplayField>
        <errorMessage>ERROR: Debe capturar Direcciones de Recoleccion y Entrega</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_FN_with_Origin_Address</fullName>
        <active>false</active>
        <errorConditionFormula>ISPICKVAL(Quotation_Status__c,&quot;Approved as Succesful&quot;)  &amp;&amp; FolioResume__c = &quot;FN&quot; &amp;&amp;  Origin_Address__c = &quot;&quot;</errorConditionFormula>
        <errorDisplayField>Origin_Address__c</errorDisplayField>
        <errorMessage>ERROR: Debe capturar Direcciones de Recoleccion y Entrega</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Merch_value</fullName>
        <active>false</active>
        <errorConditionFormula>AND( Merch_Value__c =NULL, 
ISPICKVAL( Merchandise_Insurance__c,&quot;Seguro AON&quot;)||
 ISPICKVAL( Merchandise_Insurance__c,&quot;Seguro Paqueteria&quot;)||
 ISPICKVAL( Merchandise_Insurance__c,&quot;Seguro Consolidado&quot;))</errorConditionFormula>
        <errorDisplayField>Merch_Value__c</errorDisplayField>
        <errorMessage>Si requiere Seguro favor de Capturar el Valor de la Mercancia (Merchandise value)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Quotation_Status</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
$Profile.Name = &quot;PAK2GO FN-PLANNER PILOTO SF Lightning&quot;,
 Last_Shipment__c = &quot;&quot;, 
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;)|| ISPICKVAL( Quotation_Status__c , &quot;Shipped&quot;))</errorConditionFormula>
        <errorMessage>No tiene permiso para Aprobar este Folio!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Response_with_Pricing_Exec</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(Quotation_Status__c,&quot;Sent awaiting response&quot;) &amp;&amp;  Pricing_Executive__c  = &quot;&quot; &amp;&amp;
NOT($Profile.Name = &apos;CUSTOMER COMMUNITY&apos;)</errorConditionFormula>
        <errorDisplayField>Pricing_Executive__c</errorDisplayField>
        <errorMessage>ERROR: Mulst be choose PRICING EXECUTIVE</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Seguro_NO</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(  Merchandise_Insurance__c  ,&quot;NO REQUIERE&quot;) &amp;&amp;  Motivo__c  = &quot;&quot; &amp;&amp; NOT($Profile.Name = &apos;CUSTOMER COMMUNITY&apos;)</errorConditionFormula>
        <errorMessage>ERROR: Debe especificar el motivo por el cual el Cliente No Requiere Seguro!!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Without_Service_Lines</fullName>
        <active>false</active>
        <errorConditionFormula>Total_IEQServLines__c =0  &amp;&amp; ispickval( Quotation_Status__c , &quot;Approved as Succesful&quot;) &amp;&amp;  NOT(FolioResume__c = &quot;FO, FP&quot;)</errorConditionFormula>
        <errorMessage>ERROR: No se puede Aprovar sin crear las Service Lines</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validation_Date_ETD</fullName>
        <active>false</active>
        <errorConditionFormula>ETD__c &gt; ETA__c</errorConditionFormula>
        <errorDisplayField>ETA__c</errorDisplayField>
        <errorMessage>the date must be greater than ETD</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>W_Margen_Operativo</fullName>
        <active>true</active>
        <errorConditionFormula>IF ( Account_for__r.Order_to_Cash__c = False,
AND( FolioResume__c = &quot;W&quot;,
ISPICKVAL( Quotation_Status__c , &quot;Approved as Succesful&quot;) , Margen_Operativo__c &lt; $User.W_Margen_Operativo__c ),
NULL)</errorConditionFormula>
        <errorMessage>MARGEN OPERATIVO ES MENOR A TU LIMITE DE AUTORIZACIÓN PARA FOLIO &quot;W&quot; 
*Favor de Contactar a la Gerencia o Dirección de Ventas.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ubicacion_validada</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    NOT(ISBLANK(Account_Origin_Address__c)), 
    TEXT(Account_Origin_Address__r.status__c) &lt;&gt; &apos;Validado&apos;
)</errorConditionFormula>
        <errorMessage>La dirección debe tener el status&apos;Validado&apos; para poder proceder</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Associate_Documents</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Associate Documents</masterLabel>
        <openType>noSidebar</openType>
        <protected>false</protected>
        <url>/apex/NEU_MD_Associated_Documents?id={!CASESAFEID(Customer_Quote__c.Id)}</url>
    </webLinks>
    <webLinks>
        <fullName>Automatic_Calculation_of_Duties</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
