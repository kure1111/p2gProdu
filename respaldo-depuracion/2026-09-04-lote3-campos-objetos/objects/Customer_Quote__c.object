    <fields>
        <fullName>Calc_Gasto_Op_Dir__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(CurrencyIsoCode,&quot;USD&quot;), Gasto_Operativo_Prod1__c *  Conversion_Rate_Calc__c   , Gasto_Operativo_Prod1__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Gasto Operativo Directo</label>
        <precision>18</precision>
