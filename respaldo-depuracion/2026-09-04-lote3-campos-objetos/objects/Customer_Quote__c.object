    <fields>
        <fullName>Commercial_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL( Quotation_Status__c,&quot;Quote being prepared&quot;), &quot;Open&quot;,
IF(ISPICKVAL( Quotation_Status__c,&quot;Awaiting costs suppliers&quot;), &quot;Open&quot;,
IF(ISPICKVAL( Quotation_Status__c,&quot;Sent awaiting response&quot;), &quot;Open&quot;,
IF(ISPICKVAL( Quotation_Status__c,&quot;Approved as Succesful&quot;), &quot;Closed&quot;,
IF(ISPICKVAL( Quotation_Status__c,&quot;Quote Declined&quot;), &quot;Closed Declined&quot;,
IF(ISPICKVAL( Quotation_Status__c,&quot;Shipped&quot;), &quot;Closed&quot;,NULL))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Commercial Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
