    <fields>
        <fullName>Clave_Via_Entrada_Salida__c</fullName>
        <description>Precisa la vía de ingreso o salida de los bienes o mercancías en territorio nacional.
Catalogo c_CveTransporte
01 Autotransporte Federal,
02 Transporte Marítimo,
03 Transporte Aéreo,</description>
        <externalId>false</externalId>
        <formula>IF( 

       ISPICKVAL( Freight_Mode__c , &quot;Road&quot;), &quot;01&quot;,
    IF(ISPICKVAL( Freight_Mode__c , &quot;Sea&quot;) , &quot;02&quot; ,&quot;03&quot; 

))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Precisa la vía de ingreso o salida de los bienes o mercancías en territorio nacional.
Catalogo c_CveTransporte
01 Autotransporte Federal,
02 Transporte Marítimo,
03 Transporte Aéreo,</inlineHelpText>
        <label>Clave Via Entrada/Salida</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
