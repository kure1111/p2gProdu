    <fields>
        <fullName>Destination_Amount__c</fullName>
        <description>Conversion to currency of ratio between sum of &quot;Sell Origin Amount&quot;, &quot;Shipment Charges Assigned&quot; and &quot;Total Taxes&quot;, and 1- &quot;Margin at Destination&quot;. Roll-Up from Destination Amount</description>
        <externalId>false</externalId>
        <formula>(Sell_Origin_Amount__c +  Shipment_Charges_Assigned_copy__c + Total_Taxes__c)/(1- Margin_at_Destination__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Ratio between total cost amount and 1- &quot;Margin at Destination&quot;</inlineHelpText>
        <label>Destination Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Destination_Amount_header_currency__c</fullName>
        <externalId>false</externalId>
        <formula>Destination_Amount__c *  Conversion_Rate_to_Currency_Header__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Destination Amount (header currency)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
