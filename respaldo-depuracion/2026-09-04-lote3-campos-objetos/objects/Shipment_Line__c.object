    <fields>
        <fullName>Invoice_Outstanding_Balance__c</fullName>
        <description>Conversion to currency of difference between &quot;Sell Origin Amount&quot; and &quot;Invoiced Amount&quot;, from Invoice Outstanding Balance Roll-Up</description>
        <externalId>false</externalId>
        <formula>Sell_Origin_Amount__c - Invoiced_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Difference between &quot;Sell Origin Amount&quot; and &quot;Invoiced Amount&quot;</inlineHelpText>
