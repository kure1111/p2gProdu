    <fields>
        <fullName>Item_Units_x_Packaging__c</fullName>
        <description>If &quot;Quote Item Line&quot; not blank then &quot;Item Units x Packaging&quot; from &quot;Quote Item Line&quot;, else &quot;Item Units x Packaging&quot; from &quot;Supplier Quote Line&quot;</description>
        <externalId>false</externalId>
        <formula>IF(Quote_Item_Line__c &lt;&gt; null , Quote_Item_Line__r.Item_Units_x_Packaging__c, Supplier_Quote_Line__r.Item_Units_x_Packaging__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Item Units x Packaging</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
