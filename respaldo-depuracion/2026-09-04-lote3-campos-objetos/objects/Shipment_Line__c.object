        <fullName>Total_Volume_Items_Packaging_m3__c</fullName>
        <description>Product of &quot;Units Shipped&quot; and ratio of &quot;Master Box Volume (m3)&quot; from &quot;Item Name&quot; to &quot;Units x Master Box&quot; from &quot;Item Name&quot;</description>
        <externalId>false</externalId>
        <formula>(Item_Name__r.Master_Box_Volume_m3__c / Item_Name__r.Units_x_Master_Box__c)* Units_Shipped__c</formula>
        <label>Total Volume Items + Packaging (m3)</label>
        <precision>18</precision>
        <required>false</required>
