        <externalId>false</externalId>
        <formula>Units_Shipped__c *  BLANKVALUE( Item_Name__r.Master_Box_Gross_Weight_kg__c /  Item_Name__r.Units_x_Master_Box__c , Item_Name__r.Weight_Kgs__c )</formula>
