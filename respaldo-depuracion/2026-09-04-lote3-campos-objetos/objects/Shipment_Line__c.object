        <externalId>false</externalId>
        <label>Margin at Destination</label>
        <precision>4</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Margin_at_Origin__c</fullName>
        <description>Ratio of &quot;Profit&quot; to &quot;Sell Origin Amount&quot;</description>
        <externalId>false</externalId>
        <formula>Profit__c /  Sell_Origin_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Ratio of &quot;Profit&quot; to &quot;Sell Origin Amount&quot;</inlineHelpText>
        <label>Margin at Origin</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
