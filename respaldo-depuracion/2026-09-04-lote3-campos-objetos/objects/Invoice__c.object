    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Credit_Note_Negative_Amount</fullName>
        <active>true</active>
        <errorConditionFormula>text(Type__c) == &apos;Credit Note&apos; &amp;&amp; Total_Incl_VAT__c &gt; 0</errorConditionFormula>
        <errorMessage>You can’t include these lines because Total(Incl. Vat) in the “Credit Note” Invoice must be negative</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Debit_Note_Positive_Amount</fullName>
        <active>true</active>
        <errorConditionFormula>text(Type__c) == &apos;Debit Note&apos; &amp;&amp; Total_Incl_VAT__c &lt; 0</errorConditionFormula>
        <errorMessage>You can´t include these lines because Total (Incl. VAT) in the &quot;Debit Note&quot; Invoice must be positive</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Equals_Account_For</fullName>
        <active>true</active>
        <errorConditionFormula>Account__c  &lt;&gt;  Shipment__r.Account_for__c</errorConditionFormula>
        <errorDisplayField>Account__c</errorDisplayField>
        <errorMessage>El cliente no coincide con el Shipment</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Acuse_SAP</fullName>
        <active>false</active>
        <errorConditionFormula>Status_Acuse_SAP__c &lt;&gt; &quot;ACUSE RECIBIDO&quot;</errorConditionFormula>
        <errorMessage>ERROR: El estatus del Acuse en SAP debe ser: &quot;ACUSE RECIBIDO&quot;
Favor de acudir con Departamento de Acuses (Rocio Osuna)</errorMessage>
    </validationRules>
