            <field>Invoice_Status__c</field>
            <operation>equals</operation>
            <value>Facturado</value>
        </filters>
        <filters>
            <field>Facturado_2__c</field>
            <operation>greaterThan</operation>
            <value>1/1/2024 12:00 AM</value>
        </filters>
        <label>Facturado</label>
    </listViews>
    <listViews>
        <fullName>NAYLETH</fullName>
        <columns>NAME</columns>
        <columns>Shipment__c</columns>
        <columns>Account__c</columns>
        <columns>WP_AccOwner__c</columns>
