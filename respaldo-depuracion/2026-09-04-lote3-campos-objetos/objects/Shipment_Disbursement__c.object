    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Credit_Note_Negative_Amount</fullName>
        <active>false</active>
        <errorConditionFormula>text(Type__c) == &apos;Credit Note&apos; &amp;&amp; Total_Incl_VAT__c &gt; 0</errorConditionFormula>
        <errorMessage>You can’t include these lines because Total(Incl. Vat) in the “Credit Note” Invoice must be negative</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Debit_Note_Positive_Amount</fullName>
        <active>false</active>
        <errorConditionFormula>text(Type__c) == &apos;Debit Note&apos; &amp;&amp; Total_Incl_VAT__c &lt; 0</errorConditionFormula>
        <errorMessage>You can´t include these lines because Total (Incl. VAT) in the &quot;Debit Note&quot; Invoice must be positive</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
