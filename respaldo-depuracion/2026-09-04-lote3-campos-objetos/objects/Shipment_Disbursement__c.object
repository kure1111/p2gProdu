    <fields>
        <fullName>Account__c</fullName>
        <externalId>false</externalId>
        <label>Supplier Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Account.RecordType.Name</field>
                <operation>equals</operation>
                <value>Supply Chain Partner</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Disbursements</relationshipLabel>
        <relationshipName>Shipment_Disbursements</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>true</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>true</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Accounting_Rollup_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF ( BEGINS(Disbursment_Concept__c, &apos;FREIGHT&apos;)
|| BEGINS(Disbursment_Concept__c, &apos;COMM&apos;)
|| BEGINS(Disbursment_Concept__c, &apos;DEMM&apos;)
|| BEGINS(Disbursment_Concept__c, &apos;DISP&apos;)
,&apos;ACCT-FREIGHT-EXPENSE&apos;, 
IF ( BEGINS(Disbursment_Concept__c, &apos;CUST&apos;)
|| BEGINS(Disbursment_Concept__c, &apos;SURV&apos;)
|| BEGINS(Disbursment_Concept__c, &apos;CLEAN&apos;)
, &apos;ACCT-OTHER-EXPENSE&apos;,&apos;ACCT-REVENUE&apos;
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Accounting Rollup Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
