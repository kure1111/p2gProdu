    <fields>
        <fullName>Containers__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Shipment__c != null, 

IF(AND(text(Shipment__r.N_Containers__c) != null, Shipment__r.Container_Type__c != null, text(Shipment__r.N_Containers__c) != &apos;0&apos;) , text(Shipment__r.N_Containers__c) &amp; &apos; x &apos; &amp; Shipment__r.Container_Type__r.Name, IF(AND(text(Shipment__r.N_Containers__c) != null, text(Shipment__r.N_Containers__c) !=&apos;0&apos;) , text(Shipment__r.N_Containers__c), IF(Shipment__r.Container_Type__c != null , Shipment__r.Container_Type__r.Name, &apos;&apos;)))
,


IF(Import_Export_Quote_Order__c != null,
IF(AND(text(Import_Export_Quote_Order__r.Container_Count__c) != null, Import_Export_Quote_Order__r.Container_Type__c != null, text(Import_Export_Quote_Order__r.Container_Count__c) != &apos;0&apos;) , text(Import_Export_Quote_Order__r.Container_Count__c) &amp; &apos; x &apos; &amp; Import_Export_Quote_Order__r.Container_Type__r.Name, IF(AND(text(Import_Export_Quote_Order__r.Container_Count__c) != null, text(Import_Export_Quote_Order__r.Container_Count__c) !=&apos;0&apos;) , text(Import_Export_Quote_Order__r.Container_Count__c), IF(Import_Export_Quote_Order__r.Container_Type__c != null , Import_Export_Quote_Order__r.Container_Type__r.Name, &apos;&apos;)))
,&apos;&apos;
)

)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Containers</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
