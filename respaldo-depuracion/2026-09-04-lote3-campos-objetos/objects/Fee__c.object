    <fields>
        <fullName>Key_Description__c</fullName>
        <externalId>false</externalId>
        <formula>UPPER(Fee_Description__c+&apos;|&apos;+Distance__c+&apos;|&apos;+Volume__c+&apos;|&apos;+Weight__c)+&apos;|&apos;+Route__r.Port_Airport_of_Load__c+&apos;|&apos;+Route__r.Port_Airport_of_Discharge__c+&apos;|&apos;+Carrier_Account__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Key_Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Key_Drayages__c</fullName>
        <externalId>false</externalId>
        <formula>UPPER(TEXT(Fee_Category__c)+&apos;|&apos;+TEXT(Rate_Type__c)+&apos;|&apos;+Modality__c)+&apos;|&apos;+Container_Type__c+&apos;|&apos;+Port_Airport__c+&apos;|&apos;+Delivery_Zone__c+&apos;|&apos;+Carrier_Account__c</formula>
        <label>Key_Drayages</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Key__c</fullName>
        <externalId>false</externalId>
        <formula>IF(TEXT(Fee_Category__c) == &apos;Warehouse&apos;, UPPER(Name+&apos;|&apos;+TEXT(Fee_Category__c)+&apos;|&apos;+TEXT(Rate_Type__c))+&apos;|&apos;+Route__r.Port_Airport_of_Load__c+&apos;|&apos;+Route__r.Port_Airport_of_Discharge__c, UPPER(TEXT(Fee_Category__c)+&apos;|&apos;+TEXT(Rate_Type__c))+&apos;|&apos;+Container_Type__c+&apos;|&apos;+Route__r.Port_Airport_of_Load__c+&apos;|&apos;+Route__r.Port_Airport_of_Discharge__c+&apos;|&apos;+Carrier_Account__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Key</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
