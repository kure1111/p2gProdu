    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Check_Max_Kgs_Max_M3</fullName>
        <active>false</active>
        <errorConditionFormula>if(AND( TEXT(Fee_Category__c) == &apos;Drayages&apos;, 
TEXT(Rate_Type__c) ==&apos;Fixed&apos;), if(ISNULL(Max_Kgs__c) == true,
if(ISNULL(Max_M3__c) == true,true,false),false)
,false)</errorConditionFormula>
        <errorMessage>The field &quot;Max Kgs&quot; or &quot;Max M3&quot;  or both must be filled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Service_Rate_Validation_Rule</fullName>
        <active>true</active>
        <description>v c s p</description>
        <errorConditionFormula>AND(RecordType.Name = &apos;Servicios&apos;,
OR(
SAP_Service_Type__r.Code__c= &quot;FTN&quot;,
SAP_Service_Type__r.Code__c= &quot;FTN02&quot;,
SAP_Service_Type__r.Code__c= &quot;FCONA&quot;
)
)</errorConditionFormula>
        <errorMessage>Record Type no compatible con SAP Service Type seleccionado.

SOLICITAR ALTA DE TARIFA CON DEPARTAMENTO DE COMPRAS POR MEDIO DE CHATTER</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
