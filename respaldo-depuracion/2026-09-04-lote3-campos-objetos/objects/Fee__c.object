    <fields>
        <fullName>Tipo_RetencionClientes__c</fullName>
        <description>Campo que confirma el tipo de retención que contiene el cliente</description>
        <externalId>false</externalId>
        <formula>IF(
CONTAINS(SAP_Service_Type__r.Code__c, &apos;NO DEDUCIBLE&apos;), &apos;No Aplica&apos;,

IF(
 AND( Country_of_Load__c = &apos;Mexico&apos;, Country_of_Discharge__c &lt;&gt; &apos;Mexico&apos;, CONTAINS(SAP_Service_Type__r.Code__c, &apos;-INT_AEREO_(IC)&apos;), ISPICKVAL(SST_Porcentaje_de_division__c, &apos;75%&apos;) ), &apos;A0&apos;,
IF(
 AND( Country_of_Load__c = &apos;Mexico&apos;, Country_of_Discharge__c &lt;&gt; &apos;Mexico&apos;, CONTAINS(SAP_Service_Type__r.Code__c, &apos;-INT_AEREO_(IC)&apos;), ISPICKVAL(SST_Porcentaje_de_division__c, &apos;25%&apos;) ), &apos;A3&apos;,

IF(
AND( Country_of_Load__c = &apos;Mexico&apos;, Country_of_Discharge__c = &apos;Mexico&apos;, ISPICKVAL(SAP_Service_Type__r.VAT_Withholding__c, &apos;Si&apos;) ), &apos;A3&apos;,
IF(
