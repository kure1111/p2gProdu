    <fields>
        <fullName>Es_flete__c</fullName>
        <externalId>false</externalId>
        <formula>if
(
OR
(
SAP_Service_Type__r.Code__c = &apos;FTN&apos;,
SAP_Service_Type__r.Code__c = &apos;FTNSL&apos;,
SAP_Service_Type__r.Code__c = &apos;PTO2&apos;,
SAP_Service_Type__r.Code__c = &apos;PTOSL&apos;,
SAP_Service_Type__r.Code__c = &apos;PTO3&apos;,
SAP_Service_Type__r.Code__c = &apos;FISL&apos;,
SAP_Service_Type__r.Code__c = &apos;IT&apos;,
SAP_Service_Type__r.Code__c = &apos;SL01&apos;
)
,true
,false
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Es flete</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
