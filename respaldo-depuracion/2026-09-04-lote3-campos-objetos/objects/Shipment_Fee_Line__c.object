    <label>Shipment Service Line</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <label>Service Line</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Shipment Service Lines</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Shipment__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Service_Rate_Category__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Service_Rate_Name__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Rate_Type__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Units__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Shipment_Sell_Price__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Sell_Amount__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Shipment_Buy_Price__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Std_Buy_Amount__c</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>Shipment__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Service_Rate_Category__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Service_Rate_Name__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Rate_Type__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Units__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Shipment_Sell_Price__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Sell_Amount__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Shipment_Buy_Price__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Std_Buy_Amount__c</lookupDialogsAdditionalFields>
        <searchResultsAdditionalFields>Shipment__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Service_Rate_Category__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Service_Rate_Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Rate_Type__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Units__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Shipment_Sell_Price__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Sell_Amount__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Shipment_Buy_Price__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Std_Buy_Amount__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Block_Shipment_Service_Line</fullName>
        <active>true</active>
        <description>Bloqueo de edicion cuando campo control esta activo</description>
        <errorConditionFormula>AND(
NOT(ISNEW()),
Campo_Control__c,
NOT(CONTAINS($Profile.Name,&quot;Admin&quot;))
)</errorConditionFormula>
        <errorMessage>No es posible modificar debido a que cuenta con una Orden de Entrega.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LimiteCreditoNoDisponible</fullName>
        <active>false</active>
        <description>Regla que detecta cuando el total de servicios vendidos supera al saldo disponible del cliente</description>
        <errorConditionFormula>AND(
ISCHANGED(Shipment_Sell_Price__c),
Shipment__r.Account_for__r.Saldo_DisponibleOK__c &lt;  Shipment_Sell_Price__c,
 Shipment__r.Acc_venta__c = &apos;Credito&apos;
)</errorConditionFormula>
        <errorDisplayField>Shipment_Sell_Price__c</errorDisplayField>
        <errorMessage>Crédito del cliente insuficiente. Hablar con el departamento de créditos*</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LineaVenta_SinCarrier</fullName>
        <active>false</active>
        <description>Regla que detecta cuando se intenta cargar una Shipment Service Line que aún no tiene asignado el carrier en el Rate Name.</description>
        <errorConditionFormula>ISBLANK( Service_Rate_Name__r.Carrier_Account__c )</errorConditionFormula>
        <errorMessage>No se puede cargar una línea de venta si aún no tiene asignado el Carrier*</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoModificarPreciosVentaCompra</fullName>
        <active>true</active>
        <errorConditionFormula>AND(

   Shipment__r.Estatus_Cerrado__c = true,

   OR(
      ISPICKVAL(  Shipment__r.Shipment_Status_Plann__c   , &apos;Closed&apos;),
      ISPICKVAL( Shipment__r.Shipment_Status_Mon__c  , &apos;Closed&apos;),
      ISPICKVAL( Shipment__r.Air_Shipment_Status__c , &apos;Closed&apos;),
      ISPICKVAL( Shipment__r.Shipment_Status__c, &apos;Closed&apos;),
      ISPICKVAL( Shipment__r.Ocean_Shipment_Status__c , &apos;Closed&apos;)),

    OR(
        AND(
            ISCHANGED(Shipment_Buy_Price__c),
            PRIORVALUE(Shipment_Buy_Price__c) &lt;&gt; 0
        ),

        Shipment_Sell_Price__c &lt;&gt; PRIORVALUE(Shipment_Sell_Price__c)
    )

)</errorConditionFormula>
        <errorMessage>No se puede modificar el Precio de venta / Costo si el Shipment esta en estatus &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoModificarShipmentSellPrice</fullName>
        <active>true</active>
        <description>No modificar el campo &apos;Shipment Sell Price&apos; si el usuario tiene el perfil de PAK2GO Operaciones</description>
        <errorConditionFormula>AND(
ISCHANGED( Shipment_Sell_Price__c ),
$Profile.Id = &apos;00e4T000000lL6S&apos;,
$User.Contado_Mgm__c = False
)</errorConditionFormula>
        <errorDisplayField>Shipment_Sell_Price__c</errorDisplayField>
        <errorMessage>SSP-001: Usuario no permitido para modificar este campo. Solicitar la modificación del precio a comercial</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_se_acepta_1peso_SP</fullName>
        <active>true</active>
        <errorConditionFormula>Shipment_Buy_Price__c = 1</errorConditionFormula>
        <errorMessage>No se puede colocar el valor de $1 en este campo</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Nueva_ServiceStatus_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Shipment__r.Estatus_Cerrado__c = true,
OR(
ISPICKVAL( Shipment__r.Shipment_Status_Plann__c , &apos;Closed&apos;),
ISPICKVAL( Shipment__r.Air_Shipment_Status__c , &apos;Closed&apos;),
ISPICKVAL( Shipment__r.Shipment_Status__c, &apos;Closed&apos;),
ISPICKVAL( Shipment__r.Ocean_Shipment_Status__c , &apos;Closed&apos;)
),
isnew()
)</errorConditionFormula>
        <errorMessage>No se pueden crear Service Lines si el Shipment esta en estatus &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Nueva_con_credito</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL( Shipment__r.Account_for__r.Venta_Sap__c  , &quot;Credito&quot;),
OR(
ISPICKVAL( Service_Rate_Name__r.Fee_Category__c  , &apos;Road Freights&apos;),
ISPICKVAL( Service_Rate_Name__r.Fee_Category__c  , &apos;Sea Freights&apos;),
ISPICKVAL( Service_Rate_Name__r.Fee_Category__c  , &apos;Air Freights&apos;)
),

Shipment_Sell_Price__c &gt; Shipment__r.Account_for__r.Saldo_DisponibleOK__c ,
isnew()
)</errorConditionFormula>
        <errorMessage>SSLN Cliente sin crédito disponible</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Nueva_sin_credito</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL( Shipment__r.Account_for__r.Venta_Sap__c  , &quot;Credito&quot;),
OR(
ISPICKVAL( Service_Rate_Name__r.Fee_Category__c  , &apos;Road Freights&apos;),
ISPICKVAL( Service_Rate_Name__r.Fee_Category__c  , &apos;Sea Freights&apos;),
ISPICKVAL( Service_Rate_Name__r.Fee_Category__c  , &apos;Air Freights&apos;)
),
Shipment__r.Account_for__r.Saldo_DisponibleOK__c &lt;= 0,
isnew()
)</errorConditionFormula>
        <errorMessage>Cliente sin crédito disponible</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Fisnished</fullName>
        <active>false</active>
        <errorConditionFormula>Shipment_Finished__c = true &amp;&amp; Service_Rate_Category__c = &quot;Road Freights&quot; &amp;&amp; $User.ProfileId  &lt;&gt; &quot;2F00e4T000000lKYP&quot; ||
Shipment_Finished__c = true &amp;&amp; Service_Rate_Category__c = &quot;Sea Freights&quot; &amp;&amp; $User.ProfileId &lt;&gt; &quot;2F00e4T000000lKYP&quot; ||
Shipment_Finished__c = true &amp;&amp; Service_Rate_Category__c = &quot;Air Freights&quot; &amp;&amp; $User.ProfileId &lt;&gt; &quot;2F00e4T000000lKYP&quot;</errorConditionFormula>
        <errorMessage>NO SE PUEDE MODIFICAR EN ESTATUS FINISHED</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
