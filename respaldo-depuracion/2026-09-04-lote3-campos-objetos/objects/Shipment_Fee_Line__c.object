        <formula>IF(Shipment_Buy_Price__c &gt;= 0 ,MAX (Shipment_Buy_Price__c * Units__c, IF((ISNULL(Shipment_Buy_Price__c )== true) || (Shipment_Buy_Price__c = 0), 0, Min_Amount__c ) ), MIN (Shipment_Buy_Price__c * Units__c, IF((ISNULL(Shipment_Buy_Price__c )== true) || (Shipment_Buy_Price__c = 0), 0, - Min_Amount__c ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Buy Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Std_Buy_Amount_header_currency__c</fullName>
        <externalId>false</externalId>
        <formula>Std_Buy_Amount__c * Conversion_Rate_to_Currency_Header__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Buy Amount (header currency)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Tarifa_Negociada__c</fullName>
        <externalId>false</externalId>
        <formula>text( Service_Rate_Name__r.Tarifa_objetivo__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Tarifa Negociada</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Tarifario_Info__c</fullName>
