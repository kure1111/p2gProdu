        <formula>Service_Rate_Name__r.CustomRate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Tarifario</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Total_Amount_Allocated_On_Disbursements__c</fullName>
        <externalId>false</externalId>
        <label>Total Amount Allocated On Disbursements</label>
        <summarizedField>Shipment_Service_Line_Disbursement__c.Amount_Allocated_Service_Line_Currency__c</summarizedField>
        <summaryForeignKey>Shipment_Service_Line_Disbursement__c.Shipment_Service_Line__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Total_Amount_Disbursements_Hea_Currency__c</fullName>
        <externalId>false</externalId>
        <formula>Total_Amount_Allocated_On_Disbursements__c * Conversion_Rate_to_Currency_Header__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Amount Disbursements(Hea Currency)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Amount_Invoiced_header_currency__c</fullName>
        <externalId>false</externalId>
        <formula>Invoiced_Amount__c *  Conversion_Rate_to_Currency_Header__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Amount Invoiced (header currency)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Units__c</fullName>
