        <fullName>sap_service_types_info__c</fullName>
        <externalId>false</externalId>
        <formula>Service_Rate_Name__r.SAP_Service_Type__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
