    <fields>
        <fullName>Sell_Gross_Amount__c</fullName>
        <description>Conversion to currency of; highest value between &quot;Min Amount&quot; and (&quot;Quote Sell Price&quot; x &quot;Units&quot;), if &quot;Quote Sell Price&quot; greater or equal to 0, else product of &quot;Quote Sell Price&quot; and &quot;Units&quot;</description>
        <externalId>false</externalId>
        <formula>IF(Quote_Sell_Price__c &gt;= 0,MAX(Min_Amount__c, Quote_Sell_Price__c*Units__c),Quote_Sell_Price__c*Units__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
