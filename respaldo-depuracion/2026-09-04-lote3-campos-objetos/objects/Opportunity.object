    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>ActivacionAutorizada</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  Account.ActiveSap__c  = false,
  RecordType.Name = &quot;Proyectos&quot;,
ISPICKVAL(StageName, &quot;Activación Cliente&quot;)
)</errorConditionFormula>
        <errorDisplayField>Activacion_autorizada__c</errorDisplayField>
        <errorMessage>PROJ001- Favor de revisar si ya se activó la cuenta.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DebeTenerCosto</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(StageName , &quot;VoBo IC&quot;),
RecordType.Name = &quot;Proyectos&quot;,
OR(
Amount = 0,
ISNULL(Amount)
)
)</errorConditionFormula>
        <errorDisplayField>Amount</errorDisplayField>
        <errorMessage>PROJ004: Antes de proceder al estatus de VoBo IC, el campo de &quot;Amount&quot; no puede ser 0. Favor de agregar productos.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MotivoDeRechazo</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
 ISPICKVAL(StageName,&quot;Declinar&quot;),
 RecordType.Name = &quot;Proyectos&quot;,
  ISPICKVAL( Loss_Reason__c , &quot;&quot;)  

)</errorConditionFormula>
        <errorDisplayField>Loss_Reason__c</errorDisplayField>
        <errorMessage>PROJ006: Favor de agregar un motivo de pérdida.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoCambiarEtapaFactibilidad</fullName>
        <active>true</active>
        <description>Solo puede cambiar etapa Inteligencia Comercial y Marcos</description>
        <errorConditionFormula>AND(ISPICKVAL(StageName, &quot;Factibilidad de Proyecto&quot;),
ISCHANGED(StageName),
RecordType.Name = &quot;Proyectos&quot;,
AND(
NOT($UserRole.Name = &quot;Asesor Comercial &quot;),
NOT($UserRole.Name = &quot;Cuenta Clave &quot;),
NOT($UserRole.Name = &quot; Director Comercial&quot;),
NOT($UserRole.Name = &quot;Gerente Comercial&quot;),
NOT($UserRole.Name = &quot;Representantes SAC&quot;),
NOT($UserRole.Name = &quot;OPERACIONES&quot;)

)
)</errorConditionFormula>
        <errorMessage>PROJ002_Solo Inteligencia Comercial puede aprobar esta etapa</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoCambiarStageCompras</fullName>
        <active>true</active>
        <description>Solo puede cambiar etapa Compras</description>
        <errorConditionFormula>AND(
 $Profile.Id &lt;&gt; &quot;00e4T000000zD9C&quot;,
 $User.Id &lt;&gt; &quot;0054T000000cUcw&quot;,

ISPICKVAL(StageName, &quot;Cotización Compras&quot;),
ISCHANGED(StageName),
RecordType.Name = &quot;Proyectos&quot;)</errorConditionFormula>
        <errorMessage>PROJ003: Solo Compras puede aprobar esta etapa</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NoCambiarStageVoBoIC</fullName>
        <active>true</active>
        <description>Solo puede cambiar etapa Inteligencia Comercial</description>
        <errorConditionFormula>AND(
 $User.Id &lt;&gt; &quot;0054T000001hgIi&quot;,
 $Profile.Id &lt;&gt; &quot;00e4T000000zD9C&quot;,
 $User.Id &lt;&gt; &quot;0054T000001iWDU&quot;,

ISPICKVAL(StageName, &quot;VoBo IC&quot;),
ISCHANGED(StageName),
RecordType.Name = &quot;Proyectos&quot;)</errorConditionFormula>
        <errorMessage>PROJ005: Solo Inteligencia Comercial puede aprobar esta etapa</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_solicitar_IEQ</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Tipo__c , &quot;Quote&quot;),
  ISNULL(Import_Export_Quote_Order__c)
)</errorConditionFormula>
        <errorDisplayField>Import_Export_Quote_Order__c</errorDisplayField>
        <errorMessage>Import Export Quote debe ir en blanco</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP009</fullName>
        <active>true</active>
        <description>Agregar que otro requerimiento especial en campo de texto</description>
        <errorConditionFormula>AND(
  INCLUDES(Requerimientos_especialesNew__c, &quot;Otro&quot;),
  ISBLANK(Comentarios_Otros__c)
)</errorConditionFormula>
        <errorMessage>OPP009 - Es necesario especificar que otro requerimiento especial se necesita en el campo &quot;Comentarios Otros&quot;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP010</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordType.Name = &apos;Proyecto&apos;,
    AND(
        OR(
            ISPICKVAL(StageName, &quot;Cotización&quot;),
            ISPICKVAL(StageName, &quot;Negociación&quot;),
            ISPICKVAL(StageName, &quot;Ejecución&quot;)
        ),
        OR(
            TotalOpportunityQuantity = 0,
            ISBLANK(TotalOpportunityQuantity)
        )
    )
)</errorConditionFormula>
        <errorMessage>OPP010 - Debes de Cargar Productos para poder cambiar de etapa.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP011</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    RecordType.Name = &apos;Proyecto&apos;,
    NOT(
        OR(
            ISPICKVAL(Group__c, &quot;SP-PQ-PAQUETERIA&quot;),
            ISPICKVAL(Group__c, &quot;SP-T-CONSOLIDADO&quot;),
            ISPICKVAL(Group__c, &quot;SP-WH-ALMACENAJE&quot;)
        )
    ),
    AND(
        OR(            
            ISPICKVAL(StageName, &quot;Negociación&quot;),
            ISPICKVAL(StageName, &quot;Ejecución&quot;)
        ),
        OR(
            Total_Buy_Price2__c = 0,
            Amount = 0
        )
    )
)</errorConditionFormula>
        <errorMessage>OPP011 - Los productos deben tener un costo de Buy Price y Sell Price para poder cambiar de etapa</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP012</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordType.Name = &apos;Proyecto&apos;,
    NOT(
        OR(
            ISPICKVAL(Group__c, &quot;SP-PQ-PAQUETERIA&quot;),
            ISPICKVAL(Group__c, &quot;SP-T-CONSOLIDADO&quot;),
            ISPICKVAL(Group__c, &quot;SP-WH-ALMACENAJE&quot;)
        )
    ),
    AND(
        OR(
            ISPICKVAL(StageName, &quot;Ejecución&quot;)
        ),
        OR(
            Realizacion_de_Kickoff__c = false
        )
    )
)</errorConditionFormula>
        <errorMessage>OPP012 - Para pasar a la etapa ejecución se requiere activar el campo Realización de Kikoff</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP_Agreed_Shipping</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL(StageName, &quot;Agreed Shipping&quot;),

OR(
(IEQ_Status__c &lt;&gt; &quot;Approved as Succesful&quot;),
(Total_Quotes_Vendido__c  &lt;&gt; 0 ))

)</errorConditionFormula>
        <errorMessage>OPP004- Se necesita Quote Vendido o Total IEQ</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP_Agreed_Shipping2</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(StageName, &quot;Agreed Shipping&quot;),
ISPICKVAL(Tipo__c,&quot;Quote&quot;),

Total_Quotes_Vendido__c  &lt;= 0 

)</errorConditionFormula>
        <errorMessage>OPP005- Se necesita Quote Vendido</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP_Agreed_Shipping3</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(StageName, &quot;Agreed Shipping&quot;),
ISPICKVAL(Tipo__c,&quot;Import-Export Quote/Order&quot;),
ISPICKVAL(Tipo__c, &quot;Quote&quot;),

IEQ_Status__c &lt;&gt; &quot;Approved as Succesful&quot;

)</errorConditionFormula>
        <errorMessage>OPP006- Se necesita Folio Aprobado</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP_First_Contact</fullName>
        <active>false</active>
        <description>Validación de esta etapa</description>
        <errorConditionFormula>AND(
ISPICKVAL(StageName,&quot;First Contact / Need Analysis&quot;),
RecordType.Name = &quot;Standar Opportunity&quot;,

Total_Products__c  &lt;= 0

)</errorConditionFormula>
        <errorMessage>OPP001-Para pasar a la siguiente etapa es necesario agregar Productos</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP_First_Contact2</fullName>
        <active>true</active>
        <description>Validación de esta etapa</description>
        <errorConditionFormula>AND(
ISPICKVAL(StageName,&quot;First Contact / Need Analysis&quot;),
RecordType.Name = &quot;Standar Opportunity&quot;,
ISPICKVAL(Tipo__c, &quot;Quote&quot;),

 PROJ_TotalQuotes__c =  0 

)</errorConditionFormula>
        <errorMessage>OPP002-Para pasar a la siguiente etapa es necesario agregar  Quotes</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP_First_Contact3</fullName>
        <active>true</active>
        <description>Validación de esta etapa</description>
        <errorConditionFormula>AND(
ISPICKVAL(StageName,&quot;First Contact / Need Analysis&quot;),
RecordType.Name = &quot;Standar Opportunity&quot;,
ISPICKVAL(Tipo__c, &quot;Import-Export Quote/Order&quot;),

 ISBLANK( Import_Export_Quote_Order__c )
)</errorConditionFormula>
        <errorMessage>OPP003-Para pasar a la siguiente etapa es necesario agregar Folio</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP_First_Shipment</fullName>
        <active>false</active>
        <description>Validación de esta etapa</description>
        <errorConditionFormula>AND(
ISPICKVAL(StageName,&quot;First Shipment&quot;),
RecordType.Name = &quot;Standar Opportunity&quot;,
 ( IEQ_Status__c  &lt;&gt;   &quot;Shipped&quot;)
)</errorConditionFormula>
        <errorMessage>OPP008-Para pasar a la siguiente etapa es necesario Shipment</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP_Implemented</fullName>
        <active>false</active>
        <description>Checkbox cliente capacitado</description>
        <errorConditionFormula>AND(
Ciente_Capacitado__c  = false,
RecordType.Name = &quot;Standar Opportunity&quot;,
ISPICKVAL(StageName, &quot;Implemented&quot;)
)</errorConditionFormula>
        <errorDisplayField>Ciente_Capacitado__c</errorDisplayField>
        <errorMessage>OPP007- Favor de revisar si se implemento con el cliente</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>OPP_Proposal</fullName>
        <active>false</active>
        <description>Validación de esta etapa</description>
        <errorConditionFormula>AND(
ISPICKVAL(StageName,&quot;Proposal&quot;),
RecordType.Name = &quot;Standar Opportunity&quot;,
 ISPICKVAL(LeadSource,&quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>LeadSource</errorDisplayField>
        <errorMessage>OPP004-Para pasar a la siguiente etapa es necesario agregar Lead Source</errorMessage>
    </validationRules>
