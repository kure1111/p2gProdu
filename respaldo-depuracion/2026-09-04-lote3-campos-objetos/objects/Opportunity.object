   IF(FLOOR((NOW() - CreatedDate) * 24 * 60) &lt; 10, IMAGE(&apos;/resource/relojVerde&apos;, &apos;relojVerde&apos;, 50, 50)  &amp; &quot; Tiempo trascurrido en la etapa &quot; &amp; TEXT(FLOOR(NOW() - CreatedDate)) &amp; &quot; Días &quot; &amp; TEXT( ROUND(((FLOOR((NOW() - CreatedDate) * 24 * 60)) - (FLOOR(NOW() - CreatedDate) * 1440)) / 60, 2)) &amp; &quot; Horas&quot;,
      IF(FLOOR((NOW() - CreatedDate) * 24 * 60) &lt; 30, IMAGE(&apos;/resource/relojNaranja&apos;, &apos;relojNaranja&apos;, 50, 50)  &amp; &quot; Tiempo trascurrido en la etapa &quot; &amp; TEXT(FLOOR(NOW() - CreatedDate)) &amp; &quot; Días &quot; &amp; TEXT( ROUND(((FLOOR((NOW() - CreatedDate) * 24 * 60)) - (FLOOR(NOW() - CreatedDate) * 1440)) / 60, 2)) &amp; &quot; Horas&quot;,
         IMAGE(&apos;/resource/relojRojo&apos;, &apos;relojRojo&apos;, 50, 50) &amp; &quot; Tiempo trascurrido en la etapa &quot; &amp; TEXT(FLOOR(NOW() - CreatedDate)) &amp; &quot; Días &quot; &amp; TEXT( ROUND(((FLOOR((NOW() - CreatedDate) * 24 * 60)) - (FLOOR(NOW() - CreatedDate) * 1440)) / 60, 2)) &amp; &quot; Horas&quot;
      )
   )
)</formula>
