 IMAGE(&apos;https://c.eu2.content.force.com/servlet/servlet.ImageServer?id=015b0000000AeZG&amp;oid=00Db0000000cLrt&amp;lastMod=1386162247000&apos;, &apos;Colaboration&apos;), IMAGE(&apos;https://c.eu2.content.force.com/servlet/servlet.ImageServer?id=015b0000000AeYm&amp;oid=00Db0000000cLrt&amp;lastMod=1386161894000&apos;, &apos;Colaboration&apos;))</formula>
