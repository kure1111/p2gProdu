NOT(ISBLANK( Nombre_Prospect__c ))
),

IF(


 AND(
Account_for_Prospect_Account_Name__c  =  Nombre_Prospect__c,
Account_for_Prospect_Account_Name__c  =   Name ,
Nombre_Prospect__c  =   Name 
)
,

&quot;IGUAL&quot;,

&quot;DIFERENTE&quot;







),&quot;&quot;)</formula>
