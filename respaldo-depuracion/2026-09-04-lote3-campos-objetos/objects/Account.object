    <fields>
        <fullName>Tipo_CuentaSAP__c</fullName>
        <description>Devuelve si es una Cuenta de tipo Credito, Contado, WCA Credito, ó WCA Contado</description>
        <externalId>false</externalId>
        <formula>IF( AND( ISPICKVAL( Venta_Sap__c, &apos;Credito&apos; ), ISBLANK( WCA_ID__c ) ),
    &apos;CREDITO&apos;,
    IF( AND( ISPICKVAL( Venta_Sap__c, &apos;Contado&apos; ), ISBLANK( WCA_ID__c ), Workplace_AccOwner__c &lt;&gt; &apos;GLOBAL&apos; ),
        &apos;CONTADO&apos;,
        IF( AND( ISPICKVAL( Venta_Sap__c, &apos;Credito&apos; ), NOT(ISBLANK( WCA_ID__c  )) ),
            &apos;WCA CREDITO&apos;,
        IF( AND( ISPICKVAL( Venta_Sap__c, &apos;Contado&apos; ), OR(ISBLANK( WCA_ID__c  )), Workplace_AccOwner__c = &apos;GLOBAL&apos; ),
            &apos;WCA CONTADO&apos;,
            &apos;NONE&apos;
          )
          )
      )
  )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Tipo de Cuenta</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
