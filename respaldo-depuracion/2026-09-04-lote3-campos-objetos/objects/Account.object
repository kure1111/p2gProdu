        <fullName>Ok_Folio_Mkt__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  Record_Type_Name__c = &quot;Prospect&quot; &amp;&amp;
 ISPICKVAL( AccountSource,&quot;Llamada entrante&quot;) , &quot;MKT - &quot; &amp;  Auto_Number__c ,
  IF( ISPICKVAL( AccountSource,&quot;Web&quot;) , &quot;MKT - &quot; &amp;  Auto_Number__c ,
   IF( ISPICKVAL( AccountSource,&quot;Redes sociales&quot;) , &quot;MKT - &quot; &amp;  Auto_Number__c ,
    IF( ISPICKVAL( AccountSource,&quot;MKT - Wsapp&quot;) , &quot;MKT - &quot; &amp;  Auto_Number__c ,  
     IF( ISPICKVAL( AccountSource,&quot;MKT - Email&quot;) , &quot;MKT - &quot; &amp;  Auto_Number__c ,
      IF( ISPICKVAL( AccountSource,&quot;MKT - Otros&quot;) , &quot;MKT - &quot; &amp;  Auto_Number__c ,
       IF( ISPICKVAL( AccountSource,&quot;MKT - Llamada entrante&quot;) , &quot;MKT - &quot; &amp;  Auto_Number__c , 
NULL)))))))</formula>
        <label>Folio</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
