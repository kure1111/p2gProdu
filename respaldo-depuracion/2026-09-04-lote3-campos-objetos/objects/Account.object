    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>AC001_Motivo_de_No_Venta</fullName>
        <active>true</active>
        <description>Agregar el motivo de No venta. 
Seguimiento</description>
        <errorConditionFormula>AND (


ISPICKVAL(SeguimientoProspecto__c,&quot;No Venta&quot;),

ISPICKVAL(Motivo_no_venta__c,&quot;&quot;)

)</errorConditionFormula>
        <errorDisplayField>Motivo_no_venta__c</errorDisplayField>
        <errorMessage>AC001_Agregue el Motivo de No Venta</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ACC003_Owner_whit_SlpCode</fullName>
        <active>true</active>
        <errorConditionFormula>AND (
ISBLANK(Owner.SalesEmployer__c ),
CASESAFEID(OwnerId) &lt;&gt; &apos;0054T000000ZZQ3QAO&apos;,
(RecordType.DeveloperName= &apos;Customer&apos;),
NOT(Name = &apos;Cotizador&apos;)
)</errorConditionFormula>
        <errorMessage>ACC003 - Los propietarios de las cuentas deben ser usuarios con código SlpCode activo.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Annual_Revenue_Aereo</fullName>
        <active>false</active>
        <errorConditionFormula>RecordType.Name = &quot;Customer&quot; &amp;&amp; 
INCLUDES(Unineg_cta__c, &quot;Aéreo&quot;) &amp;&amp;
ISBLANK(Annrevaer_cta__c)</errorConditionFormula>
        <errorDisplayField>Annrevaer_cta__c</errorDisplayField>
        <errorMessage>Para este Cliente Ha seleccionado Unidad de Negocio Aéreo, debe capturar Annual Revenue Aéreo.</errorMessage>
    </validationRules>
