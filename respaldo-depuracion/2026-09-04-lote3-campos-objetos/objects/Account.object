    <validationRules>
        <fullName>Bloq_Prospecto_Vtas</fullName>
        <active>false</active>
        <errorConditionFormula>Owner.Profile.Id  &lt;&gt;  &apos;00e0Y000000ZMMv&apos; &amp;&amp; 
ISCHANGED(  Description   )</errorConditionFormula>
        <errorMessage>ERROR: You Can&apos;t Modify fields &quot;Account Source&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Bloq_RecType_Customer</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    RecordType.Name = &quot;Customer&quot;,
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
        <errorMessage>ERROR: You Can&apos;t change this &quot;CUSTOMER&quot;
Please contact Administration Team.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Caracter_Especial_no_permitido</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
REGEX(Obsycom_cta__c, &quot;.*[&amp;\&quot;&lt;&gt;&apos;].*&quot;),
$User.Id &lt;&gt; &apos;0054T000001iQkX&apos;
)</errorConditionFormula>
        <errorMessage>No Puede contener los siguientes caracteres especiales &amp; &quot; &lt; &gt; &apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Change_AccountName_AND_Owner</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISCHANGED(Name),
ISCHANGED(OwnerId)
),
NOT(BEGINS($Profile.Id, &quot;00e4T000000zD9C&quot;)),
BEGINS(RecordTypeId, &quot;0124T000000PTuQ&quot;)
)</errorConditionFormula>
        <errorMessage>Para cualquier cambio o modificación del Account Name u Owner favor de comunicarse con su administrador</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Paqueteria_vs_datos_recoleccion</fullName>
        <active>false</active>
        <errorConditionFormula>IF (RecordType.Name = &quot;Customer&quot;, 
INCLUDES(Unineg_cta__c, &quot;Paqueteria&quot;) &amp;&amp;
(ISPICKVAL(Horrec_cta__c, &quot;&quot;) || 
ISPICKVAL(Frec_cta__c, &quot;&quot;) || 
ISPICKVAL(Tipveh_cta__c, &quot;&quot;) || 
ISPICKVAL(Tipenv_cta__c, &quot;&quot;) || 
ISPICKVAL(Tipogui_cta__c, &quot;&quot;)), NULL)</errorConditionFormula>
        <errorMessage>Ha seleccionado Unidad de Negocio Paqueteria, debe capturar Todos los datos del apartado Datos de Recolección.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Tipo_pago_Credito_vs_Credit_Limit</fullName>
        <active>false</active>
        <errorConditionFormula>ISPICKVAL(Tippag_cta__c, &quot;Crédito&quot;) &amp;&amp;
ISBLANK(Credit_Limit__c)</errorConditionFormula>
        <errorDisplayField>Credit_Limit__c</errorDisplayField>
        <errorMessage>Ha seleccionado Tipo de Pago = Credito, debe capturar el campo Credit Limit</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Tipo_pago_Credito_vs_Credit_Terms</fullName>
        <active>false</active>
        <errorConditionFormula>ISPICKVAL(Venta_Sap__c, &quot;Credito&quot;) &amp;&amp;
ISPICKVAL(Credit_Terms__c, &quot;&quot;)</errorConditionFormula>
        <errorDisplayField>Credit_Terms__c</errorDisplayField>
        <errorMessage>Ha seleccionado Tipo de Pago = Credito, debe seleccionar los dias de pago en el campo Credit Terms.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_ClienteContactado</fullName>
        <active>false</active>
        <errorConditionFormula>AND( RecordType.Name =&quot;Prospect&quot;,  ISPICKVAL(Estatus_Recuperado__c,&quot;Cliente Contactado&quot;),ISBLANK( NEU_Email__c)) ||
AND( RecordType.Name =&quot;Prospect&quot;,  ISPICKVAL(Estatus_Recuperado__c,&quot;Cliente Contactado&quot;),ISBLANK(  Phone ))||

AND( RecordType.Name =&quot;Prospect&quot;,  ISPICKVAL(Estatus_Recuperado__c,&quot;Cliente Visitado&quot;),ISBLANK( NEU_Email__c)) ||
AND( RecordType.Name =&quot;Prospect&quot;,  ISPICKVAL(Estatus_Recuperado__c,&quot;Cliente Visitado&quot;),ISBLANK(  Phone ))</errorConditionFormula>
        <errorMessage>Si es Cliente Contactado o Visitado debe llenar los campos</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Mkt_Chat</fullName>
        <active>true</active>
        <errorConditionFormula>AND( $Profile.Name = &quot;MKT SALESCLOUD&quot;,ISPICKVAL( AccountSource, &quot;MKT - Web - Chat&quot;),  Numero_de_Chat__c = &quot;&quot;)</errorConditionFormula>
        <errorDisplayField>Numero_de_Chat__c</errorDisplayField>
        <errorMessage>DEBES CAPTURAR EL NUMERO DE CHAT</errorMessage>
    </validationRules>
