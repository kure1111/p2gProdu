    <validationRules>
        <fullName>AW_Status_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Shipment_Type__c = &quot;AW&quot;,
ISPICKVAL( Air_Shipment_Status__c ,&quot;Closed&quot;),

NOT(
OR(
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$Profile.Id = &quot;00e4T000000lL6SQAU&quot;,
$Profile.Id = &quot;00e4T000000lLOrQAM&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;,
$Profile.Id = &quot;0054T000000cUdfQAE&quot;
)
),
OR(
ISCHANGED(Air_Shipment_Status__c ),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ) ,
ISCHANGED(Total_Services_Sell_Amount_number__c)
)

)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>A_Status_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL( Air_Shipment_Status__c ,&quot;Closed&quot;),
Shipment_Type__c = &quot;A&quot;,

NOT(
OR(
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$Profile.Id = &quot;00e4T000000lL6SQAU&quot;,
$Profile.Id = &quot;00e4T000000lLOrQAM&quot;,
$Profile.Id = &quot;00eRQ000002po6XYAQ&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;
)
),
OR(
ISCHANGED(Air_Shipment_Status__c ),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ) ,
ISCHANGED(Total_Services_Sell_Amount_number__c)
)
)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>BloquearRegistro</fullName>
        <active>false</active>
        <description>Solo System Admin, perfiles de: José Gamba, Manuel Sanchez, Alejandro Santibañez, Maribel Esquivel, y roles de Seidy Lopez, Jorge Lopez, Ricardo Ayala y Gabriela Arroyo, pueden quitar el checkbox del campo estatus closed.</description>
        <errorConditionFormula>AND(
 ISCHANGED(Estatus_Cerrado__c),
 PRIORVALUE(Estatus_Cerrado__c) = true,
NOT(  

OR(
 $Profile.Id = &quot;00e4T000000zD9C&quot;,
 $Profile.Id = &quot;00e4T000000lLOX&quot;,
 $Profile.Id = &quot;00e4T000000lKYA&quot;,
 $Profile.Id = &quot;00e4T000000lLOh&quot;,
 $Profile.Id = &quot;00e4T000000lKYF&quot;,
 $Profile.Id = &quot;00e4T000000lLNU&quot;,
 $Profile.Id = &quot;00e4T000000lLLx&quot;,
 $UserRole.Id = &quot;00E4T000000ga6b&quot;,
 $UserRole.Id = &quot;00E4T000000ga6D&quot;,
 $UserRole.Id = &quot;00E4T000000ga6B&quot;
        )
)
)</errorConditionFormula>
        <errorMessage>No se puede modificar el estatus, ya que esto fue cerrado. Favor de hablar con el director comercial que te corresponda.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Bloquear_Asunto_Cita</fullName>
        <active>true</active>
        <description>Evita que el check Asunto/Cita se desmarque después de activarse.</description>
        <errorConditionFormula>OR(
     AND( Asunto_Cita__c = FALSE,
          NOT(ISNULL( Fecha_Asunto_Cita__c ))
     ),
     AND( Asunto_Cita__c = FALSE,
          ISNULL(PRIORVALUE( Fecha_Asunto_Cita__c )) &lt;&gt; TRUE
     )
)</errorConditionFormula>
        <errorDisplayField>Asunto_Cita__c</errorDisplayField>
        <errorMessage>No puede desmarcarse una vez activado.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Bloquear_Devolucion</fullName>
        <active>true</active>
        <description>Evita que el check Devolución se desmarque después de activarse.</description>
        <errorConditionFormula>OR(
       AND( Devolucion__c = FALSE,
            NOT(ISNULL( Inicio_Devolucion_Fecha__c ))
       ),
       AND( Devolucion__c = FALSE,
            ISNULL(PRIORVALUE( Inicio_Devolucion_Fecha__c )) &lt;&gt; TRUE
       )
)</errorConditionFormula>
        <errorDisplayField>Devolucion__c</errorDisplayField>
        <errorMessage>No puede desmarcarse una vez activado.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Bloquear_Recuperacion_Mercancia</fullName>
        <active>true</active>
        <description>Evita que el check Recuperación de mercancía se desmarque después de activarse.</description>
        <errorConditionFormula>OR(
     AND( Recuperacion_de_mercancia__c = FALSE,
          NOT(ISNULL( Fecha_recuperacion_de_mercancia__c ))
     ),
     AND( Recuperacion_de_mercancia__c = FALSE,
          ISNULL(PRIORVALUE( Fecha_recuperacion_de_mercancia__c )) &lt;&gt; TRUE
     )
)</errorConditionFormula>
        <errorDisplayField>Recuperacion_de_mercancia__c</errorDisplayField>
        <errorMessage>No puede desmarcarse una vez activado</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Bloqueo_OperadorNoValido</fullName>
        <active>false</active>
        <errorConditionFormula>AND(NOT(ISNULL( National_Operator__c )),  National_Operator__r.Operador_Validado__c = FALSE)</errorConditionFormula>
        <errorDisplayField>National_Operator__c</errorDisplayField>
        <errorMessage>PP-002: ESTE OPERADOR NO ES VALIDO</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Bloqueo_VehiculoNoValido</fullName>
        <active>false</active>
        <errorConditionFormula>AND(NOT(ISNULL( Vehicle__c )),  Vehicle__r.Vehiculo_Validado__c = FALSE)</errorConditionFormula>
        <errorDisplayField>Vehicle__c</errorDisplayField>
        <errorMessage>PP-001: ESTE VEHICULO NO ESTA VALIDADO</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CE_BloqAirShipmentStatus</fullName>
        <active>true</active>
        <description>Regla que bloquea la actualización del campo &apos;Air Shipment Status&apos; cuando el campo &apos;Realización CE Status&apos; tiene un valor inferior a &quot;Recolección&quot;</description>
        <errorConditionFormula>AND(
 NOT(BEGINS( Name, &apos;SP-CE&apos;)),
 ISPICKVAL(Freight_Mode__c, &apos;Air&apos;),
 OR(
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Alta Cliente AA&apos;),
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Clasificación Arancelaria&apos;),
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Realización de Facturas&apos;)
 ),
 OR(
  ISPICKVAL( Air_Shipment_Status__c, &apos;Contact with Origin&apos;),
  ISPICKVAL( Air_Shipment_Status__c, &apos;Pickup and Delivery to Airline&apos;),
  ISPICKVAL( Air_Shipment_Status__c, &apos;Documentation&apos;),
  ISPICKVAL( Air_Shipment_Status__c, &apos;Flight Confirmation&apos;),
  ISPICKVAL( Air_Shipment_Status__c, &apos;Layover&apos;),
  ISPICKVAL( Air_Shipment_Status__c, &apos;Arrival Confirmation&apos;),
  ISPICKVAL( Air_Shipment_Status__c, &apos;Pending with Customs Broker&apos;),
  ISPICKVAL( Air_Shipment_Status__c, &apos;Final Delivery&apos;),
  ISPICKVAL( Air_Shipment_Status__c, &apos;Finish&apos;),
  ISPICKVAL( Air_Shipment_Status__c, &apos;Consigness Notification&apos;)
 )
)</errorConditionFormula>
        <errorDisplayField>Air_Shipment_Status__c</errorDisplayField>
        <errorMessage>CE-ASS-001: No se puede cambiar &quot;Air Shipment Status&quot; a esta etapa cuando no se ha confirmado la &apos;Recolección&apos; por Comercio Exterior</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CE_BloqOceanExpoShipmentStatus</fullName>
        <active>true</active>
        <description>Regla que bloquea la actualización del campo &apos;Ocean Expo Shipment Status&apos; cuando no se ha confirmado la &apos;Recolección&apos; por Comercio Exterior</description>
        <errorConditionFormula>AND(
 NOT(BEGINS( Name, &apos;SP-CE&apos;)),
 ISPICKVAL(Freight_Mode__c, &apos;Sea&apos;),
 OR(
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Alta Cliente AA&apos;),
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Clasificación Arancelaria&apos;),
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Realización de Facturas&apos;)
 ),
 OR(
  ISPICKVAL( Shipment_Status__c, &apos;Pending but Pre-Captured&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Booking Confirmation&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Planned for delivery - Not yet on route&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Captured but not yet sent EDI&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Pending - Missing Documents/Instructions&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Submitted to Customs&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Cleared but Awaiting Vessel&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Delivered&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Cleared but Stopped&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Delivered to Depot&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;ETA -15&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;ETA -10&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;ETA -7&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;ETA -4&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;In Progress&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;TLX Confirmation&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Delivery On route&apos;),
  ISPICKVAL( Shipment_Status__c, &apos;Finished&apos;)
 )
)</errorConditionFormula>
        <errorDisplayField>Shipment_Status__c</errorDisplayField>
        <errorMessage>CE-OESS-001: No se puede cambiar &quot;Ocean Expo Shipment Status&quot; a esta etapa cuando no se ha confirmado la &apos;Recolección&apos; por Comercio Exterior</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CE_BloqOceanImpoShipmentStatus</fullName>
        <active>true</active>
        <description>Regla que bloquea la actualización del campo &apos;Ocean Impo Shipment Status&apos; cuando el campo &apos;Realización CE Status&apos; tiene un valor inferior a &quot;Recolección&quot;</description>
        <errorConditionFormula>AND(
 NOT(BEGINS( Name, &apos;SP-CE&apos;)),
 ISPICKVAL(Freight_Mode__c, &apos;Sea&apos;),
 OR(
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Alta Cliente AA&apos;),
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Clasificación Arancelaria&apos;),
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Realización de Facturas&apos;)
 ),
 OR(
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;Booking Confirmation&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;Pickup Confirmation&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;Documents&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;ETD&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;ETA-15&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;ETA-10&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;ETA-7&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;ETA-4&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;ETA&apos;),
