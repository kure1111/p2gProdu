 IF(ISPICKVAL(Rating_Monitoreo__c,&apos;Average&apos;), IMAGE(&quot;https://pak2go--c.eu17.content.force.com/servlet/servlet.FileDownload?file=0151v0000033m3Y&quot;,&apos;Average&apos;),
  IF(ISPICKVAL(Rating_Monitoreo__c,&apos;Good&apos;),IMAGE(&quot;https://pak2go--c.eu17.content.force.com/servlet/servlet.FileDownload?file=0151v0000033m3d&quot;,&apos;Good&apos;),
