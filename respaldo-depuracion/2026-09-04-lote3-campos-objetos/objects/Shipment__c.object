    <validationRules>
        <fullName>Only_Warehouse_Service_Freight_Mode</fullName>
        <active>true</active>
        <description>Freight Mode is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</description>
        <errorConditionFormula>AND(Only_Warehouse_Service__c == false, ISBLANK(TEXT(Freight_Mode__c)))</errorConditionFormula>
        <errorDisplayField>Freight_Mode__c</errorDisplayField>
        <errorMessage>Freight Mode is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Only_Warehouse_Service_Service_Mode</fullName>
        <active>true</active>
        <description>Service Mode is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</description>
        <errorConditionFormula>AND(Only_Warehouse_Service__c == false, ISBLANK(TEXT(Service_Mode__c)))</errorConditionFormula>
        <errorDisplayField>Service_Mode__c</errorDisplayField>
        <errorMessage>Service Mode is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Only_Warehouse_Service_Service_Type</fullName>
        <active>true</active>
        <description>Service Type is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</description>
        <errorConditionFormula>AND(Only_Warehouse_Service__c == false, ISBLANK(TEXT(Service_Type__c)))</errorConditionFormula>
        <errorDisplayField>Service_Type__c</errorDisplayField>
        <errorMessage>Service Type is required if &quot;Only Warehouse Service&quot; isn&apos;t checked</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PQ_Status_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Shipment_Type__c = &quot;PQ&quot;,
ISPICKVAL( Shipment_Status_Plann__c ,&quot;Closed&quot;),

NOT(
OR(
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;,
$UserRole.Name= &quot;Gerente Comercial&quot;,
$User.Username = &quot;alexis.villanueva@pak2go.com&quot;
)),
OR(
ISCHANGED(Shipment_Status_Plann__c),
ISCHANGED(Shipment_Status_Mon__c),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ) ,
ISCHANGED(Total_Services_Sell_Amount_number__c)
)
)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PTO_status_closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Shipment_Type__c = &quot;PTO&quot;,
ISPICKVAL(Shipment_Status_Plann__c,&quot;Closed&quot;),

NOT(
OR(
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$Profile.Id = &quot;00e4T000000lL6SQAU&quot;,
$Profile.Id = &quot;00e4T000000lLOrQAM&quot;,
$Profile.Id =&quot;00eRQ000002po6X&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;
)
),
OR(
ISCHANGED(Shipment_Status_Plann__c),
ISCHANGED(Shipment_Status_Mon__c),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ) ,
ISCHANGED(Total_Services_Sell_Amount_number__c)
)
)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ProveedorVetado</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
$Profile.Id &lt;&gt; &quot;00e4T000000zD9C&quot;,
OR(
Carrier__r.SCPVetado__c = true,
 Carrier__r.ActiveSap__c = false
)
)</errorConditionFormula>
        <errorMessage>El proveedor que se eligió esta vetado o inactivo.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>R_Status_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Shipment_Type__c = &quot;R&quot;,
OR(
ISPICKVAL( Routing_Operation_Status__c,&quot;Closed&quot;),
ISPICKVAL( Ocean_Shipment_Status__c,&quot;Closed&quot;)
),
NOT(
OR(
BEGINS($Profile.Id, &quot;00eRQ000002po6X&quot;),
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$Profile.Id = &quot;00e4T000000lL6SQAU&quot;,
$Profile.Id = &quot;00e4T000000lLOrQAM&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;,
$Profile.Id = &quot;0054T000000cUdfQAE&quot;
)
),
OR(
ISCHANGED(Routing_Operation_Status__c),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ) ,
ISCHANGED(Total_Services_Sell_Amount_number__c)
)

)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reason_for_declined_requerido</fullName>
        <active>true</active>
        <description>Solicita un valor para el campo Reason for declined, cuando el campo Declined_for__c tiene seleccionada cualquiera de sus opciones.</description>
        <errorConditionFormula>if(
 OR(
 ISPICKVAL( Declined_for__c, &apos;Disponibilidad&apos;),
 ISPICKVAL( Declined_for__c, &apos;Falla operativa&apos;),
 ISPICKVAL( Declined_for__c, &apos;Error de captura&apos;),
 ISPICKVAL( Declined_for__c, &apos;Cancelación de cliente&apos;) 
 ),

 Reason_for_declined__c = &apos;&apos;, null
)</errorConditionFormula>
        <errorDisplayField>Reason_for_declined__c</errorDisplayField>
        <errorMessage>ERROR: Es necesario colocar la razón por la cual se declinó</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Requiere_barras_logisticas</fullName>
        <active>true</active>
        <description>El llenado de esta campo requiere que cuente con el campo de carrier lleno</description>
        <errorConditionFormula>AND(
Requiere_barras_logisticas__c = TRUE,
ISBLANK(Carrier__c)
)</errorConditionFormula>
        <errorDisplayField>Requiere_barras_logisticas__c</errorDisplayField>
        <errorMessage>El campo Carrier es obligatorio cuando se marca Requiere barras logísticas</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SHP002_MotivoDeDevolucion</fullName>
        <active>true</active>
        <errorConditionFormula>AND(

OR ( ISPICKVAL (Causante_de_Devoluci_n__c, &quot;Cliente&quot; ),
ISPICKVAL (Causante_de_Devoluci_n__c, &quot;Proveedor&quot;)) ,

TEXT( Motivo_de__c ) &lt;&gt; &quot;Daño de Mercancía&quot; ,
TEXT(Motivo_de__c) &lt;&gt; &quot;Faltante de Origen&quot; ,
TEXT(Motivo_de__c) &lt;&gt; &quot;Excedente de Mercancía&quot; ,
TEXT(Motivo_de__c) &lt;&gt; &quot;Códigos Erróneos&quot; ,
TEXT(Motivo_de__c) &lt;&gt; &quot;Rechazos&quot;


)</errorConditionFormula>
        <errorDisplayField>Motivo_de__c</errorDisplayField>
        <errorMessage>SHP002_Falta llenar campo</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SHP003_SP_en_Confirmed_con_Service_Line</fullName>
        <active>false</active>
        <description>Estatus Confirmed solo con Service Line asociadas al Shipment</description>
        <errorConditionFormula>AND(
				 ISPICKVAL(Shipment_Status_Plann__c, &apos;Confirmed&apos; ),
				Shipment_Sin_Serv_Lines__c = TRUE
				)</errorConditionFormula>
        <errorMessage>SHP003 - No es posible pasar al estaus de Confirmed sin tener Service Line asociadas al Shipment</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SP_Delivery_on_Route</fullName>
        <active>false</active>
        <description>Regla que impide cambiar el &quot;Shipment Status Planner&quot; al valor &apos;Delivery On Route&apos; en los servicios FN, FI, y PTO. Solo se podrá si el &quot;Shipment Status Monitoreo&quot; tiene seleccionada la opción &apos;Delivery on Route&apos;.</description>
        <errorConditionFormula>AND(
 ISPICKVAL(Shipment_Status_Plann__c,&apos;Delivery On Route&apos;),
 NOT(ISPICKVAL(Shipment_Status_Mon__c, &apos;Delivery on Route_M&apos;))
)</errorConditionFormula>
        <errorDisplayField>Shipment_Status_Plann__c</errorDisplayField>
        <errorMessage>SP-DR-001: No es posible cambiar a &apos;Delivery On Route&apos; hasta que el &quot;Shipment Status Monitoreo&quot; tenga seleccionada la opción &apos;Delivery on Route&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Shipment_Number</fullName>
        <active>true</active>
        <errorConditionFormula>AND(PRIORVALUE(Name) != &apos;&apos;, ISCHANGED(Name))</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>You can&apos;t edit the Shipment Number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Status_Planner_Cancel</fullName>
        <active>false</active>
        <errorConditionFormula>IF(ISPICKVAL( Shipment_Status_Plann__c,&quot;Cancel&quot;),
Cancelled_by__c = &quot;&quot;, null)</errorConditionFormula>
        <errorDisplayField>Cancelled_by__c</errorDisplayField>
        <errorMessage>ERROR: 
Choose a reason for cancellation</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>T_Status_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Shipment_Type__c = &quot;T&quot;,
ISPICKVAL( Shipment_Status_Plann__c ,&quot;Closed&quot;),

NOT(
OR(
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;,
$UserRole.Name= &quot;Gerente Comercial&quot;,
$User.Username = &quot;alexis.villanueva@pak2go.com&quot;
)
),
OR(
ISCHANGED(Shipment_Status_Plann__c),
ISCHANGED(Shipment_Status_Mon__c),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ) ,
ISCHANGED(Total_Services_Sell_Amount_number__c)
)
)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Ubicaciones_validadas</fullName>
        <active>true</active>
        <description>Validar que las ubicaciones de origen y de destino estén validadas antes de cambiar el estatus del shipment.</description>
        <errorConditionFormula>AND(
    CONTAINS( Name , &quot;SP-FN&quot;),
    OR(
        ISCHANGED( Shipment_Status_Plann__c ),
        ISCHANGED( Shipment_Status_Mon__c )
    ),
    OR(
        NOT(AND( Account_Destination_Address__r.Active__c  = TRUE, ISPICKVAL( Account_Destination_Address__r.status__c , &quot;Validado&quot;))),
        NOT(AND( Account_Origin_Address__r.Active__c  = TRUE, ISPICKVAL( Account_Origin_Address__r.status__c , &quot;Validado&quot;)))
    )
)</errorConditionFormula>
        <errorMessage>GS-001 &quot;Para hacer cualquier movimiento en el Shipment se requiere que agregues ubicaciones validadas, REVISA TUS ORIGENES y DESTINOS&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Unique_name</fullName>
        <active>true</active>
        <description>Nombre unico</description>
        <errorConditionFormula>AND(
  CONTAINS(
      VLOOKUP( 
        $ObjectType.Shipment__c.Fields.Name , 
        $ObjectType.Shipment__c.Fields.Name, Name
      ), 
      Name
    ), 
  OR(
      ISNEW(), ISCHANGED(Name)
    ) 
  )</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Este shipment ya existe</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VALIDATION_ATD</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL( Shipment_Status_Plann__c, &quot;In Progress&quot;) &amp;&amp; 
 ISBLANK(ATD__c)</errorConditionFormula>
        <errorDisplayField>ATA__c</errorDisplayField>
        <errorMessage>Insert ATA and ATD
Insertar  campos ATA Y ATD</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_AMS_Impo</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
OR( 
ISPICKVAL( Ocean_Shipment_Status__c,&quot;ETA-7&quot;), 
ISPICKVAL( Ocean_Shipment_Status__c,&quot;ETA-4&quot;), 
ISPICKVAL( Ocean_Shipment_Status__c,&quot;ETA&quot;), 
ISPICKVAL( Ocean_Shipment_Status__c,&quot;Telex Confirmation&quot;), 
ISPICKVAL( Ocean_Shipment_Status__c,&quot;Customs Clearance&quot;), 
ISPICKVAL( Ocean_Shipment_Status__c,&quot;Final Delivery&quot;) 
), 
ISBLANK( AMS__c ) )</errorConditionFormula>
        <errorMessage>AMS field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Confirmed_VerifyPak</fullName>
        <active>false</active>
        <errorConditionFormula>ShipmentService__c = &quot;SP-FN&quot; &amp;&amp; 
ISPICKVAL(Shipment_Status_Plann__c,&quot;Confirmed&quot;)&amp;&amp;
 VERIFY_PAK_CONTROL__c =False</errorConditionFormula>
        <errorDisplayField>VERIFY_PAK_CONTROL__c</errorDisplayField>
        <errorMessage>ERROR: Must be Confirmed by Pak Control</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Date_time_Finished_monitoreo</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
   AND(
       CONTAINS(Name, &quot;FN&quot;),
       NOT(ISBLANK(Date_time_FN_Finished__c)),
       ISCHANGED(Date_time_FN_Finished__c),
       NOT(CONTAINS($Profile.Name,&quot;Admin&quot;))
       ),
    AND(
       NOT(CONTAINS(Name , &quot;FN&quot;)),
       NOT(ISBLANK(PRIORVALUE(Date_time_FN_Finished__c))),
       ISCHANGED(Date_time_FN_Finished__c)
       )
  )</errorConditionFormula>
        <errorMessage>No se puede modificar la fecha Date time Finished monitoreo</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Declined_with_reasons_Shipment</fullName>
        <active>false</active>
        <errorConditionFormula>ISPICKVAL( Cancelled_by__c, &quot;Operaciones&quot; )&amp;&amp;
ISPICKVAL( Declined_for__c , &quot;&quot;) &amp;&amp;
CONTAINS(Name, &quot;FN&quot;)</errorConditionFormula>
        <errorDisplayField>Declined_for__c</errorDisplayField>
        <errorMessage>Se debe tener una razón cuando se cancela por operaciones.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_FNFI_operationstime</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL( Shipment_Status_Mon__c,&quot;Finished&quot;),   ISNULL(Equip_Placed__c)||
 ISNULL(Equip_Loaded__c)|| 
  ISNULL(Departure_Time__c)|| 
   ISNULL(Equip_Reserved__c)|| 
    ISNULL(Equip_Solicited__c)||
      ISNULL(Equip_Unloaded__c))</errorConditionFormula>
        <errorMessage>NO puede ser &quot;Finalizado&quot; sin completar la seccion ROUTE &amp; SCHEDULE</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Free_Days_ETA_10</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISPICKVAL(Ocean_Shipment_Status__c,&quot;ETA-10&quot;), 
   ISBLANK( Free_Days__c ))</errorConditionFormula>
        <errorMessage>Select &quot;Free Days&quot; if Ocean Impo Status is &quot;ETA - 10&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Operator_Status_In_Progress</fullName>
        <active>true</active>
        <errorConditionFormula>ShipmentService__c = &quot;SP-FN&quot; &amp;&amp; 
ISPICKVAL( Shipment_Status_Plann__c,&quot;In Progress&quot; ) &amp;&amp;
National_Operator__c = NULL</errorConditionFormula>
        <errorDisplayField>National_Operator__c</errorDisplayField>
        <errorMessage>ERROR: Must be Choose  OPERATOR, VEHICULE AND CARRIER
(Debes de capturar el Proveedor, Vehiculo y Conductor)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Pak_Control_Planner</fullName>
        <active>false</active>
        <errorConditionFormula>VERIFY_PAK_CONTROL__c = true  &amp;&amp;    Operation_Executive__c  = &quot;&quot;</errorConditionFormula>
        <errorDisplayField>Operation_Executive__c</errorDisplayField>
        <errorMessage>ERROR..! Must be select a Planner</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Pak_Control_Vehicle</fullName>
        <active>true</active>
        <errorConditionFormula>ShipmentService__c = &quot;SP-FN&quot; &amp;&amp;
VERIFY_PAK_CONTROL__c = true  &amp;&amp;    Vehicle__c  = &quot;&quot;</errorConditionFormula>
        <errorDisplayField>Vehicle__c</errorDisplayField>
        <errorMessage>ERROR..! Must be select a Vehicle (Vehiculo). Una vez confirmado el vehículo es requerido</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Pak_Control_operator</fullName>
        <active>true</active>
        <errorConditionFormula>ShipmentService__c = &quot;SP-FN&quot; &amp;&amp;
VERIFY_PAK_CONTROL__c = true  &amp;&amp;   National_Operator__c = &quot;&quot;</errorConditionFormula>
        <errorDisplayField>National_Operator__c</errorDisplayField>
        <errorMessage>ERROR..! Must be select a Operator (operador), Una vez confirmado el operador es requerido</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Rating</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL( Shipment_Status_Mon__c,&apos;Finished&apos;), 
 ISPICKVAL( Rating__c ,&apos;&apos;),
  $Profile.Id = &apos;00e0Y000000ZMMv&apos;
)</errorConditionFormula>
        <errorDisplayField>Rating__c</errorDisplayField>
        <errorMessage>***Si el Embarque esta Finalizado favor de Calificar el Servicio***</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Rating_Modify</fullName>
        <active>false</active>
        <errorConditionFormula>SP_Evaluated__c  = TRUE</errorConditionFormula>
        <errorMessage>No puedes volver a Evaluar el Embarque</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Rating_Ok</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL( Rating__c, &apos;Poor&apos;),SP_Evaluated__c = True)||
AND(
ISPICKVAL( Rating__c, &apos;Average&apos;),SP_Evaluated__c = True)||
AND(
ISPICKVAL( Rating__c, &apos;Good&apos;),SP_Evaluated__c = True)||
AND(
ISPICKVAL( Rating__c, &apos;Very Good&apos;),SP_Evaluated__c = True)||
AND(
ISPICKVAL( Rating__c, &apos;Excellent&apos;),SP_Evaluated__c = True)</errorConditionFormula>
        <errorDisplayField>Rating__c</errorDisplayField>
        <errorMessage>Este Shipment ya ha sido Evaluado</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Shipment_Evaluate</fullName>
        <active>true</active>
        <description>***Si el Embarque esta Finalizado favor de Calificar el Servicio***</description>
        <errorConditionFormula>IF( Account_for__r.Workplace_AccOwner__c ==&apos;GDL&apos;,

AND(
ISPICKVAL( Shipment_Status_Mon__c,&apos;Finished&apos;), 
ISPICKVAL( Rating__c ,&apos;&apos;),
$Profile.Id = &apos;00e0Y000000ZMMv&apos;
), NULL)</errorConditionFormula>
        <errorDisplayField>Rating__c</errorDisplayField>
        <errorMessage>***Si el Embarque esta Finalizado favor de Calificar el Servicio***</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Vehicule_Status_In_Progress</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
ShipmentService__c = &quot;SP-FI&quot;,
ShipmentService__c = &quot;SP-FN&quot;,
ShipmentService__c = &quot;SP-PT&quot;
)&amp;&amp;
ISPICKVAL( Shipment_Status_Plann__c,&quot;Confirmed&quot; ) &amp;&amp; 
Country_of_Discharge__c  = &quot;Mexico&quot;  &amp;&amp; 
Country_of_Load__c = &quot;Mexico&quot;  &amp;&amp;
ISBLANK(Vehicle__c )</errorConditionFormula>
        <errorDisplayField>Vehicle__c</errorDisplayField>
        <errorMessage>ERROR: Must be Choose  OPERATOR, VEHICULE AND CARRIER
(Debes de capturar el Proveedor, Vehiculo y Conductor)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_date_planner_confirmed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(PRIORVALUE(Date_Planner_Confirmed__c))),ISCHANGED(Date_Planner_Confirmed__c))</errorConditionFormula>
        <errorMessage>no se puede modificar la fecha date planner confirmed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validation_ATA</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL( Shipment_Status_Plann__c, &quot;In Progress&quot;) &amp;&amp; 
ISBLANK(ATA__c)</errorConditionFormula>
        <errorDisplayField>ATA__c</errorDisplayField>
        <errorMessage>Insert ATA and ATD 
Insertar campos ATA Y ATD</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>WH_Status_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Shipment_Type__c = &quot;WH&quot;,
ISPICKVAL( Air_Shipment_Status__c ,&quot;Closed&quot;),

NOT(
OR(
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;
)
),
OR(
ISCHANGED(Air_Shipment_Status__c ),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ) ,
ISCHANGED(Total_Services_Sell_Amount_number__c)
)

)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>W_Status_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Shipment_Type__c = &quot;W&quot;,
ISPICKVAL( Shipment_Status__c,&quot;Closed&quot;),
NOT(
OR(
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;,
$Profile.Id = &quot;0054T000000cUdfQAE&quot;
)
),
OR(
ISCHANGED(Shipment_Status__c),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ) ,
ISCHANGED(Total_Services_Sell_Amount_number__c)
)
)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>valida_credito_new_sp</fullName>
        <active>false</active>
        <description>Valida si la cuenta tiene credito diponible, sps nuevos</description>
        <errorConditionFormula>AND 
(
ISPICKVAL( Account_for__r.Venta_Sap__c , &quot;Credito&quot;), 
( Account_for__r.Saldo_DisponibleOK__c +  Total_Services_Sell_Amount__c ) &lt;= 0,
 isnew()

)</errorConditionFormula>
        <errorMessage>Cliente sin crédito disponible</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>valida_cuenta_credito</fullName>
        <active>true</active>
        <description>Valida si la nueva cuenta con credito</description>
        <errorConditionFormula>AND 
(
 Ischanged(Account_for__c),
ISPICKVAL( Account_for__r.Venta_Sap__c , &quot;Credito&quot;), 
 Account_for__r.Saldo_DisponibleOK__c &lt;  Total_Services_Sell_Amount__c 

)</errorConditionFormula>
        <errorMessage>Cliente sin crédito disponible</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>validate_Date_Verify_PakControl</fullName>
        <active>true</active>
        <errorConditionFormula>AND(NOT(ISBLANK(PRIORVALUE(Date_Verify_PakControlTxt__c))),ISCHANGED(Date_Verify_PakControlTxt__c))</errorConditionFormula>
        <errorMessage>no se puede modificar la fecha Date Verify PakControl</errorMessage>
    </validationRules>
