        <fullName>Loading_Time_Hours__c</fullName>
        <description>Difference between &quot;Equip. Loaded&quot; and &quot;Equip. Placed&quot;</description>
        <externalId>false</externalId>
        <formula>IF(ISNULL(Equip_Loaded__c), ( NOW() - Equip_Placed__c) * 24, ( Equip_Loaded__c  -  Equip_Placed__c )*24)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
