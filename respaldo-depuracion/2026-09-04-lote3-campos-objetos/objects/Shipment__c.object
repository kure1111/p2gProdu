        <externalId>false</externalId>
        <label>OI ATAPOD</label>
        <length>30</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ATA_ETA_notification__c</fullName>
        <externalId>false</externalId>
        <formula>AND(

ShipmentService__c = &quot;SP-FN&quot;,
ISPICKVAL(Shipment_Status_Plann__c, &quot;In Progress&quot;),

OR(
DATEVALUE(ATA__c) &lt;&gt; ETA_Point_of_Discharge__c,
DATEVALUE(ATD__c) &lt;&gt; ETD_from_Point_of_Load__c


)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ATA &lt; ETA notification</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
