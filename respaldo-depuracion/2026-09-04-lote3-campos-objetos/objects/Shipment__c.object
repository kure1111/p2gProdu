        <formula>(ATA__c - IF(ISBLANK(Departure_from_D__c) == FALSE, Departure_from_D__c, IF(ISBLANK(Departure_from_C__c) == FALSE, Departure_from_C__c, IF(ISBLANK(Departure_from_B__c) == FALSE, Departure_from_B__c, ATD__c))))*24</formula>
