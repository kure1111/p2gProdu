    <fields>
        <fullName>Stopping_Time_B_Hours__c</fullName>
        <description>Difference between &quot;Departure from B&quot; and &quot;Arrival to B&quot;</description>
        <externalId>false</externalId>
        <formula>( Departure_from_B__c  -  Arrival_to_B__c ) * 24</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Difference between &quot;Departure from B&quot; and &quot;Arrival to B&quot;</inlineHelpText>
        <label>Stopping Time (B) (Hours)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Stopping_Time_C_Hours__c</fullName>
        <externalId>false</externalId>
        <formula>( Departure_from_C__c  -  Arrival_to_C__c ) * 24</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Departure from C - Arrival to C</inlineHelpText>
