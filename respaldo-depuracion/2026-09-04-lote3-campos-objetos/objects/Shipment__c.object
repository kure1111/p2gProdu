  ISPICKVAL( Ocean_Shipment_Status__c, &apos;Customs Clearences&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;Final Delivery&apos;),
  ISPICKVAL( Ocean_Shipment_Status__c, &apos;Finished&apos;),
