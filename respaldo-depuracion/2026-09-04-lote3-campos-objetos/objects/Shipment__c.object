    <fields>
        <fullName>SPGasto_Operativo_Directo__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  ShipmentService__c  = &quot;SP-FN&quot;, 
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;) , 972,1087), 
IF( ShipmentService__c = &quot;SP-FI&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;FTL&quot;), 
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;) , 805,701), 
IF( ShipmentService__c = &quot;SP-A-&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;CARGA&quot;), 
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;) , 1831,2423), 
IF( ShipmentService__c = &quot;SP-M-&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;FCL&quot;), 
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;) , 1689,2741), 
IF( ShipmentService__c = &quot;SP-PQ&quot;, 
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;) , 940,895), 
IF( ShipmentService__c = &quot;SP-FI&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;LTL&quot;),
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 823,810),
IF( ShipmentService__c = &quot;SP-A&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;PAQUETERIA&quot;),
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 768,804),
IF( ShipmentService__c = &quot;SP-M&quot; &amp;&amp; ISPICKVAL(Service_Type__c,&quot;LCL&quot;),
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 483,3196),
IF( ShipmentService__c = &quot;SP-PT&quot;,
IF( ISPICKVAL(Account_for__r.Sitprov_cta__c,&quot;Tarifario&quot;), 1353,1174), 
NULL)
))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Gasto Operativo Directo</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>SPMargen_Operativo__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Total_Services_Sell_Amount__c  = 0, 
0, 
(Total_Services_Sell_Amount__c -  Total_Services_Std_Buy_Amount__c  -  SPGasto_Operativo_Directo__c  ) / Total_Services_Sell_Amount__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Margen Operativo %</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackHistory>false</trackHistory>
        <type>Percent</type>
