    <fields>
        <fullName>Workplace_Account_Owner__c</fullName>
        <externalId>false</externalId>
        <formula>Account_for__r.Owner.Workplace__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Workplace Account Owner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Workplace_PlannerFN__c</fullName>
        <externalId>false</externalId>
        <formula>Operation_Executive__r.Workplace__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Workplace Planner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Zona_de_planner__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(Operation_Executive__r.Workplace__c), &quot;None&quot;,

CASE(Operation_Executive__r.Workplace__c, &quot;MEX&quot;, &quot;Centro&quot;, &quot;PUE&quot;, &quot;Centro&quot;, &quot;VER&quot;, &quot;Centro&quot;, &quot;MXS&quot;, &quot;Centro&quot;, &quot;TOL&quot;, &quot;Centro&quot;, &quot;VRZ&quot;, &quot;Centro&quot;,

CASE(Operation_Executive__r.Workplace__c, &quot;MTY&quot;, &quot;Norte&quot;, &quot;SAL&quot;, &quot;Norte&quot;, &quot;TOR&quot;, &quot;Norte&quot;, &quot;CORP&quot;, &quot;Norte&quot;,

CASE(Operation_Executive__r.Workplace__c, &quot;LEO&quot;, &quot;Centro&quot;, &quot;SLP&quot;, &quot;Centro&quot;, &quot;QUE&quot;, &quot;Centro&quot;, &quot;QRO&quot; ,&quot;Centro&quot;, &quot;GDL&quot;, &quot;Centro&quot;, &quot;QTO&quot;, &quot;Centro&quot;,

CASE(Operation_Executive__r.Workplace__c, &quot;CUU&quot;, &quot;Norte&quot;, &quot;TIJ&quot;, &quot;Norte&quot;, &quot;MXI&quot;, &quot;Norte&quot;, &quot;JUA&quot;, &quot;Norte&quot;, &quot;HER&quot;, &quot;Norte&quot;,

CASE(Operation_Executive__r.Workplace__c, &quot;Global&quot;, &quot;Globales&quot;,

CASE(Operation_Executive__r.Workplace__c, &quot;CCN&quot;,&quot;Cuentas Clave Noreste&quot;,

CASE(Operation_Executive__r.Workplace__c, &quot;CCC&quot;, &quot;Cuentas Clave Centro&quot;,

CASE(Operation_Executive__r.Workplace__c, &quot;CCO&quot;, &quot;Cuentas Clave OCCIDENTE&quot;,

&quot;Otro&quot;)))))))))</formula>
        <label>Zona de planner</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
