        <externalId>false</externalId>
        <formula>CASE(TEXT(Freight_Mode__c), &apos;Sea&apos;, &apos;custom:custom54&apos;, &apos;Air&apos;, &apos;custom:custom20&apos;, &apos;Road&apos;, &apos;custom:custom98&apos;, &apos;custom:custom36&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Mode Lightning</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Mode__c</fullName>
        <description>Animation based on &quot;Freight Mode&quot; selection; if &quot;Freight Mode&quot; = Sea then Ship Image, else if &quot;Freight Mode&quot; = Air then Plane Image, else if &quot;Freight Mode&quot; = Road then Truck Image, else if &quot;Freight Mode&quot; = Rail then Train Image, else if &quot;Freight Mode&quot; = Multimodal then Ship and Train Images</description>
        <externalId>false</externalId>
        <formula>IF(TEXT(Freight_Mode__c) = &apos;Sea&apos;, IMAGE(&apos;/img/icon/custom51_100/ship32.png&apos;, &apos;Sea&apos;), IF(TEXT(Freight_Mode__c) = &apos;Air&apos;, IMAGE(&apos;/img/icon/plane32.png&apos;, &apos;Air&apos;), IF(TEXT(Freight_Mode__c) = &apos;Road&apos;, IMAGE(&apos;/img/icon/custom51_100/truck32.png&apos;, &apos;Road&apos;), IF( TEXT(Freight_Mode__c) = &apos;Rail&apos;, IMAGE(&apos;/img/icon/train32.png&apos;, &apos;Rail&apos;), IF( TEXT(Freight_Mode__c) = &apos;Multimodal&apos;, IMAGE(&apos;/img/icon/custom51_100/ship32.png&apos;, &apos;Multimodal&apos;)&amp; &quot; &quot; &amp; IMAGE(&apos;/img/icon/train32.png&apos;, &apos;Multimodal&apos;) ,&apos;&apos;)))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Mode</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
