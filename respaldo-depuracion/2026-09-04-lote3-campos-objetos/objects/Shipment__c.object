    <fields>
        <fullName>Total_Real_Profit__c</fullName>
        <description>Conversion to currency of difference between &quot;SUM Destination Amount&quot;, &quot;SUM Buy Origin Amount&quot; and &quot;Total Disbursements&quot;</description>
        <externalId>false</externalId>
        <formula>1</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Difference between &quot;SUM Destination Amount&quot;, &quot;SUM Buy Origin Amount&quot; and &quot;Total Disbursements&quot; Currency
SUM_Destination_Amount__c - SUM_Buy_Origin_Amount_number__c - Total_Disbursements_number__c</inlineHelpText>
        <label>Total Disb. Profit</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_Real_Profit_of_Services__c</fullName>
        <description>Conversion to currency of difference between &quot;Total Invoiced (Excl VAT)&quot; and &quot;Total Disbursements (Excl VAT)&quot; if &quot;Total Invoiced (Excl VAT)&quot; greater than 0, else difference between &quot;Total Services Sell Amount&quot; and &quot;Total Disbursements (Excl VAT)&quot;, from Total Disb. Profit of Services Roll-Up</description>
        <externalId>false</externalId>
        <formula>IF(Total_Invoiced_Excl_VAT__c &gt; 0, Total_Invoiced_Excl_VAT__c - Total_Disbursements_Excl_VAT__c, Total_Services_Sell_Amount_number__c - Total_Disbursements_Excl_VAT__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Difference between &quot;Total Invoiced (Excl VAT)&quot; and &quot;Total Disbursements (Excl VAT)&quot;</inlineHelpText>
        <label>Total Disb. Profit of Services</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
