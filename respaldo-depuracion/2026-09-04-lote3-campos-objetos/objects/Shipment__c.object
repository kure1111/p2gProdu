    </validationRules>
    <validationRules>
        <fullName>CE_BloqShipmentStatusPlanner</fullName>
        <active>true</active>
        <description>Regla que bloquea la actualización del campo &apos;Shipment Status Planner&apos; al status &quot;Confirmed&quot; cuando el campo &apos;Realización CE Status&apos; tiene un valor inferior a &quot;Recolección&quot;</description>
        <errorConditionFormula>AND(
 NOT(BEGINS( Name, &apos;SP-CE&apos;)),
 ISPICKVAL(Freight_Mode__c, &apos;Road&apos;),
 OR(
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Alta Cliente AA&apos;),
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Clasificación Arancelaria&apos;),
  ISPICKVAL( Realizacion_CE_Status__c, &apos;Realización de Facturas&apos;)
 ),
 ISPICKVAL(Shipment_Status_Plann__c, &apos;Confirmed&apos;)
)</errorConditionFormula>
        <errorDisplayField>Shipment_Status_Plann__c</errorDisplayField>
        <errorMessage>CE-SSP-001: No se puede cambiar a la etapa &quot;Confirmed&quot; cuando no se ha confirmado la &apos;Recolección&apos; por Comercio Exterior</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CP001FN_Tipo_de_Carta_Porte</fullName>
        <active>true</active>
        <description>Validation Rule, cuando el Shipment sea tipo Flete nacional (FN) / Service Mode = NATIONAL , pida obligatorio el campo Traslado_Ingreso_c</description>
        <errorConditionFormula>AND
(
OR(Shipment_Type__c = &quot;FN&quot;,
Shipment_Type__c = &quot;FI&quot;,
Shipment_Type__c = &quot;PTO&quot;
),
OR(ISPICKVAL( Shipment_Status_Plann__c,&quot;In Progress&quot; ),
ISPICKVAL( Shipment_Status_Plann__c,&quot;Confirmed&quot; )),
ISPICKVAL(Traslado_Ingreso__c, &quot;&quot;),
  YEAR(DATEVALUE (CreatedDate)) &lt; 2022

)</errorConditionFormula>
        <errorDisplayField>Traslado_Ingreso__c</errorDisplayField>
        <errorMessage>CP001: Error /  Must be Choose TIPO CARTA PORTE
(Debes de capturar el tipo de carta porte)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_Reference_Obligatorio</fullName>
        <active>true</active>
        <description>Cambia el campo a ser obligatorio para Shipments de tipo M, R, PTO, CE y FI.</description>
        <errorConditionFormula>AND(
    ISBLANK( TRIM(Account_Shipment_Reference__c) ),
    OR(
       CONTAINS(UPPER( Name),&quot;PTO&quot;),
       CONTAINS(UPPER( Name),&quot;R&quot;),
       CONTAINS(UPPER( Name),&quot;M&quot;),
       CONTAINS(UPPER( Name),&quot;CE&quot;),
       CONTAINS(UPPER( Name),&quot;FI&quot;)
      ),
     NOT(CONTAINS($Profile.Name,&quot;Admin&quot;))
    )</errorConditionFormula>
        <errorMessage>El campo Customer Reference necesita llenarse con la informacion apropiada para continuar.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_Reference_Validation</fullName>
        <active>true</active>
        <description>Regla de validación que se ejecuta cuando el comercial agrega un valor no alfanumérico en el campo Customer Reference.</description>
        <errorConditionFormula>AND(
    REGEX(Account_Shipment_Reference__c, &quot;[&amp;\&quot;&lt;&gt;&apos;]&quot;),
    $User.Id &lt;&gt; &apos;0054T000001iQkX&apos;
)</errorConditionFormula>
        <errorDisplayField>Account_Shipment_Reference__c</errorDisplayField>
        <errorMessage>El campo Customer Reference no puede tener caracteres &amp;\&quot;&lt;&gt;&apos;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Declined_for_requerido</fullName>
        <active>true</active>
        <description>Solicita un valor para el campo Declined for, cuando el campo Cancelled by tiene seleccionada cualquiera de sus opciones.</description>
        <errorConditionFormula>if(
ISPICKVAL( Shipment_Status_Plann__c, &apos;Cancel&apos;),
ISPICKVAL(Declined_for__c, &apos;&apos;), null
)</errorConditionFormula>
        <errorDisplayField>Declined_for__c</errorDisplayField>
        <errorMessage>ERROR CB-001: Es necesario seleccionar un motivo de declinación</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FI_Status_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
Shipment_Type__c = &quot;FI&quot;,
ISPICKVAL(Shipment_Status_Plann__c,&quot;Closed&quot;),

NOT(
OR(
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$Profile.Id = &quot;00e4T000000lL6SQAU&quot;,
$Profile.Id = &quot;00e4T000000lLOrQAM&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;
)
),
OR(
ISCHANGED(Shipment_Status_Plann__c),
ISCHANGED(Shipment_Status_Mon__c),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ) ,
ISCHANGED(Total_Services_Sell_Amount_number__c)
)
)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FN_Status_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Shipment_Status_Plann__c,&quot;Closed&quot;),
Shipment_Type__c = &quot;FN&quot;,
NOT(
OR(
$Profile.Id = &quot;00e4T000000zD9C&quot;,
$Profile.Id = &quot;00e4T000000lL6SQAU&quot;,
BEGINS($Profile.Id, &quot;00eRQ000002po6X&quot;),
$Profile.Id = &quot;00e4T000000lLOrQAM&quot;,
$UserRole.Id = &quot;00E4T000000gi4H&quot;,
$UserRole.Id = &quot;00E4T000000ga5l&quot;,
$User.Id = &quot;0054T000001UDyYQAW&quot;
)
),
OR(
ISCHANGED(Shipment_Status_Plann__c),
ISCHANGED(Shipment_Status_Mon__c),
ISCHANGED(Account_for__c),
ISCHANGED(Carrier__c),
ISCHANGED(Total_Services_Std_Buy_Amount_number__c),
ISCHANGED(Estatus_Cerrado__c ),
ISCHANGED(Total_Services_Sell_Amount_number__c)
)
)</errorConditionFormula>
        <errorMessage>Solo Dirección puede realizar cambios en los FN &quot;Closed&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Fecha_Retorno_Contenedor_Obligatorio</fullName>
        <active>true</active>
        <description>Hace obligatorio el campo fecha retorno de contenedor para cambiar el shipment status planner a &quot;Confirmed&quot;</description>
        <errorConditionFormula>AND(
   CONTAINS(UPPER(Name),&quot;SP-PTO&quot;),
   OR( 
      ISPICKVAL(PRIORVALUE(Shipment_Status_Plann__c), &quot;Pending&quot;), 
      ISPICKVAL(PRIORVALUE(Shipment_Status_Plann__c), &quot;In Progress&quot;)),
   ISPICKVAL(Shipment_Status_Plann__c, &quot;Confirmed&quot;),
   ISBLANK( Fecha_Retorno_Contenedor__c)
   )</errorConditionFormula>
        <errorDisplayField>Fecha_Retorno_Contenedor__c</errorDisplayField>
        <errorMessage>Para cambiar el Status a Confirmed, es necesario llenar el campo Fecha Retorno de Contenedor</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Invalid_AccountOwner</fullName>
        <active>true</active>
        <description>Verifica que el Account Owner del Account for, no pertenezca al usuario &quot;Actualización Sistemas 2021&quot;</description>
        <errorConditionFormula>ISPICKVAL(Shipment_Status_Plann__c, &quot;Confirmed&quot;) &amp;&amp;
Account_for__r.Owner.Id = &quot;0054T000000ZZQ3&quot;</errorConditionFormula>
        <errorDisplayField>Shipment_Status_Plann__c</errorDisplayField>
        <errorMessage>AO-001 ERROR: Se requiere asignar la cuenta a un usuario con perfil comercial. Esta cuenta pertenece a &quot;Actualización Sistemas 2021&quot;</errorMessage>
    </validationRules>
    <validationRules>
